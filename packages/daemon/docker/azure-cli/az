#!/bin/sh
# az on the worker image's PATH: /usr/local/bin/az is a link to /opt/azure-cli/bin/az, this file
# (packages/daemon/docker/worker.Dockerfile, the toolchain stage). It runs azure-cli from
# /opt/azure-cli/env, a virtual environment on the CPython uv installed under
# /opt/azure-cli/python, so the tree runs in any image that copies /opt/azure-cli whole, one built
# on another distribution included.
#
# It sets two defaults, each only when the variable is unset or empty, so a role's own value of
# either wins. They are set here rather than by an ENV of the image because Oh My Pi's Python tool
# starts its kernel with an allowlisted environment, which a default the image's ENV set would not
# reach (docs/kubernetes.md, "Per-deployment toolchains layer on top", says such a variable goes
# in a wrapper). REQUESTS_CA_BUNDLE holds azure-cli's HTTP client to Debian's root bundle, and
# AZURE_CORE_COLLECT_TELEMETRY=no stops its telemetry upload.
#
# azure-cli 2.93.0 has no setting that stops its version check, read in its source
# (azure/cli/core/__init__.py and azure/cli/core/util.py): AzCli.__init__ calls
# handle_version_update() on every command, which fetches the latest versions from
# https://azcliprod.blob.core.windows.net/cli when the config directory's versionCheck.json holds
# no versions — the first command in a config directory, and the first after az's own version
# changes (get_cached_latest_versions, _update_latest_from_ame_storage). `az --version` and
# `az version` fetch on every call; a help page reads the cached versions, fetches at most once a
# day and checks at most once a week. Nothing in the image works around it.
: "${REQUESTS_CA_BUNDLE:=/etc/ssl/certs/ca-certificates.crt}"
: "${AZURE_CORE_COLLECT_TELEMETRY:=no}"
export REQUESTS_CA_BUNDLE AZURE_CORE_COLLECT_TELEMETRY
exec /opt/azure-cli/env/bin/az "$@"
