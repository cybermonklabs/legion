#!/bin/sh
# legion-testpg: the pod's own PostgreSQL for tests, on loopback, from the server the worker image
# ships. `ensure` serves exactly the server LEGION_TEST_PG_DSN names, so the deployment's DSN is the
# one contract and no caller has to agree on a port. A DSN naming anything but a loopback host, or
# carrying a password, is refused rather than served: this script never serves a database that holds
# real rows. The refusal binds this script alone — it does not stop a test from opening a sessions
# DSN it was handed, which is why the runtime refuses LEGION_TEST_PG_DSN in a deployment's pod.env
# and sets it itself.
#
# The data directory is LEGION_TESTPG_DIR, /var/run/legion/roles/testpg: a volume the daemon
# mounts there, a disk emptyDir or, where the deployment sets runtime.kubernetes.test_postgres_disk,
# a generic ephemeral volume of its own, which the kubelet makes with the pod and deletes with it
# either way, so every issue pod gets an empty cluster and nothing of one issue's tests reaches
# another. Every role's own mounts cover that path inside the role's namespace, so no role can edit
# postgresql.auto.conf and have the next start load it into the launcher's namespace.
#
# The server's log is LEGION_TESTPG_LOG, server.log in that directory: the server's own output and
# what each step of this script printed. The launcher names the file and creates it before the
# first `ensure`, and every role's role-init binds that one file, read-only, at
# /var/run/legion/testpg.log, the path every role is told as LEGION_TEST_PG_LOG. So a role whose
# connect was refused or slow reads what the server did with it, where the cover over the
# directory would otherwise leave it with the client's error alone (start says what the server
# logs for a connection).
#
# The issue pod's launcher runs `ensure` at container start, as PID 1 of the roles container and
# outside every role's PID namespace, and again every 15 s; a role never starts the server, it
# finds it serving. `ensure` is idempotent, holds a lock over the work all the same, and tests the
# DSN rather than the port, so a start that died with the postmaster up and its post-start steps
# unfinished is carried the rest of the way by the tick that follows rather than reported served.
#
# Where the cluster is on a disk of its own (runtime.kubernetes.test_postgres_disk), the launcher
# reads the bytes free on that disk at each check and, under its floor of 2 GiB, runs `reset` in
# place of `ensure`, telling it the free bytes, the disk's size and the floor in
# LEGION_TESTPG_FREE_BYTES, LEGION_TESTPG_SIZE_BYTES and LEGION_TESTPG_FLOOR_BYTES. A reset takes
# the lock a start takes, reads the name, owner and size of the 20 largest databases the cluster
# held, and the count and total size of any more, where the server answers, stops the server,
# waits until no process holds the data directory, writes one line starting `legion-testpg: reset`
# to its stdout, the container's log, with the disk's use and those databases, moves the cluster
# aside to data.reset in one rename, makes and starts a new empty cluster, deletes what it moved
# aside, and appends the same line to the server's log. reset_locked says what a reset cut at any
# of those steps leaves, and start how it makes a cluster whole or not at all.
#
# initdb's superuser is the OS user (`id -un`, legion). The DSN names another role, created after
# the server is up with LOGIN CREATEDB CREATEROLE NOSUPERUSER, because a superuser can run
# `copy … to program '…'`, which runs as the server process — in the roles container's own
# namespace, where every role's tokens live. CREATEROLE is there because this repository's own
# suites create a login role and connect as it (packages/envoy/internal/cipher/store/iam_test.go,
# packages/envoy/internal/dispatch/store/census_test.go), and a test that passes in CI and fails in
# the pod is what sends an agent to the deployment's sessions database; measured on 18, a CREATEROLE
# non-superuser can neither make a superuser, nor grant itself one, nor grant pg_execute_server_program.
# The role is also granted pg_signal_backend, which a `drop database … with (force)` of its own
# throwaway database needs: the clause ends every backend still attached to that database, its
# autovacuum worker among them, and ending another role's backend needs that right. A plain
# `drop database` makes the server end that autovacuum worker itself and needs no such right, so
# the clause is there to end a connection a test left open, which is why the suites write it. The
# right reaches nothing but a backend's signal (start). It is granted pg_monitor too: diagnosing a
# refused or slow connect needs the detail of other Postgres roles' backends and of background
# processes, and settings only a superuser reads, which pg_monitor shows; it reads no file and runs
# no program (start).
set -eu

name=legion-testpg
dir=${LEGION_TESTPG_DIR:-/var/run/legion/roles/testpg}
data=$dir/data
sockets=$dir/sockets
# aside is where a reset moves the cluster it replaces, in one rename, before it makes the new one,
# and init is where start makes a new cluster, before it renames it to the data directory. The
# launcher names aside's path (testPGSetAsideName, internal/launcher/testpg.go) and deletes
# whatever it finds there before it reads the disk's free bytes, so the old cluster a reset leaves
# there, cut after its rename, failed at its new cluster's start or failed at its own delete, is
# gone at the next check. The launcher may do that without this
# script's lock because only a reset makes aside, and the launcher runs its resets one at a time,
# from its check alone, and kills each one's whole process group at its bound, so no run of this
# script still uses aside when the next check deletes it. init is touched under the lock alone:
# start deletes what an earlier start left there before its own initdb, which is only the part of
# a cluster a cut initdb made, and the launcher never touches it, because the bound of an `ensure`
# kills the script's own process and not its flock (runTestPG, ensureRun), so a start may still
# be filling init, or renaming it into place, while the next check runs.
aside=$dir/data.reset
init=$dir/data.init
# The launcher names the log (LEGION_TESTPG_LOG), so the file role-init binds into every role's
# namespace is the one this script and the server write; the default serves the image build's
# self-check, the daemon's image probe (`legion probe-image --test-postgres`,
# launcher.CheckTestPostgres, which passes no LEGION_TESTPG_LOG) and a run by hand. The script and
# the server only ever append to the log or truncate it in place (`>` on initdb keeps the inode),
# and never replace or remove a regular file there, because every role's namespace binds that
# inode: a new file under the same name would leave each running role reading the old one for the
# rest of its generation. own_log recreates the file only where it is already gone or no regular
# file, and puts its mode back before every start.
log=${LEGION_TESTPG_LOG:-$dir/server.log}
superuser=$(id -un)

# max_connections is what the server allows: testlimits.ServerConnections
# (packages/envoy/internal/dispatch/testlimits), what a Dispatch test suite needs beyond the
# superuser reserve, plus the 3 slots Postgres reserves for superusers by default, since this
# script leaves superuser_reserved_connections at its default. A shell script cannot read the Go
# constant, so it holds the sum, and packages/envoy/internal/dispatch/testlimits/testlimits_test.go
# fails when the two differ.
max_connections=983

# printf, not echo: dash's echo reads a backslash sequence in its text, and a message may name a
# process's command line, which a role's database or role name can reach.
die() {
	printf '%s: %s\n' "$name" "$*" >&2
	exit 1
}

# bindir is the newest PostgreSQL server bin directory Debian's postgresql-<major> packages install
# (PGBIN overrides it). The server programs are not on PATH: postgresql-common wraps the client
# programs alone (psql, pg_isready, createdb), so initdb, pg_ctl and postgres are named by path.
bindir() {
	if [ -n "${PGBIN:-}" ]; then
		echo "$PGBIN"
		return
	fi
	newest=
	for candidate in /usr/lib/postgresql/*/bin; do
		[ -x "$candidate/postgres" ] || continue
		version=${candidate#/usr/lib/postgresql/}
		version=${version%/bin}
		case $version in
		'' | *[!0-9]*) continue ;;
		esac
		if [ -z "$newest" ] || [ "$version" -gt "$newest" ]; then
			newest=$version
		fi
	done
	[ -n "$newest" ] || die "no PostgreSQL server under /usr/lib/postgresql/*/bin: this image ships none"
	echo "/usr/lib/postgresql/$newest/bin"
}

# parse_dsn sets user, host, port and database from a DSN, and refuses one this script must not
# serve: a password means the DSN names a server with accounts, which is somebody else's, and a
# host that is not loopback means a server outside this pod, where creating and dropping databases
# is not ours to do. The user and the database are held to plain identifiers because start() names
# both in SQL and in pg_hba.conf.
parse_dsn() {
	rest=${1#postgres://}
	if [ "$rest" = "$1" ]; then
		rest=${1#postgresql://}
		[ "$rest" != "$1" ] || die "DSN $1 is no postgres:// URL"
	fi
	rest=${rest%%\?*}
	case $rest in
	*@*) ;;
	*) die "DSN names no user before @: nothing names the role to create" ;;
	esac
	user=${rest%%@*}
	rest=${rest#*@}
	case $user in
	*:*) die "DSN carries a password, so it names a server with accounts, not this pod's own" ;;
	'') die "DSN names an empty user" ;;
	*[!A-Za-z0-9_]*) die "DSN names user $user, which is no plain identifier" ;;
	esac
	case $rest in
	*/*)
		database=${rest#*/}
		rest=${rest%%/*}
		;;
	*) die "DSN names no database" ;;
	esac
	host=${rest%%:*}
	port=${rest#*:}
	if [ "$port" = "$rest" ]; then
		port=5432
	fi
	# No bracketed [::1] arrives here: the host is everything before the first colon, so an IPv6
	# literal would already have lost its tail.
	case $host in
	127.0.0.1 | localhost) ;;
	*) die "DSN names host $host, which is no loopback address: a test database is this pod's own" ;;
	esac
	case $port in
	'' | *[!0-9]*) die "DSN names port $port, which is no number" ;;
	esac
	case $database in
	'' | *[!A-Za-z0-9_]*) die "DSN names database $database, which is no plain identifier" ;;
	esac
}

# need_dsn is the first step of ensure and of reset: it refuses an unset LEGION_TEST_PG_DSN and
# parses the DSN (parse_dsn).
need_dsn() {
	[ -n "${LEGION_TEST_PG_DSN:-}" ] ||
		die "LEGION_TEST_PG_DSN is unset: nothing names the server to serve"
	parse_dsn "$LEGION_TEST_PG_DSN"
}

# serving: the DSN works — a server answers on the port it names and the role and the database it
# names are there. This is what `ensure` reports and what start-locked tests. A port test is not
# enough: start() has the postmaster up before it makes the role, `vector` in template1 and the
# DSN's database, so any failure after that leaves a server answering the port with no usable DSN,
# and a port test would call that served for the pod's whole life. -w never prompts for a password
# (the DSN carries none and pg_hba trusts loopback, so a prompt would mean something is wrong, not
# something to wait on) and PGCONNECT_TIMEOUT bounds the connect, so a half-open port costs one
# tick and never holds the launcher.
serving() {
	PGCONNECT_TIMEOUT=5 psql -X -w -tAq "$LEGION_TEST_PG_DSN" -c 'select 1' > /dev/null 2>&1
}

# listening: a server on the port accepts connections. start() tests this rather than the DSN to
# decide whether to launch a postmaster, because `pg_ctl start` against a running server fails:
# the postmaster is started only when there is none, and the steps after it then run against the
# server that is already up.
listening() {
	pg_isready -q -h 127.0.0.1 -p "$port"
}

# answering: a server holds the port, ready (0) or starting or recovering (1); 2 is no server.
answering() {
	pg_isready -q -h 127.0.0.1 -p "$port" || [ $? -ne 2 ]
}

# holders: true when some process other than this one has $1 as its working directory, and then
# holder is that process's pid, which a refusal names. The postmaster chdirs into the data
# directory and its backends inherit that, so this is what tells a server whose backends are still
# alive from one that is really gone. A /proc entry that vanishes between the glob and the
# readlink, and one this user may not read, are both skipped: neither can be a backend of a
# cluster this user started.
holders() {
	target=$(cd "$1" 2> /dev/null && pwd -P) || return 1
	for entry in /proc/[0-9]*; do
		[ "${entry#/proc/}" != "$$" ] || continue
		cwd=$(readlink "$entry/cwd" 2> /dev/null) || continue
		if [ "$cwd" = "$target" ]; then
			holder=${entry#/proc/}
			return 0
		fi
	done
	return 1
}

# super runs psql as the initdb superuser over the local socket, the one route pg_hba.conf admits
# it on: every host line rejects the superuser, so nothing that reaches 127.0.0.1 can be it.
super() {
	psql -X -q -h "$sockets" -p "$port" -U "$superuser" "$@"
}

# own_log puts the log back as this script writes it, a regular file of this user's with mode
# 0600, and dies naming the log where it cannot. A role reaches the log through role-init's
# read-only bind alone, but under gVisor a role's own `unshare -Urm` can remount its view of that
# bind read-write, and then, since the file is the launcher's and a role's agent maps to that
# user, it can `chmod 000` it (measured in an issue pod on 2026-11-18). Every `> "$log"`,
# `>> "$log"` and `pg_ctl --log` of a later start would then fail, and `ensure` could never
# restart the server. A postmaster already running keeps writing through the descriptor it holds,
# so the next start is the one write that needs the mode, and start() calls this first. A file
# made again here leaves every running role bound to the old one for the rest of its generation;
# that is reached only when something other than this script and the server replaced the file,
# which no role can do, since the bind is a mount point: a rename, an unlink or a link over it
# answers EBUSY, measured the same day. `rm -rf --` removes a link itself, never what it names.
own_log() {
	if [ -L "$log" ] || { [ -e "$log" ] && [ ! -f "$log" ]; }; then
		rm -rf -- "$log" || die "removing $log, which is no regular file, failed"
	fi
	if [ ! -e "$log" ]; then
		(umask 077 && : > "$log") || die "creating $log failed"
	fi
	chmod 600 "$log" || die "making $log mode 600 failed"
}

start() {
	own_log
	bin=$(bindir)
	mkdir -p "$data" "$sockets"
	chmod 700 "$data"
	# start() is reached with no server, and also with one this script started and did not
	# finish: every step below the postmaster can die with the postmaster up, and the tick that
	# follows has to carry that server the rest of the way. So each step here is idempotent, and
	# the postmaster is launched only when nothing accepts connections on the port — `pg_ctl
	# start` against a running server fails, which would turn a repair into a refusal.
	if ! listening; then
		# The data directory holds a whole cluster or none. initdb writes PG_VERSION early
		# (measured on 18: 145 ms into a 3.1 s run), so an initdb cut in the data directory
		# itself would leave a PG_VERSION that no later start builds past and no server starts
		# on. So initdb runs in $init, where a cut one's part is deleted first, and its whole
		# cluster is renamed to the data directory, which holds no cluster here, once it is
		# made: a start cut before that rename leaves no PG_VERSION in the data directory, and
		# the next start makes the cluster again.
		if [ ! -f "$data/PG_VERSION" ]; then
			rm -rf -- "$init" || die "removing $init, which an earlier start left, failed"
			# --locale-provider=icu with en-US sorts text the way CI's en_US.utf8 databases
			# do: a suite whose ORDER BY output is a fixture would otherwise pass here and
			# fail there on C collation. --username keeps the OS user as the superuser; the
			# DSN's role is made below, with no superuser rights.
			"$bin/initdb" --pgdata "$init" --username "$superuser" --auth-local=trust \
				--auth-host=trust --encoding=UTF8 --locale-provider=icu --icu-locale=en-US \
				--no-sync > "$log" 2>&1 ||
				die "initdb failed; $log holds its output"
			rm -rf -- "$data" || die "removing $data, which holds no cluster, failed"
			mv -- "$init" "$data" || die "moving the new cluster in $init to $data failed"
		fi
		# initdb's own pg_hba.conf trusts every user on every address this server listens on.
		# This one keeps the superuser on the socket alone and rejects it on every host line,
		# so a connection that arrives over TCP can never be the superuser, and trusts every
		# other role on loopback, so a login role a test creates can connect as itself. It is
		# written before every launch, not at initdb alone: a start that died between initdb
		# and here would otherwise leave the next launch reading initdb's file. A server that
		# is already up read this same file, from the launch that started it.
		printf '%s\n' \
			"local all  $superuser  trust" \
			"host  all  $superuser  all  reject" \
			"host  all  all  127.0.0.1/32 trust" \
			"host  all  all  0.0.0.0/0 reject" > "$data/pg_hba.conf" ||
			die "writing $data/pg_hba.conf failed"
		# This process holds the lock and no server answers, so a postmaster.pid or socket
		# lock left here names a server that died with its PID namespace; postgres would test
		# that PID in this namespace, where it may be a live process. A postmaster that is
		# gone can still have live backends, which hold the data directory as their working
		# directory and would write it beside a new server, so the files are cleared only
		# when no process is in there.
		if [ -f "$data/postmaster.pid" ] || [ -e "$sockets/.s.PGSQL.$port.lock" ]; then
			if ! answering; then
				! holders "$data" ||
					die "a process still runs in $data, so the server that left $data/postmaster.pid is not gone: refusing to clear it"
				rm -f "$data/postmaster.pid" "$sockets/.s.PGSQL.$port.lock"
			fi
		fi
		# A throwaway cluster trades durability for speed: nothing in it survives the pod.
		# max_connections is sized above, and 256MB of shared buffers covers a suite's
		# fixtures. huge_pages and dynamic_shared_memory_type are the pod's: gVisor serves no
		# huge pages, and each role mounts its own 64 MiB /dev/shm, too small for the posix
		# segments the default picks. jit off keeps LLVM out of a test's plan times. The WAL
		# settings bound the cluster's share of whatever ephemeral-storage limit the pod runs
		# under, which the kubelet evicts every role of the pod over: the daemon's own default
		# is 80Gi on a 6Gi request (`defaultResources`), and a deployment that sets
		# `runtime.kubernetes.resources.issue` names its own — one Autopilot deployment gives
		# its issue pods 10Gi. Each setting is below its default: wal_level=minimal
		# writes no WAL at all for a table built, copied into or rewritten in the transaction
		# that made it, which is most of what a suite's fixture does (and it needs
		# max_wal_senders=0, since no walsender can serve that level, and no replication slot
		# can exist to pin segments); max_wal_size=512MB halves the checkpoint distance, and
		# with it the recycled segments a long run settles at; min_wal_size=64MB lets the floor
		# fall to four segments between runs; and wal_keep_size=0 retains nothing for a replica
		# this cluster will never have. Measured on 18: a database grown to 985 MB, updated
		# across a third of its rows, VACUUM FULLed and dropped left the data directory at
		# 1.1 GB with the defaults and at 425 MB with these.
		# log_connections=all and log_disconnections are what let a role tell a connect the
		# server failed from one that never reached it. On 18 `all` logs, for each connection,
		# `connection received: host=… port=…`, which the backend the postmaster forks for the
		# connect writes as it starts (BackendInitialize), not the postmaster at accept, then
		# the authentication and authorization lines, then `connection ready: setup total=…,
		# fork=…, authentication=…`; log_disconnections adds the session's end. A connect whose
		# fork failed has no backend to write that line: the postmaster logs `could not fork
		# new process for connection: …` instead. So a connect the server forked for and then
		# failed leaves lines, a connect whose fork failed leaves that one line, and a connect
		# with neither never reached the postmaster: a burst past the listen queue, which is
		# 2 x max_connections = 1966, capped by gVisor's somaxconn at 1024, is dropped by the
		# network stack with no server line. Measured 2026-11-17: some such connects ended in
		# EOF, which libpq reports as `server closed the connection unexpectedly`, and the rest
		# hung until the client's timeout. The cost, measured the same day, is about 350 bytes
		# of log per connection over 4241 connections.
		# shellcheck disable=SC2094 # pg_ctl writes $log through --log and this append; it reads none
		"$bin/pg_ctl" --pgdata "$data" --log "$log" --wait --timeout 120 \
			--options "-p $port -k $sockets -c listen_addresses=127.0.0.1 -c fsync=off -c full_page_writes=off -c synchronous_commit=off -c max_connections=$max_connections -c shared_buffers=256MB -c huge_pages=off -c dynamic_shared_memory_type=mmap -c jit=off -c wal_level=minimal -c max_wal_senders=0 -c max_wal_size=512MB -c min_wal_size=64MB -c wal_keep_size=0 -c log_connections=all -c log_disconnections=on" \
			start >> "$log" 2>&1 ||
			die "pg_ctl start failed; $log holds its output"
	fi
	# vector in template1 reaches every database a test makes from it, so a suite that needs
	# pgvector (Dispatch's) runs on this server with no extension step of its own, and a
	# `create extension if not exists vector` of its own is a no-op the DSN's role may run.
	super -d template1 -c 'create extension if not exists vector' >> "$log" 2>&1 ||
		die "create extension vector in template1 failed; $log holds its output"
	# The DSN's role: it may log in, make databases and make roles, and it is no superuser, so
	# nothing that holds the DSN can `copy … to program` as the server's own process. CREATEROLE
	# is what lets a suite that creates its own login role run here as it does in CI; on 18 it
	# cannot hand out SUPERUSER or a role it does not hold itself, such as
	# pg_execute_server_program.
	super -tA -d postgres -c "select 1 from pg_roles where rolname = '$user'" 2>> "$log" |
		grep -q 1 ||
		super -d postgres -c "create role $user login createdb createrole nosuperuser" >> "$log" 2>&1 ||
		die "create role $user failed; $log holds its output"
	# pg_signal_backend lets the DSN's role end another role's backend, which is what
	# `drop database … with (force)` does to whatever is still attached — autovacuum among them.
	# A plain `drop database` makes the server end that autovacuum worker itself and asks the role
	# for no such right, so the clause is there to end a connection a test left open, which is why
	# the suites write it. Without the grant a suite that drops its own throwaway database that
	# way fails in the pod alone, with `permission denied to terminate process` (SQLSTATE 42501),
	# and passes in CI, whose login is a superuser. It signals a backend and nothing else: it
	# cannot read a file, run a command or reach a database the role is not already in. The grant
	# runs on every start and repeating it changes nothing; a server already serving is never
	# started again (ensure), so it keeps what it has, and a pod's own cluster takes the grant
	# because its disk, made with the pod, starts empty.
	super -d postgres -c "grant pg_signal_backend to $user" >> "$log" 2>&1 ||
		die "grant pg_signal_backend to $user failed; $log holds its output"
	# pg_monitor is pg_read_all_settings, pg_read_all_stats and pg_stat_scan_tables. Every role
	# of the pod already sees its own login's backends in full, since all of them connect as the
	# DSN's login; pg_stat_activity hides the state and the query of every other backend. What
	# the grant adds is that detail for backends of other Postgres roles (the cluster superuser's
	# connections from ensure's steps, login roles a test suite creates and connects as) and of
	# background processes such as autovacuum, and the settings only a superuser reads, which is
	# what diagnosing a refused or slow connect needs. It is no superuser, reads no file (it does
	# not include pg_read_server_files) and runs no program. Like the grant above it runs on
	# every start, and a server already serving keeps what it has.
	super -d postgres -c "grant pg_monitor to $user" >> "$log" 2>&1 ||
		die "grant pg_monitor to $user failed; $log holds its output"
	if [ "$database" != postgres ]; then
		super -tA -d postgres -c "select 1 from pg_database where datname = '$database'" 2>> "$log" |
			grep -q 1 ||
			super -d postgres -c "create database $database owner $user" >> "$log" 2>&1 ||
			die "create database $database failed; $log holds its output"
	fi
}

# locked runs this script's command $1 under $dir/.lock, the one lock every start and every reset
# take, so neither ever runs beside the other. -o closes the lock's descriptor in the child, so the
# server flock's child starts does not inherit it and hold the lock for the pod's whole life:
# without -o, measured, a second ensure blocked until its own timeout. -w bounds the wait at one
# cold start, so a holder that dies mid-start costs one wait and never a launch; -E makes that
# timeout 75, a status no command of start-locked or reset-locked returns, so the wait is reported
# rather than silent.
locked() {
	mkdir -p "$dir"
	flock -E 75 -w 180 -o "$dir/.lock" "$0" "$1" || {
		s=$?
		[ "$s" -ne 75 ] || die "waited 180 s for $dir/.lock"
		exit "$s"
	}
}

ensure() {
	need_dsn
	serving && {
		echo "$name: a server already serves 127.0.0.1:$port"
		return 0
	}
	# flock serialises the callers that start together; the second finds the first's server
	# serving.
	locked start-locked
	# A start that no later start repairs — a role the cluster holds as NOLOGIN, a password set on
	# it, an hba file an earlier version wrote — would be reported as served on every tick for the
	# pod's life, and nothing in the log would say the DSN does not work. So the DSN is tried
	# again here. A start that worked can still fail this probe: PGCONNECT_TIMEOUT bounds the
	# connect alone, not psql's whole run, so a loaded box answers late (measured: 48 ms median,
	# 23.5 s worst of 40 samples), and a suite holding every connection the server allows leaves
	# none for the probe. Hence the second try, and a message that names those two before the
	# cluster's own faults.
	serving || sleep 2
	serving ||
		die "the server started but $LEGION_TEST_PG_DSN did not answer twice running; it may be slow under load or out of connections (max_connections=$max_connections), or the cluster's role or hba file may be wrong: $log holds the server's output"
	echo "$name: serving $LEGION_TEST_PG_DSN from $data"
}

# human is a byte count in GiB to a tenth, or in MiB below one GiB, for the reset's line; a count
# the launcher did not give reads as unknown. The shell's arithmetic is 64 bits wide, which holds
# ten times any disk's bytes.
human() {
	case ${1:-} in
	'' | *[!0-9]*)
		echo "an unknown amount"
		return
		;;
	esac
	unit=1073741824
	suffix=GiB
	if [ "$1" -lt "$unit" ]; then
		unit=1048576
		suffix=MiB
	fi
	echo "$(($1 / unit)).$(($1 % unit * 10 / unit)) $suffix"
}

# reset replaces the cluster with a new empty one (reset_locked) under the lock every start takes,
# so it never runs beside a start: a reset that waits for the lock resets the cluster that start
# made, and an ensure that waits for a reset finds the new cluster serving.
reset() {
	need_dsn
	locked reset-locked
}

# reset_locked is a reset, under the lock. Its steps run in this order so that a reset cut at any
# of them leaves what the next check repairs, never a cluster half deleted beside a server: up to
# the rename the old cluster is whole where it was, and the next check serves it or resets it
# again; from the rename on, $aside holds the old cluster whole, which the next check deletes
# before it reads the disk's free bytes, and the data directory holds either no cluster, which
# the next check's ensure makes as it makes a pod's first, or the new one whole, whose start that
# ensure finishes: start makes the new cluster in $init and renames it into place once its initdb
# is done, so an initdb cut midway leaves its part in $init, which the next start deletes before
# its own initdb.
reset_locked() {
	bin=$(bindir)
	# What the old cluster held, for the line below, so a role whose database went with the reset
	# reads why, and which harness filled the disk. The superuser reads it over the socket, which a
	# login out of connections leaves open to it (superuser_reserved_connections). A server that
	# does not answer is read as holding nothing, and the line says so: waiting for it would let a
	# disk already full crash the server on every WAL write it cannot make. Every control character
	# of a name or an owner is read as ?: a role names its own databases and roles, and a newline in
	# one would split the line in two, the second of which could be a forged `legion-testpg: reset`.
	# The list names the $most largest databases, largest first and by name between two of one
	# size, since the line is there to name what filled the disk, and where there are more it ends
	# `, and <n> more, <size>`, n the count it does not name and size their total, so the line
	# stays one line: the launcher writes a line longer than maxLogLine (64 KiB,
	# internal/launcher/launcher.go) as several, each after the first behind its prefix again and
	# starting at a byte a database's name can put there. The bound holds by construction: a name
	# and an owner are each at most 63 bytes (NAMEDATALEN 64), each ? is no longer than the
	# control character it replaces, and pg_size_pretty writes a few bytes, so the 20 entries are
	# about 3 KB, and with the data directory's path and the fixed words the line is far below
	# 64 KiB. It lists every database but template0 and template1, which it leaves out by name, so
	# a database a role marked as a template is still counted. To find the largest it reads the
	# size of every database, once each, in its innermost subquery, and the row number that picks
	# the $most, the order the list writes them in, the sizes it prints and the total of the rest
	# all take that one reading. pg_database_size answers NULL for a database whose directory is
	# already gone, as a drop under way leaves it, and nulls last sorts such a database after
	# every size. The list runs under a statement_timeout of $list_timeout, so a list that takes
	# longer, as one of a cluster holding thousands of databases may, ends as a list that failed
	# and the reset goes on. LEGION_TESTPG_LIST_TIMEOUT sets it for the tests alone
	# (internal/launcher/testpg_disk_test.go), which cut a list short.
	most=20
	list_timeout=${LEGION_TESTPG_LIST_TIMEOUT:-60s}
	if ! listening; then
		held="the server did not answer, so it read no databases"
	elif listed=$(PGCONNECT_TIMEOUT=5 PGOPTIONS="-c statement_timeout=$list_timeout" super -tA -d postgres -c "select string_agg(format('%s (owner %s, %s)', regexp_replace(datname, '[[:cntrl:]]', '?', 'g'), regexp_replace(pg_get_userbyid(datdba), '[[:cntrl:]]', '?', 'g'), pg_size_pretty(size)), ', ' order by size desc nulls last, datname) filter (where rn <= $most) || case when count(*) > $most then format(', and %s more, %s', count(*) - $most, pg_size_pretty(sum(size) filter (where rn > $most))) else '' end from (select datname, datdba, size, row_number() over (order by size desc nulls last, datname) as rn from (select datname, datdba, pg_database_size(oid) as size from pg_database where datname not in ('template0', 'template1')) as sized) as databases"); then
		held="it held $listed"
	else
		held="the server answered but the list of its databases failed, so it read none"
	fi
	# A fast stop ends every session and waits for the shutdown checkpoint; an immediate one, where
	# the fast one fails, ends the server without it, which a cluster about to be deleted does not
	# need. pg_ctl signals the pid postmaster.pid names without asking what that process is, and the
	# file of a postmaster that died, killed or with an earlier container, may name any process of
	# this one now, a role's among them; so the stop runs only where that pid is a process in the
	# data directory, which is the postmaster, and a stale file goes with the cluster at the rename.
	# pg_ctl's output goes to the container's log where it fails and nowhere where it works, so the
	# reset's one line is the whole of what a reset that worked logs.
	here=$(cd "$data" 2> /dev/null && pwd -P) || here=
	postmaster=$(head -n 1 "$data/postmaster.pid" 2> /dev/null) || postmaster=
	case $postmaster in
	'' | *[!0-9]*) ;;
	*)
		if [ -n "$here" ] && [ "$(readlink "/proc/$postmaster/cwd" 2> /dev/null)" = "$here" ]; then
			"$bin/pg_ctl" --pgdata "$data" --mode fast --wait --timeout 60 stop > /dev/null ||
				"$bin/pg_ctl" --pgdata "$data" --mode immediate --wait --timeout 60 stop > /dev/null ||
				echo "$name: reset: neither a fast nor an immediate stop ended the server $data/postmaster.pid names; waiting for its processes all the same" >&2
		fi
		;;
	esac
	# A postmaster's exit is not its backends': one that outlives it still has the data directory as
	# its working directory and may write it, so nothing is moved while any process is in there.
	# The wait is bounded, and a holder still there at the bound is named and the cluster is left
	# where it is: the next check under the floor tries again, and a reset never moves or deletes
	# what a process still holds. A backend's command line is its process title, which holds the
	# user and database names as the client sent them, so every byte of it that is not printable,
	# a newline among them, is written ? and the line cannot be split.
	deadline=$(($(date +%s) + 60))
	while holders "$data"; do
		[ "$(date +%s)" -lt "$deadline" ] ||
			die "reset: process $holder ($(tr '\0' ' ' 2> /dev/null < "/proc/$holder/cmdline" | tr -c '[:print:]' '?')) still runs in $data 60 s after the server stopped, so the cluster is left where it is and nothing is renamed"
		sleep 1
	done
	# The line goes to the container's log here, once the databases are read and the server is
	# stopped and before anything is moved, so a reset whose new cluster then fails to start, as
	# its initdb does on a disk that went from 2 GiB free to nearly full within one check, still
	# tells the roles what the old cluster held. It names the reset and not its outcome: a step
	# that fails after it says so in a line of its own. printf, not echo: a database's name may
	# hold a backslash.
	line="$name: reset of the cluster in $data: $(human "${LEGION_TESTPG_FREE_BYTES:-}") free of $(human "${LEGION_TESTPG_SIZE_BYTES:-}") on its disk, under the floor of $(human "${LEGION_TESTPG_FLOOR_BYTES:-}"); $held"
	printf '%s\n' "$line"
	# The one rename: from here on the old cluster is out of the server's path, whole.
	rm -rf -- "$aside" || die "reset: removing $aside, which an earlier reset left, failed"
	if [ -e "$data" ]; then
		mv -- "$data" "$aside" || die "reset: moving $data aside to $aside failed"
	fi
	# start runs initdb, since no PG_VERSION is there, renames its cluster into place, writes the
	# hba file, starts the server and makes the DSN's role, vector in template1 and the DSN's
	# database, as at a pod's first start.
	start
	rm -rf -- "$aside" ||
		echo "$name: reset: deleting $aside, the cluster it replaced, failed; the launcher's next check deletes it" >&2
	# initdb truncated the server's log, so the same line is appended after it, where a role reading
	# the log finds why its databases are gone.
	printf '%s\n' "$line" >> "$log" || die "appending the reset's line to $log failed"
}

case ${1:-} in
ensure)
	ensure
	;;
start-locked)
	# flock's child: the environment names the DSN, and another caller may have finished the
	# server while this one waited for the lock.
	parse_dsn "${LEGION_TEST_PG_DSN:?}"
	serving || start
	;;
reset)
	reset
	;;
reset-locked)
	# flock's child, as start-locked is: the environment names the DSN, whose port and role the
	# new cluster serves.
	parse_dsn "${LEGION_TEST_PG_DSN:?}"
	reset_locked
	;;
stop)
	# A fast shutdown this waits for: the postmaster's exit leaves its shutdown checkpoint still
	# running, and a caller that deletes the data directory next races it. The data directory is
	# all pg_ctl needs, so `stop` reads LEGION_TESTPG_DIR alone, not the DSN.
	bin=$(bindir)
	"$bin/pg_ctl" --pgdata "$data" --mode fast --wait --timeout 60 stop
	;;
check)
	# The image probe's toolchain check runs this: a worker image whose server package went missing
	# fails the build instead of every role's start.
	bin=$(bindir)
	"$bin/postgres" --version
	"$bin/initdb" --version
	# The extension is the selected server's, so its share directory is read from that server's own
	# pg_config: the pg_config first on PATH is postgresql-common's, which answers for the newest
	# client installed, and a client of another major would name a share directory this server
	# never reads.
	control=$("$bin/pg_config" --sharedir)/extension/vector.control
	[ -f "$control" ] || die "no pgvector: $control is missing"
	echo "pgvector $(sed -n "s/^default_version = '\(.*\)'/\1/p" "$control")"
	;;
*)
	die "usage: $name ensure|reset|check|stop"
	;;
esac
