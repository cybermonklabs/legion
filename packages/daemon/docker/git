#!/bin/sh
# The git first on a pod's PATH, /opt/legion/bin/git (worker.Dockerfile). It changes two commands,
# a commit and a push, and runs every other one unchanged: the real git, /usr/bin/git, gets "$@"
# as it came.
#
# A commit goes to `legion git --real /usr/bin/git` (packages/daemon/cmd/legion/git.go), which
# adds the commit's Omp-Session and Legion-Role trailers and then runs the real git. It adds each
# line only when its value is valid and git alone would accept the message, and none when the
# caller asks git for an isolated configuration, GIT_CONFIG_NOSYSTEM true or
# GIT_CONFIG_GLOBAL=/dev/null, as hermetic tests do. The two lines name the session and the role
# that made the commit.
#
# A push runs with `-c core.hooksPath=/opt/legion/githooks` immediately before the subcommand and
# with every spelling git reads as `--no-verify` taken out after it. So git itself computes the
# update lines and hands them to the root-owned pre-push hook in that directory before a byte
# reaches the remote, and the hook runs Legion's leak guard over every push but one that can only
# write to a path on this machine (below); a role can neither write that hook, nor name a hooks
# path that outranks this one, nor skip it with a shorter spelling of `--no-verify`.
#
# The `-c` goes after the caller's own global options and before the subcommand, rather than
# ahead of every argument, because git takes the last `-c` of a name: a caller's own
# `-c core.hooksPath=<anything>` is read first and this one wins over it (measured on the
# image's git 2.47.3: `git -c core.hooksPath=/opt/legion/githooks -c core.hooksPath=/dev/null
# config --get core.hooksPath` prints /dev/null, and the two swapped print
# /opt/legion/githooks). It outranks the runtime's own core.hooksPath=/dev/null for the same
# reason, which every pod's git carries in GIT_CONFIG_KEY_n (mainEnvironment,
# packages/daemon/internal/runtime/sandbox/manifest.go): measured on the same git, a
# `-c core.hooksPath=<dir>` beside that pin reads back as <dir>. The pin still holds for every
# other command, a commit included: `legion git` names no hooks path.
#
# What this does not stop is a role that runs /usr/bin/git itself, PATH unread. Nothing here
# tries to: the spec's Design says of every layer of this guard that none of them stops somebody
# who means to publish a name, and that this change does not try to (dispatch://INFRA-1527).
#
# `jj git push` shells out to the `git` PATH names (`git -c core.fsmonitor=false … --git-dir <dir>
# push --porcelain --no-verify …`, measured with jj 0.46.0-sami), so this one wrapper catches a
# role's own push and jj's, and jj's `--no-verify` is what the removal is for.
#
# The words taken out are exactly `--no-veri`, `--no-verif` and `--no-verify`, wherever they
# stand after the subcommand. git takes any prefix of a long option that names that option alone,
# and these three are the spellings `git push` reads as `--no-verify` (measured on git 2.47.3: each
# skipped the hook). Every other spelling is left to git, so its status and text stay git's own:
# `--n` to `--no-ver` are refused as ambiguous with `--no-verbose` (status 129, no hook run,
# nothing written), `--no-verify=<x>` is refused, and `--no-no-verify` and `--verif` run the hook.
# The wrapper reads no option's value apart from its option, so a value that is one of the three
# words is taken out too, which can only leave a push git refuses or one whose hook runs. `-n` is
# `--dry-run` for a push, not `--no-verify` (`git push -h` on git 2.47.3: `-n, --[no-]dry-run  dry
# run` beside `--no-verify  bypass pre-push hook`), and taking it out would turn a caller's dry run
# into a real push.
#
# The hook clears a push that can only write to a path on this machine: `legion leak-check
# pre-push` (runLeakCheckPrePush, packages/daemon/cmd/legion/leak_check.go) asks Guard.StaysLocal
# (packages/daemon/internal/leakguard/local.go) before the guard runs, and a push it clears exits 0
# with no check found or run and nothing printed, since it copies bytes already on this machine's
# disk and a later push of them to a host through this wrapper meets the hook again (a hook of the
# destination's own that pushes onward runs the real git, with no wrapper). StaysLocal reads the
# URL git hands the hook, the repository's remotes, its configuration and git's exec path, but not
# the command line, and `--receive-pack=<program>` and `--exec=<program>` make git run that program
# in place of git-receive-pack, which can write somewhere other than that URL, a host included.
# Only this wrapper sees the command line, so for a push with any word after the subcommand that
# is `--<P>` or `--<P>=<value>`, <P> a non-empty prefix of `receive-pack` or of `exec`, it exports
# LEGION_PUSH_NAMES_RECEIVE_PACK=1 (leakguard.PushNamesReceivePackVar). git hands its environment
# to the hook, and StaysLocal clears no push that carries the variable, whatever its value. Every
# prefix is marked rather than the ones one release of git accepts: git 2.47.3 reads `--e` to
# `--exec` and `--rece` to `--receive-pack` as one of the two and refuses `--r` to `--rec` as
# ambiguous, so marking those changes nothing git does. The negations `--no-receive-pack` and
# `--no-e` name no program and get no mark. The wrapper never unsets the variable, so a caller who
# sets it by hand gets what a push that names its own receive-pack gets: the hook clears no such
# push, and the guard bounds its commits as the base does, by the remote-tracking refs, with no
# read of what the push's URL holds (Guard.pushRecords).
#
# A push is a command whose subcommand word is `push` or `send-pack`, and both get the rebuild
# below. Only `git push` runs the pre-push hook: `git send-pack` runs no pre-push hook at all
# (measured on git 2.47.3: through this wrapper, `GIT_TRACE=1 git send-pack <bare repository>
# main` wrote the branch and ran no hook), so the hooks path it gets is read by nothing and no leak
# check runs for it. Its routing stays as it was: refusing or checking a send-pack would be a new
# control on what a role runs, which STRATEGY.md ("Boundaries") leaves to the owner. A git alias
# that expands to a push (`git p` with alias.p=push) is no push here: git expands it after this
# wrapper has read the word, so it runs under the runtime's core.hooksPath=/dev/null with no
# pre-push hook and no leak check, as it always has. A commit is a command whose subcommand word is
# `commit`, and an alias that expands to one (`git ci` with alias.ci=commit) gets no trailers for
# the same reason.
set -u

real=/usr/bin/git
hooks=/opt/legion/githooks
legion=/opt/legion/bin/legion

# One pass finds the subcommand: the first word that is no global option. The global options
# whose value is the next argument are git's own (`git --help`, and handle_options in git.c for
# `--attr-source` and `--shallow-file`, which the usage line leaves out): a wrapper that read one
# of those values as the subcommand would miss a push or a commit — jj's own `--git-dir <dir>
# push` is exactly that shape — or change a command that is neither. Measured on git 2.47.3,
# `git --shallow-file X version` runs `version`, so `--shallow-file` is one of them. The
# `--opt=value` spellings need nothing: they are one word, and this skips over them as it does
# over any other option. ahead counts the words in front of the subcommand.
#
# Some words end git's own options before any subcommand (handle_options in git.c): `--help`,
# `-h`, `--version` and `-v` make git run its help or version command with what follows as that
# command's arguments, and `--exec-path` with no `=`, `--html-path`, `--man-path` and `--info-path`
# make git print a path and stop. So `git --help push` is no push and `git --help commit` no
# commit, and the pass stops there with neither: the real git gets "$@" as it came.
push=0
commit=0
value=0
ahead=0
for arg; do
  if [ "$value" -eq 1 ]; then
    value=0
  else
    case "$arg" in
      -C | -c | --git-dir | --work-tree | --namespace | --config-env | --attr-source | --shallow-file) value=1 ;;
      --help | -h | --version | -v | --html-path | --man-path | --info-path) break ;;
      --exec-path=*) ;;
      --exec-path*) break ;;
      -*) ;;
      push | send-pack) push=1; break ;;
      commit) commit=1; break ;;
      *) break ;;
    esac
  fi
  ahead=$((ahead + 1))
done

# Only a push has its list rebuilt here. A commit goes to `legion git` with "$@" as it came, and
# legion git, in Go, puts the trailer arguments in. Every other command goes to the real git with
# "$@" as it came. A POSIX shell edits its own positional parameters by taking each from the front
# and putting the kept ones back at the end with `set -- "$@" "$arg"`, and dash copies the whole
# list each time, so a rebuild costs time that grows with the square of the argument count: one
# push's leak check spent 62 s of its 78 s in this wrapper, rebuilding a `git rev-list` of about
# 4,970 `^<sha>` arguments (dispatch://INFRA-3456).
if [ "$commit" -eq 1 ]; then
  exec "$legion" git --real "$real" -- "$@"
fi
if [ "$push" -eq 0 ]; then
  exec "$real" "$@"
fi

# A push's rebuild, in order: the ahead words in front of the subcommand as they came, then
# `-c core.hooksPath=<dir>`, which is after everything the caller wrote in front of the
# subcommand, then the subcommand and what follows it with `--no-veri`, `--no-verif` and
# `--no-verify` left out. receivepack becomes 1 when a word after the subcommand is `--<P>` or
# `--<P>=<value>`, <P> a non-empty prefix of `receive-pack` or of `exec`, and the word itself
# stays. Only what follows the subcommand is read for either, so a `--no-verify` that is some
# global option's value stays that value. Each word is read by `case` patterns and the
# `${arg%%=*}` expansion alone, which the shell does itself, so the pass starts no process for a
# word and costs what the rebuild alone costs.
receivepack=0
left=$#
while [ "$left" -gt 0 ]; do
  arg=$1
  shift
  left=$((left - 1))
  if [ "$ahead" -gt 0 ]; then
    ahead=$((ahead - 1))
  elif [ "$ahead" -eq 0 ]; then
    ahead=-1
    set -- "$@" -c "core.hooksPath=$hooks"
  else
    case "$arg" in
      --no-veri | --no-verif | --no-verify) continue ;;
    esac
    case "${arg%%=*}" in
      --r | --re | --rec | --rece | --recei | --receiv | --receive | --receive- | --receive-p | \
        --receive-pa | --receive-pac | --receive-pack | --e | --ex | --exe | --exec) receivepack=1 ;;
    esac
  fi
  set -- "$@" "$arg"
done

if [ "$receivepack" -eq 1 ]; then
  export LEGION_PUSH_NAMES_RECEIVE_PACK=1
fi
exec "$real" "$@"
