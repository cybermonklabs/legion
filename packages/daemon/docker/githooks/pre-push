#!/bin/sh
# The pre-push hook of a pod's push: /opt/legion/githooks/pre-push, root's, in a root-owned
# directory no role can write, which the git wrapper (packages/daemon/docker/git) points git at
# with `-c core.hooksPath=/opt/legion/githooks` for a push and for nothing else.
#
# git runs it with the remote's name and URL as its arguments and the update lines it computed on
# standard input, and both go straight to `legion leak-check pre-push`: this holds no rule and no
# logic of its own. That command clears with no check a push that can only write to a path on this
# machine (Guard.StaysLocal, packages/daemon/internal/leakguard/local.go), since such a push copies
# bytes already on this machine's disk and a later push of them to a host through the git wrapper
# meets this hook again. It runs the leak guard (packages/daemon/internal/leakguard) over every
# other push. The command's statuses are the shared public leak check's — 0 clean, 3 refused, 2
# the check could not be made to run or GitHub answers 404 for the destination — and 128 plus the
# signal for a SIGINT, SIGTERM or SIGHUP that stopped it, and git stops the push on any of them
# but the first.
exec '/opt/legion/bin/legion' leak-check pre-push "$@"
