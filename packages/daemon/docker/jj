#!/bin/sh
# The jj first on a pod's PATH, /opt/legion/bin/jj (worker.Dockerfile). Every command runs the
# real jj, /usr/local/bin/jj, with the arguments it was given; what this wrapper adds is one
# check, and only before a `jj git push`.
#
# jj makes a push by shelling out to the `git` its PATH names (`git -c core.fsmonitor=false …
# --git-dir <dir> push --porcelain --no-verify …`, measured with jj 0.45.1-sami), so Legion's git
# wrapper is what puts the leak guard's pre-push hook in front of jj's push as well as a role's
# own. This checks that the git jj would run is that wrapper: the `git` on PATH, and jj's own
# `git.executable-path`, which jj runs in place of a bare `git` when a configuration file sets it.
# A jj that would run any other git is refused here, in the shared check's own setup-error words
# and with its status, rather than pushing text nobody checked.
#
# The check is the whole of this wrapper. It reads no ref, no commit and no other text: jj hands
# git exact refspecs, and the git wrapper does the whole job from there.
#
# A push is a command whose subcommand pair is `git push`. A jj alias or a `ui.default-command`
# that expands to one is neither: jj expands it after this wrapper has read the words, so the push
# runs whatever git jj's configuration names, unchecked. Measured with jj 0.45.1-sami and
# 0.46.0-sami: an alias, and a default command, set in a repository's own configuration beside a
# `git.executable-path` naming another git, each pushed through that git. jj loads no alias from
# `-R` or from a `--config` or `--config-file` argument, so only a configuration file can do it,
# as a git alias can past the git wrapper, whose own head says the same.
set -u

real=/usr/local/bin/jj
wrapper=/opt/legion/bin/git

# jj's subcommand pair, past jj's global options, which clap takes before the subcommand, between
# its two words and after them. The options whose value is the next argument are `jj --help`'s
# Global Options, the same in jj 0.45.1-sami and 0.46.0-sami; the attached spellings
# (`-R<path>`, `-R=<path>`, `--repository=<path>`) are one word and need no skip.
takes=
first=
second=
for arg; do
  if [ -n "$takes" ]; then
    takes=
    continue
  fi
  case "$arg" in
    -R | --repository | --at-operation | --at-op | --color | --config | --config-file) takes=1 ;;
    -*) ;;
    *)
      if [ -z "$first" ]; then
        first=$arg
      else
        second=$arg
        break
      fi
      ;;
  esac
done

if [ "$first" != git ] || [ "$second" != push ]; then
  exec "$real" "$@"
fi

found=$(command -v git) || found=
if [ "$found" != "$wrapper" ]; then
  echo "LEAK CHECK SETUP ERROR: the push: the git on PATH is ${found:-no git at all}, not Legion's git wrapper $wrapper, so jj's push would reach the remote with no leak check" >&2
  exit 2
fi

# The configuration read, which must answer for the push this command would make. It runs with
# every repository and configuration option the caller wrote, wherever in the list the caller
# wrote it, each word as it came and in the order it came, so jj resolves them as the push will.
# Measured with jj 0.45.1-sami and 0.46.0-sami: clap takes `-R` and `--repository` after the
# subcommand as well as before it, the last of them names the repository (`jj -R <a> git push -R
# <b>` pushes from <b>), `-R=<path>` names <path>, and of `--config` and `--config-file` the one
# written last wins. A read that took the repository only from in front of `git push`, and kept a
# `-R=<path>` as the path `=<path>`, answered for a repository the push did not use, and let the
# push through to whatever git the push's repository named. `--at-operation` loads the repository
# at an operation but reads the same configuration, and no other global option names a
# configuration, so the read leaves them out. A `--` ends the options, and the read takes nothing
# after it: `jj git push` takes no positional argument, so jj refuses whatever follows one.
#
# --ignore-working-copy because this is a read: it must not snapshot the working copy of the
# repository the push is about. The options are selected by rebuilding the positional parameters
# inside the command substitution, whose subshell has a copy of its own, so the arguments the exec
# at the end hands jj are the caller's untouched.
#
# jj answers `git` when nothing sets the value, its own default: `jj config get
# git.executable-path` prints `git` and exits 0 with no configuration at all. So a read that fails
# is an error, a `-R` naming no repository for one, and never an unset value. It is refused, after
# jj's own error, because a read that answered nothing cannot vouch for the git the push would run.
if ! configured=$(
  keep=
  left=$#
  while [ "$left" -gt 0 ]; do
    arg=$1
    shift
    left=$((left - 1))
    if [ -n "$keep" ]; then
      keep=
      set -- "$@" "$arg"
      continue
    fi
    case "$arg" in
      --)
        shift "$left"
        break
        ;;
      -R | --repository | --config | --config-file)
        keep=1
        set -- "$@" "$arg"
        ;;
      -R?* | --repository=* | --config=* | --config-file=*)
        set -- "$@" "$arg"
        ;;
    esac
  done
  exec "$real" --ignore-working-copy "$@" config get git.executable-path
); then
  echo "LEAK CHECK SETUP ERROR: the push: jj could not read the git.executable-path this push would use, so it cannot be shown to be git or Legion's git wrapper $wrapper, and jj's push could reach the remote with no leak check" >&2
  exit 2
fi
case "$configured" in
  git | "$wrapper") ;;
  *)
    echo "LEAK CHECK SETUP ERROR: the push: jj's git.executable-path is ${configured:-empty}, not git or Legion's git wrapper $wrapper, so jj's push would reach the remote with no leak check" >&2
    exit 2
    ;;
esac

exec "$real" "$@"
