#!/bin/sh
# The jj first on a pod's PATH, /opt/legion/bin/jj (worker.Dockerfile). Every command runs the
# real jj, /usr/local/bin/jj, with the arguments it was given; what this wrapper adds is one
# check, and only before a command jj runs as a `jj git push`.
#
# jj makes a push by shelling out to the `git` its PATH names (`git -c core.fsmonitor=false …
# --git-dir <dir> push --porcelain --no-verify …`, measured with jj 0.45.1-sami), so Legion's git
# wrapper is what puts the leak guard's pre-push hook in front of jj's push as well as a role's
# own. This checks that the git jj would run is that wrapper: the `git` on PATH, and jj's own
# `git.executable-path`, which jj runs in place of a bare `git` when a configuration file sets it.
# A jj that would run any other git is refused here, in the shared check's own setup-error words
# and with its status, rather than pushing text nobody checked.
#
# The check is the whole of this wrapper. It reads no ref, no commit and no other text: jj hands
# git exact refspecs, and the git wrapper does the whole job from there.
#
# A command is a push when jj runs it as `git push`, which is more than the words `git push`: jj
# puts an alias's words in place of the command word, expands an alias those words name in turn,
# and puts `ui.default-command` in front of a command line that names no command. Measured with
# jj 0.45.1-sami and 0.46.0-sami: an alias, an alias of an alias and a default command, each set in
# a repository's own configuration beside a `git.executable-path` naming another git, each pushed
# through that git while the wrapper read only the words it was given. So the wrapper expands the
# command line as jj does before it decides, and refuses what it cannot read.
set -u

real=/usr/local/bin/jj
wrapper=/opt/legion/bin/git

# The commands jj has built in, the same 47 in jj 0.45.1-sami and 0.46.0-sami (`jj help`). jj
# ignores an alias that has the name of one ("Cannot define an alias that overrides the built-in
# command"), so a command line whose command word is one of these, other than `git push`, runs at
# once, with no read. clap's own names for commands (`op`, `evolution-log`) are left out: for them
# the wrapper reads the alias table, finds no alias, and runs them, which costs one read.
builtins=' abandon absorb arrange bisect bookmark commit config converge describe diff diffedit duplicate edit evolog file fix gerrit git help interdiff log metaedit new next operation parallelize prev rebase redo resolve restore revert root run show sign simplify-parents sparse split squash status tag undo unsign util version workspace '

# command_word "$@" sets word to jj's command word, the first argument that is no global option and
# no option's value, at to its position, and next to the argument after it that is likewise
# neither: the `push` of `git push`. clap takes the global options before the command word, between
# its two words and after them. The options whose value is the next argument are `jj --help`'s
# Global Options, the same in both versions; the attached spellings (`-R<path>`, `-R=<path>`,
# `--repository=<path>`) are one word and need no skip.
command_word() {
  word='' at=0 next='' takes='' i=0
  for arg; do
    i=$((i + 1))
    if [ -n "$takes" ]; then
      takes=
      continue
    fi
    case "$arg" in
      -R | --repository | --at-operation | --at-op | --color | --config | --config-file) takes=1 ;;
      -*) ;;
      *)
        if [ -z "$word" ]; then
          word=$arg
          at=$i
        else
          next=$arg
          break
        fi
        ;;
    esac
  done
}

command_word "$@"
case "$word" in
  git) [ "$next" = push ] || exec "$real" "$@" ;;
  "") ;;
  *) case "$builtins" in *" $word "*) exec "$real" "$@" ;; esac ;;
esac

# The reads of jj's alias table and default command. jj loads both from the configuration it reads
# before the command line's own options: its defaults, the user's files and the configuration of the
# repository the working directory is in, and neither from the repository `-R` names nor from a
# `--config` or `--config-file` argument. Measured in both versions: jj says "Command aliases cannot
# be loaded from -R/--repository path or --config/--config-file arguments", and runs no default
# command set only in the repository `-R` names or only by `--config`. So these reads run in the
# working directory with none of the caller's options. A value prints as its key, its length and
# then one word a line: a word that holds a line break shows as more lines than the length, and a
# value that is no list of strings (an alias written as a string, which jj does not run) as
# `<Error…>`, and the wrapper refuses both. An alias written as a table prints its `definition`;
# its `enabled`, which jj 0.46 reads and 0.45 does not, is left out, so a disabled alias is checked
# as if jj ran it.
list='if(name.ends_with(".enabled"), "", name ++ "\n" ++ value.as_string_list().len() ++ "\n" ++ value.as_string_list().join("\n") ++ "\n")'
nl='
'

# The decision, in a subshell whose own copy of the arguments is expanded as jj expands them. It
# prints `run`, and the caller's command goes to jj untouched; or `refuse`, after its reason on
# stderr in the shared check's setup-error words.
verdict=$(
  refuse() {
    echo "LEAK CHECK SETUP ERROR: the push: $1" >&2
    echo refuse
    exit 0
  }
  seen=' '
  via=
  defaulted=
  depth=0
  while :; do
    command_word "$@"
    if [ -z "$word" ]; then
      # No command word: jj runs ui.default-command, in front of the command line, or `log` when
      # nothing sets it. One put in already does not come again.
      if [ -n "$defaulted" ]; then
        echo run
        exit 0
      fi
      defaulted=1
      key=ui.default-command
      at=0
    elif [ "$word" = git ]; then
      [ "$next" = push ] && break
      echo run
      exit 0
    else
      case "$builtins" in
        *" $word "*)
          echo run
          exit 0
          ;;
      esac
      # A name jj has already expanded on this line: jj refuses the line as a recursive alias.
      case "$seen" in
        *" $word "*)
          echo run
          exit 0
          ;;
      esac
      depth=$((depth + 1))
      [ "$depth" -le 32 ] || refuse "jj expands this command through more than 32 aliases, more than this wrapper reads"
      case "$word" in
        *[!A-Za-z0-9_-]*) refuse "jj's command word '$word' is no built-in command, and it holds characters this wrapper does not read as an alias name, so it cannot tell whether jj runs it as a push" ;;
      esac
      seen="$seen$word "
      key="aliases.$word"
    fi
    got=$("$real" --ignore-working-copy config list "$key" -T "$list" 2>/dev/null) ||
      refuse "jj could not read $key (\`jj config list $key\` says why), so this wrapper cannot tell whether this command is a push"
    if [ -z "$got" ]; then
      # Not set: jj runs `log` for no command word, and refuses a command word that is no alias.
      echo run
      exit 0
    fi
    case "$got" in
      *"$nl"*) ;;
      *) refuse "this wrapper cannot read $key" ;;
    esac
    name=${got%%"$nl"*}
    rest=${got#*"$nl"}
    case "$rest" in
      *"$nl"*)
        count=${rest%%"$nl"*}
        words=${rest#*"$nl"}
        ;;
      *)
        count=$rest
        words=
        ;;
    esac
    case "$name" in
      "$key" | "$key.definition") ;;
      *) refuse "this wrapper cannot read $key" ;;
    esac
    case "$count" in
      "" | *[!0-9]*)
        # ui.default-command may be one string, which jj runs as one command word.
        [ "$key" = ui.default-command ] ||
          refuse "$key is no list of strings, so this wrapper cannot read it"
        words=$("$real" --ignore-working-copy config get ui.default-command 2>/dev/null) ||
          refuse "jj could not read ui.default-command, so this wrapper cannot tell whether this command is a push"
        case "$words" in
          *"$nl"*) refuse "ui.default-command holds a line break, which this wrapper does not read" ;;
        esac
        count=1
        ;;
    esac
    lines=0
    if [ "$count" -gt 0 ]; then
      while IFS= read -r w; do
        lines=$((lines + 1))
      done <<EOF
$words
EOF
    elif [ -n "$words" ]; then
      lines=-1
    fi
    [ "$lines" -eq "$count" ] || refuse "a word of $key holds a line break, which this wrapper does not read"
    via="$via, $key"
    # The command line as jj expands it: the words in place of the command word at position at, or
    # in front of the whole line where at is 0.
    total=$#
    if [ "$at" -eq 0 ] && [ "$count" -gt 0 ]; then
      while IFS= read -r w; do
        set -- "$@" "$w"
      done <<EOF
$words
EOF
    fi
    i=0
    while [ "$i" -lt "$total" ]; do
      arg=$1
      shift
      i=$((i + 1))
      if [ "$i" -ne "$at" ]; then
        set -- "$@" "$arg"
      elif [ "$count" -gt 0 ]; then
        while IFS= read -r w; do
          set -- "$@" "$w"
        done <<EOF
$words
EOF
      fi
    done
  done

  # A push. via names what jj expanded to reach it, if anything.
  how="jj's push"
  [ -z "$via" ] || how="jj's push (jj runs this command as \`jj git push\` through ${via#, })"

  found=$(command -v git) || found=
  [ "$found" = "$wrapper" ] ||
    refuse "the git on PATH is ${found:-no git at all}, not Legion's git wrapper $wrapper, so $how would reach the remote with no leak check"

  # The configuration read, which must answer for the push this command would make. It runs with
  # every repository and configuration option of the expanded command line, wherever in the line
  # it is written, each word as it came and in the order it came, so jj resolves them as the push
  # will. Measured with jj 0.45.1-sami and 0.46.0-sami: clap takes `-R` and `--repository` after the
  # command as well as before it, the last of them names the repository (`jj -R <a> git push -R
  # <b>` pushes from <b>), `-R=<path>` names <path>, of `--config` and `--config-file` the one
  # written last wins, and those an alias or the default command carries count as the caller's own.
  # A read that took the repository only from in front of `git push`, and kept a `-R=<path>` as the
  # path `=<path>`, answered for a repository the push did not use, and let the push through to
  # whatever git the push's repository named. `--at-operation` loads the repository at an operation
  # but reads the same configuration, and no other global option names a configuration, so the
  # read leaves them out. A `--` ends the options, and the read takes nothing after it: `jj git
  # push` takes no positional argument, so jj refuses whatever follows one.
  #
  # --ignore-working-copy because this is a read: it must not snapshot the working copy of the
  # repository the push is about.
  #
  # jj answers `git` when nothing sets the value, its own default: `jj config get
  # git.executable-path` prints `git` and exits 0 with no configuration at all. So a read that fails
  # is an error, a `-R` naming no repository for one, and never an unset value. It is refused, after
  # jj's own error, because a read that answered nothing cannot vouch for the git the push would run.
  configured=$(
    keep=
    left=$#
    while [ "$left" -gt 0 ]; do
      arg=$1
      shift
      left=$((left - 1))
      if [ -n "$keep" ]; then
        keep=
        set -- "$@" "$arg"
        continue
      fi
      case "$arg" in
        --)
          shift "$left"
          break
          ;;
        -R | --repository | --config | --config-file)
          keep=1
          set -- "$@" "$arg"
          ;;
        -R?* | --repository=* | --config=* | --config-file=*)
          set -- "$@" "$arg"
          ;;
      esac
    done
    exec "$real" --ignore-working-copy "$@" config get git.executable-path
  ) || refuse "jj could not read the git.executable-path this push would use, so it cannot be shown to be git or Legion's git wrapper $wrapper, and $how could reach the remote with no leak check"
  case "$configured" in
    git | "$wrapper") ;;
    *) refuse "jj's git.executable-path is ${configured:-empty}, not git or Legion's git wrapper $wrapper, so $how would reach the remote with no leak check" ;;
  esac
  echo run
)

case "$verdict" in
  run) exec "$real" "$@" ;;
  refuse) exit 2 ;;
esac
echo "LEAK CHECK SETUP ERROR: the push: this wrapper could not decide whether jj runs this command as a push" >&2
exit 2
