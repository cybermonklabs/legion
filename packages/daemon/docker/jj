#!/bin/sh
# The jj first on a pod's PATH, /opt/legion/bin/jj (worker.Dockerfile). Every command runs the
# real jj, /usr/local/bin/jj, with the arguments it was given; what this wrapper adds is one
# check, and only before a `jj git push` or a `jj gerrit upload`, which pushes through the same
# git subprocess (`git::push_updates`, cli/src/commands/gerrit/upload.rs).
#
# jj makes a push by shelling out to the `git` its PATH names (`git -c core.fsmonitor=false …
# --git-dir <dir> push --porcelain --no-verify …`, measured with jj 0.46.0-sami), so Legion's git
# wrapper is what puts the leak guard's pre-push hook in front of jj's push as well as a role's
# own. This checks that the git jj would run is that wrapper: the `git` on PATH, and jj's own
# `git.executable-path`, which jj runs in place of a bare `git` when a configuration file sets it.
# A jj that would run any other git is refused here, in the shared check's own setup-error words
# and with its status, rather than pushing text nobody checked.
#
# The check is the whole of this wrapper. It reads no ref, no commit and no other text: jj hands
# git exact refspecs, and the git wrapper does the whole job from there.
set -u

real=/usr/local/bin/jj
wrapper=/opt/legion/bin/git

# jj's subcommand pair, past jj's global options, which clap takes before a subcommand as well as
# after one. The options whose value is the next argument are `jj --help`'s Global Options (read
# from jj 0.46.0-sami, which refuses a `--config-toml`); the attached spellings (`-R<path>`,
# `--repository=<path>`) are one word and need no skip. The repository is kept because the
# configuration read below must be the one this command would make: a repository's own
# configuration file can name a `git.executable-path` of its own, and so can the caller's own
# `--config`, which that read takes as well. Any other pair runs the real jj as soon as its second
# word is read. A push's scan goes on past the pair, since a `-R` written after the subcommand
# names the repository as one written before it does, and the last `-R` written is the one jj
# opens. It stops at the first `--` past the pair, after which jj refuses a `-R` as an unexpected
# argument, so a `-R` is read only before that `--`. A `-R` clustered after another short option
# needs no reading: the only short options of the two commands that take no value are `-h` and the
# upload's `-n`, neither of which pushes.
repository=
takes=
first=
second=
for arg; do
  if [ -n "$takes" ]; then
    if [ "$takes" = repository ]; then
      repository=$arg
    fi
    takes=
    continue
  fi
  case "$arg" in
    -R | --repository) takes=repository ;;
    --at-operation | --at-op | --color | --config | --config-file) takes=other ;;
    -R?*) repository=${arg#-R} ;;
    --repository=*) repository=${arg#--repository=} ;;
    --) [ -z "$second" ] || break ;;
    -*) ;;
    *)
      if [ -z "$first" ]; then
        first=$arg
      elif [ -z "$second" ]; then
        second=$arg
        case "$first $second" in
          "git push" | "gerrit upload") ;;
          *) exec "$real" "$@" ;;
        esac
      fi
      ;;
  esac
done

# A command of fewer than two positional words is no push either, as written on the command line.
# jj's own configuration can still make a push of a command this wrapper passes through: an alias
# that runs one (`aliases.up = ["git", "push"]`), or a `ui.default-command = ["git", "push"]`,
# which a bare `jj` runs. This wrapper reads neither, so such a push gets no read and no forced
# git.executable-path, and one whose configuration also names a git without the git wrapper
# reaches the remote with no leak check. Both stay open by the architect's decision
# (dispatch://INFRA-4036/artifact/decisions-md, "The jj wrapper does not read jj aliases or
# `ui.default-command`"): each takes a setting written on purpose in a repository's or the user's
# configuration file, since jj loads neither from `--config`, `--config-file` or the repository a
# `-R` names (measured with jj 0.45.1 and 0.46.0-sami on 2026-11-21).
case "$first $second" in
  "git push" | "gerrit upload") ;;
  *) exec "$real" "$@" ;;
esac

found=$(command -v git) || found=
if [ "$found" != "$wrapper" ]; then
  echo "LEAK CHECK SETUP ERROR: the push: the git on PATH is ${found:-no git at all}, not Legion's git wrapper $wrapper, so jj's push would reach the remote with no leak check" >&2
  exit 2
fi

# --ignore-working-copy because this is a read: a configuration read must not snapshot the
# working copy of the repository the push is about. The caller's own `--config` and
# `--config-file` go to the read too, before the subcommand or after it, in that order and in both
# spellings of each, because the value the read must answer is the one the push would use: a `jj
# git push --config git.executable-path=<another git>` names its git on the command line, which
# outranks every configuration file, and a read without those arguments would answer for a push
# nobody is making and pass this one through to an unwrapped git. Only the ones before the first
# `--` go to it: one after that `--` stays after it on the push, where jj refuses it as an
# unexpected argument, so it is no configuration the push would use. They are selected by
# rebuilding the positional parameters inside the command substitution, whose subshell has a copy
# of its own, so the caller's arguments are still whole for the block at the end, which hands the
# push these same configuration arguments, in this same order, after its other arguments.
#
# jj prints `git` and exits 0 when nothing sets the value, which is the usual case and means the
# bare `git` above, so a read that fails answers for no git at all and is refused rather than
# taken for that one. What jj printed on its standard error follows the refusal, since that is
# the cause: no repository where the `-R` points, a `--config` with no `=`. The read's standard
# output is the value, so its standard error goes apart, captured in cause while descriptor 3
# carries the standard output to the substitution; a read that succeeds prints nothing.
configured=$(
  keep=
  left=$#
  while [ "$left" -gt 0 ]; do
    arg=$1
    shift
    left=$((left - 1))
    if [ -n "$keep" ]; then
      keep=
      set -- "$@" "$arg"
      continue
    fi
    case "$arg" in
      --)
        shift "$left"
        left=0
        ;;
      --config | --config-file)
        keep=1
        set -- "$@" "$arg"
        ;;
      --config=* | --config-file=*)
        set -- "$@" "$arg"
        ;;
    esac
  done
  if [ -n "$repository" ]; then
    set -- -R "$repository" "$@"
  fi
  { cause=$("$real" --ignore-working-copy "$@" config get git.executable-path 2>&1 >&3 3>&-) && exit; } 3>&1
  echo "LEAK CHECK SETUP ERROR: the push: jj could not read its git.executable-path, so the git jj's push would run is unknown and could be one with no leak check" >&2
  if [ -n "$cause" ]; then
    printf '%s\n' "$cause" >&2
  fi
  exit 2
) || exit 2
case "$configured" in
  git | "$wrapper") ;;
  *)
    echo "LEAK CHECK SETUP ERROR: the push: jj's git.executable-path is ${configured:-empty}, not git or Legion's git wrapper $wrapper, so jj's push would reach the remote with no leak check" >&2
    exit 2
    ;;
esac

# The read above cannot see a value that only the push itself would use: a `[[--scope]]` whose
# `--when.commands` names `git push` or `gerrit upload` sets git.executable-path for that command
# alone, in a configuration file or in the caller's own `--config '"--scope"=[…]'`, so the `jj
# config get` above answers `git` while the push runs the scope's git. So the push runs with
# git.executable-path set to this wrapper's git on its own command line, which outranks every
# configuration file, as a TOML string, quoted, so jj reads it as the path whatever its spelling.
# Where it goes rests on two rules of jj's, each measured with jj 0.45.1 and 0.46.0-sami on
# 2026-11-21:
#
# - A: a `--config` written after the subcommand makes jj drop every `--config` written before
#   the subcommand, and a `--config-file` after it every `--config-file` before it; each is
#   dropped only by a later one of its own option. A forced value appended after a `jj --config
#   <value> git push` would take <value> off the push but not off the read, which passes every
#   one of them to `jj config get`: with `git.push="<remote>"` the push would go to origin, and
#   with `git.private-commits="all()"` a push jj refuses would go ahead.
# - B: consecutive `--config` arguments form one layer, in which a `--scope` value wins over a
#   plain value whatever their order, and a `--config-file` between two of them ends the layer.
#   A forced value appended after a caller's `--config '"--scope"=[…]'` would land in its layer
#   and lose to the scope.
#
# So the push's arguments are the caller's with every `--config` and `--config-file` taken out,
# in both spellings and each with its value; then those, in the order written; then
# `--config-file /dev/null`, an empty file, which sets nothing and ends the caller's last layer;
# then the forced value, in a layer of its own after every one of the caller's. All of it goes
# before the first `--`, after which jj refuses a `--config` as an unexpected argument, and what
# follows that `--` stays after it as written. With every configuration argument after the
# subcommand, jj has none before it to drop, and it reads them in the order the read above passed
# them to `jj config get`, so the push uses the configuration that read checked, with
# git.executable-path forced over it. A caller's own unscoped value was read and refused above,
# with its name in the error.
#
# POSIX sh has one list, the positional parameters, so they are doubled: the first pass takes the
# first copy off the front and appends each argument before the first `--` that is no
# configuration argument, and the second takes the second copy off and appends the configuration
# arguments, then the two forced ones, then the `--` and everything after it.
forced="git.executable-path=\"$wrapper\""
count=$#
set -- "$@" "$@"
left=$count
takes=
while [ "$left" -gt 0 ]; do
  arg=$1
  shift
  left=$((left - 1))
  if [ -n "$takes" ]; then
    takes=
    continue
  fi
  case "$arg" in
    --)
      shift "$left"
      left=0
      ;;
    --config | --config-file) takes=1 ;;
    --config=* | --config-file=*) ;;
    *) set -- "$@" "$arg" ;;
  esac
done
left=$count
takes=
ended=
while [ "$left" -gt 0 ]; do
  arg=$1
  shift
  left=$((left - 1))
  if [ -n "$takes$ended" ]; then
    takes=
    set -- "$@" "$arg"
    continue
  fi
  case "$arg" in
    --)
      ended=1
      set -- "$@" --config-file /dev/null --config "$forced" --
      ;;
    --config | --config-file)
      takes=1
      set -- "$@" "$arg"
      ;;
    --config=* | --config-file=*) set -- "$@" "$arg" ;;
  esac
done
if [ -z "$ended" ]; then
  set -- "$@" --config-file /dev/null --config "$forced"
fi
exec "$real" "$@"
