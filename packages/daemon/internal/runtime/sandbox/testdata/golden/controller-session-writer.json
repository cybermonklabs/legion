{
  "apiVersion": "agents.x-k8s.io/v1beta1",
  "kind": "Sandbox",
  "metadata": {
    "labels": {
      "legion.dev/project": "legion",
      "legion.dev/role": "controller"
    },
    "name": "legion-legion-controller",
    "namespace": "legion"
  },
  "spec": {
    "operatingMode": "Running",
    "podTemplate": {
      "metadata": {
        "annotations": {
          "cluster-autoscaler.kubernetes.io/safe-to-evict": "false",
          "karpenter.sh/do-not-disrupt": "true",
          "legion.dev/pod-shape": "{\"image\":\"ghcr.io/cybermonklabs/legion-worker@sha256:1d10089a0000000000000000000000000000000000000000000000000000beef\",\"resources\":{\"limits\":{\"cpu\":\"1\",\"ephemeral-storage\":\"10Gi\",\"memory\":\"4Gi\"},\"requests\":{\"cpu\":\"1\",\"ephemeral-storage\":\"1Gi\",\"memory\":\"4Gi\"}},\"disk\":\"20Gi\",\"writer_audience\":\"//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/legion-writers/providers/legion-cluster\"}"
        },
        "labels": {
          "legion.dev/project": "legion",
          "legion.dev/role": "controller"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "/opt/legion/bin/legion",
              "launcher",
              "--connect",
              "tcp://192.0.2.250:13371",
              "--sandbox",
              "legion-legion-controller",
              "--roles-dir",
              "/var/run/legion/roles",
              "--role",
              "controller",
              "--stop-grace",
              "30s",
              "--session-instance",
              "example-project:us-central1:example-instance",
              "--session-database",
              "legion_sessions",
              "--session-user",
              "legion-sessions@example-project.iam",
              "--session-impersonate-service-account",
              "legion-sessions@example-project.iam.gserviceaccount.com",
              "--session-writer-audience",
              "//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/legion-writers/providers/legion-cluster"
            ],
            "env": [
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              }
            ],
            "image": "ghcr.io/cybermonklabs/legion-worker@sha256:1d10089a0000000000000000000000000000000000000000000000000000beef",
            "name": "controller",
            "resources": {
              "limits": {
                "cpu": "1",
                "ephemeral-storage": "10Gi",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "1",
                "ephemeral-storage": "1Gi",
                "memory": "4Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/legion",
                "name": "issue"
              },
              {
                "mountPath": "/var/run/legion/home/.config",
                "name": "config"
              },
              {
                "mountPath": "/var/run/legion/roles/controller/launcher",
                "name": "launcher-controller",
                "readOnly": true
              },
              {
                "mountPath": "/var/run/legion/roles/controller/gh",
                "name": "gh-controller",
                "readOnly": true
              },
              {
                "mountPath": "/var/run/legion/roles/controller/private",
                "name": "private-controller"
              },
              {
                "mountPath": "/var/run/legion/roles/controller/state",
                "name": "state-controller"
              },
              {
                "mountPath": "/var/run/legion/roles/.homes",
                "name": "role-homes"
              },
              {
                "mountPath": "/var/run/legion/roles/session-writer",
                "name": "session-writer-token",
                "readOnly": true
              }
            ],
            "workingDir": "/legion"
          }
        ],
        "enableServiceLinks": false,
        "nodeSelector": {
          "legion.dev/pool": "legion"
        },
        "priorityClassName": "legion",
        "restartPolicy": "Always",
        "runtimeClassName": "gvisor",
        "securityContext": {
          "fsGroup": 1000,
          "fsGroupChangePolicy": "OnRootMismatch",
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000
        },
        "terminationGracePeriodSeconds": 30,
        "tolerations": [
          {
            "effect": "NoSchedule",
            "key": "legion.dev/pool",
            "operator": "Equal",
            "value": "legion"
          }
        ],
        "volumes": [
          {
            "name": "issue",
            "persistentVolumeClaim": {
              "claimName": "issue-legion-legion-controller"
            }
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "config"
          },
          {
            "name": "launcher-controller",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": "LAUNCHER_TOKEN",
                  "path": "LAUNCHER_TOKEN"
                }
              ],
              "secretName": "legion-legion-controller-controller-boot"
            }
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "private-controller"
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "state-controller"
          },
          {
            "name": "gh-controller",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": "github-hosts-acme",
                  "path": "acme/hosts.yml"
                },
                {
                  "key": "github-config-acme",
                  "path": "acme/config.yml"
                },
                {
                  "key": "github-hosts-sjawhar",
                  "path": "sjawhar/hosts.yml"
                },
                {
                  "key": "github-config-sjawhar",
                  "path": "sjawhar/config.yml"
                },
                {
                  "key": "github-renames",
                  "path": "renames.txt"
                }
              ],
              "secretName": "legion-legion-controller-controller-boot"
            }
          },
          {
            "emptyDir": {},
            "name": "role-homes"
          },
          {
            "name": "session-writer-token",
            "projected": {
              "defaultMode": 288,
              "sources": [
                {
                  "serviceAccountToken": {
                    "audience": "//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/legion-writers/providers/legion-cluster",
                    "expirationSeconds": 3600,
                    "path": "token"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "volumeClaimTemplates": [
      {
        "metadata": {
          "labels": {
            "legion.dev/project": "legion",
            "legion.dev/role": "controller"
          },
          "name": "issue"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "20Gi"
            }
          },
          "storageClassName": "gp2"
        }
      }
    ]
  }
}
