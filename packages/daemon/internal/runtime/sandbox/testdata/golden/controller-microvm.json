{
  "apiVersion": "agents.x-k8s.io/v1beta1",
  "kind": "Sandbox",
  "metadata": {
    "labels": {
      "legion.dev/project": "legion",
      "legion.dev/role": "controller"
    },
    "name": "legion-legion-controller",
    "namespace": "legion"
  },
  "spec": {
    "operatingMode": "Running",
    "podTemplate": {
      "metadata": {
        "annotations": {
          "cluster-autoscaler.kubernetes.io/safe-to-evict": "false",
          "karpenter.sh/do-not-disrupt": "true",
          "legion.dev/leak-checker-manifest-sha256": "5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e",
          "legion.dev/pod-shape": "{\"image\":\"ghcr.io/cybermonklabs/legion-worker@sha256:1d10089a0000000000000000000000000000000000000000000000000000beef\",\"resources\":{\"limits\":{\"cpu\":\"1\",\"ephemeral-storage\":\"10Gi\",\"memory\":\"4Gi\"},\"requests\":{\"cpu\":\"1\",\"ephemeral-storage\":\"1Gi\",\"memory\":\"4Gi\"}},\"disk\":\"20Gi\",\"sandbox\":{\"runtime_class\":\"microvm\",\"compute_class\":\"example-microvm\",\"metadata\":{\"workload_pool\":\"example-project.svc.id.goog\",\"identity_provider\":\"https://container.googleapis.com/v1/projects/example-project/locations/us-central1/clusters/example-cluster\"}}}"
        },
        "labels": {
          "legion.dev/project": "legion",
          "legion.dev/role": "controller",
          "legion.dev/sandbox": "microvm"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "/opt/legion/bin/legion",
              "launcher",
              "--connect",
              "tcp://192.0.2.250:13371",
              "--token-file",
              "/var/run/legion/launcher/LAUNCHER_TOKEN",
              "--sandbox",
              "legion-legion-controller",
              "--role",
              "controller",
              "--private-dir",
              "/var/run/legion/private",
              "--microvm",
              "--metadata-workload-pool",
              "example-project.svc.id.goog",
              "--metadata-identity-provider",
              "https://container.googleapis.com/v1/projects/example-project/locations/us-central1/clusters/example-cluster",
              "--stop-grace",
              "30s"
            ],
            "env": [
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              }
            ],
            "image": "ghcr.io/cybermonklabs/legion-worker@sha256:1d10089a0000000000000000000000000000000000000000000000000000beef",
            "name": "controller",
            "resources": {
              "limits": {
                "cpu": "1",
                "ephemeral-storage": "10Gi",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "1",
                "ephemeral-storage": "1Gi",
                "memory": "4Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/legion",
                "name": "issue"
              },
              {
                "mountPath": "/var/run/legion/launcher",
                "name": "launcher-controller",
                "readOnly": true
              },
              {
                "mountPath": "/var/run/legion/private",
                "name": "private-controller"
              },
              {
                "mountPath": "/var/run/legion/state",
                "name": "state-controller"
              },
              {
                "mountPath": "/home/legion/.config",
                "name": "config"
              },
              {
                "mountPath": "/var/run/legion/gh",
                "name": "gh-controller",
                "readOnly": true
              },
              {
                "mountPath": "/var/run/legion/workload-identity",
                "name": "workload-identity-token",
                "readOnly": true
              },
              {
                "mountPath": "/var/run/legion/providers",
                "name": "providers",
                "readOnly": true
              }
            ],
            "workingDir": "/legion"
          }
        ],
        "enableServiceLinks": false,
        "nodeSelector": {
          "cloud.google.com/compute-class": "example-microvm",
          "legion.dev/pool": "legion"
        },
        "priorityClassName": "legion",
        "restartPolicy": "Always",
        "runtimeClassName": "microvm",
        "securityContext": {
          "fsGroup": 1000,
          "fsGroupChangePolicy": "OnRootMismatch",
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000
        },
        "terminationGracePeriodSeconds": 30,
        "tolerations": [
          {
            "effect": "NoSchedule",
            "key": "legion.dev/pool",
            "operator": "Equal",
            "value": "legion"
          },
          {
            "effect": "NoSchedule",
            "key": "cloud.google.com/compute-class",
            "operator": "Equal",
            "value": "example-microvm"
          }
        ],
        "volumes": [
          {
            "name": "issue",
            "persistentVolumeClaim": {
              "claimName": "issue-legion-legion-controller"
            }
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "config"
          },
          {
            "name": "launcher-controller",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": "LAUNCHER_TOKEN",
                  "path": "LAUNCHER_TOKEN"
                }
              ],
              "secretName": "legion-legion-controller-controller-boot"
            }
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "private-controller"
          },
          {
            "emptyDir": {
              "medium": "Memory"
            },
            "name": "state-controller"
          },
          {
            "name": "gh-controller",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": "github-hosts-acme",
                  "path": "acme/hosts.yml"
                },
                {
                  "key": "github-config-acme",
                  "path": "acme/config.yml"
                },
                {
                  "key": "github-hosts-sjawhar",
                  "path": "sjawhar/hosts.yml"
                },
                {
                  "key": "github-config-sjawhar",
                  "path": "sjawhar/config.yml"
                },
                {
                  "key": "github-renames",
                  "path": "renames.txt"
                }
              ],
              "secretName": "legion-legion-controller-controller-boot"
            }
          },
          {
            "name": "workload-identity-token",
            "projected": {
              "defaultMode": 288,
              "sources": [
                {
                  "serviceAccountToken": {
                    "audience": "example-project.svc.id.goog",
                    "expirationSeconds": 3600,
                    "path": "token"
                  }
                }
              ]
            }
          },
          {
            "name": "providers",
            "secret": {
              "defaultMode": 288,
              "items": [
                {
                  "key": "SESSION_DSN",
                  "path": "OMP_SESSION_SQL_DSN"
                }
              ],
              "secretName": "legion-legion-providers"
            }
          }
        ]
      }
    },
    "volumeClaimTemplates": [
      {
        "metadata": {
          "labels": {
            "legion.dev/project": "legion",
            "legion.dev/role": "controller"
          },
          "name": "issue"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "20Gi"
            }
          },
          "storageClassName": "gp2"
        }
      }
    ]
  }
}
