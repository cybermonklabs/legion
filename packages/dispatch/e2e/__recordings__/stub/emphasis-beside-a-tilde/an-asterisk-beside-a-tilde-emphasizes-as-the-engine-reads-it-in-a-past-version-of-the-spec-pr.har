          "content": {
            "size": 1005,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"markdown\":\"An asterisk beside a tilde opens or closes emphasis as the browser's engine says, a tilde being punctuation: the first paragraph emphasizes its tilde, and the two after it pair nothing.\\n\\nPlain \\u0026#98;*~* text.\\n\\nPlain ~\\\\*\\\\*b\\u003c* end.\\n\\nPlain \\\\*b\\\\*\\\\*~~ end.\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An asterisk beside a tilde opens or closes emphasis as the browser's engine says, a tilde being punctuation: the first paragraph emphasizes its tilde, and the two after it pair nothing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain b\"},{\"type\":\"text\",\"text\":\"~\",\"marks\":[{\"type\":\"emphasis\",\"attrs\":{\"marker\":\"*\"}}]},{\"type\":\"text\",\"text\":\" text.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain ~**b\\u003c* end.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain *b**~~ end.\"}]}]},\"token\":\"sha256:dba298e321ffe00d37f6f339950dd9390a520b220e0224f0c93747a60c9a4555\",\"version\":1}\n"
