            "text": "{\"asks\":[{\"block_id\":\"replay-window\",\"state\":\"answered\",\"answered_by\":\"alice\",\"answered_at\":\"2026-11-26T00:31:07.249176Z\",\"selected\":[\"The last hour\"]}],\"markdown\":\"# Replay window\\n\\nThe mirror replays the ledger on a cold start.\\n\\n:::ask{#replay-window urgency=\\\"med\\\" multiple=\\\"false\\\"}\\nWhich window does the mirror replay?\\n\\n- The last hour\\n- The last day\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Replay window\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The mirror replays the ledger on a cold start.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"replay-window\",\"multiple\":false,\"urgency\":\"med\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which window does the mirror replay?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last hour\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last day\"}]}]}]}]}]},\"token\":\"sha256:0454703ddf84bcf81df4175a5089181cabeba52c47de0a4d4305f6d3f39e760c\",\"version\":2}\n"
