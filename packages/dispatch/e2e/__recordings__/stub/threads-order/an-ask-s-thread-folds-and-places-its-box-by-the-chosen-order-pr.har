            "size": 1170,
            "mimeType": "application/json",
            "compression": 663,
            "text": "{\"markdown\":\"# Replay window\\n\\nThe mirror replays the ledger on a cold start.\\n\\n:::ask{#replay-window urgency=\\\"med\\\" multiple=\\\"false\\\" state=\\\"answered\\\" answered_by=\\\"alice\\\" answered_at=\\\"2026-11-13T00:20:43.005022Z\\\" selected=\\\"[\\u0026#x22;The last hour\\u0026#x22;]\\\"}\\nWhich window does the mirror replay?\\n\\n- The last hour\\n- The last day\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Replay window\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The mirror replays the ledger on a cold start.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"replay-window\",\"multiple\":false,\"state\":\"open\",\"urgency\":\"med\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which window does the mirror replay?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last hour\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last day\"}]}]}]}]}]},\"token\":\"sha256:0454703ddf84bcf81df4175a5089181cabeba52c47de0a4d4305f6d3f39e760c\",\"version\":2}\n"
