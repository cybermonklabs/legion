            "text": "{\n  \"version\": 3,\n  \"types\": [\n    {\n      \"name\": \"callout\",\n      \"content\": \"block+\",\n      \"render\": \"host\",\n      \"attributes\": {\n        \"kind\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"note\", \"warning\"],\n          \"default\": \"note\"\n        },\n        \"title\": {\n          \"kind\": \"string\",\n          \"default\": \"\"\n        }\n      }\n    },\n    {\n      \"name\": \"ask\",\n      \"content\": \"paragraph+ bullet_list?\",\n      \"render\": \"host\",\n      \"attributes\": {\n        \"urgency\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"low\", \"med\", \"high\", \"blocking\"],\n          \"default\": \"med\"\n        },\n        \"multiple\": {\n          \"kind\": \"bool\",\n          \"default\": false\n        },\n        \"state\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"open\", \"answered\", \"resolved\"],\n          \"default\": \"open\",\n          \"server\": true\n        },\n        \"answered_by\": {\n          \"kind\": \"actor\",\n          \"server\": true\n        },\n        \"answered_at\": {\n          \"kind\": \"timestamp\",\n          \"server\": true\n        },\n        \"selected\": {\n          \"kind\": \"string[]\",\n          \"server\": true\n        },\n        \"answer\": {\n          \"kind\": \"string\",\n          \"server\": true\n        },\n        \"invalid\": {\n          \"kind\": \"string\",\n          \"server\": true\n        },\n        \"copied_from\": {\n          \"kind\": \"string\",\n          \"server\": true\n        },\n        \"copied_from_document\": {\n          \"kind\": \"string\",\n          \"server\": true\n        }\n      }\n    },\n    {\n      \"name\": \"requirement\",\n      \"content\": \"paragraph+\",\n      \"render\": \"host\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"plan_task\",\n      \"content\": \"paragraph+\",\n      \"render\": \"host\",\n      \"attributes\": {\n        \"serves\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"requirement\"]\n        },\n        \"needs\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"plan_task\"],\n          \"scope\": \"document\"\n        }\n      }\n    },\n    {\n      \"name\": \"check\",\n      \"content\": \"paragraph+\",\n      \"render\": \"host\",\n      \"attributes\": {\n        \"serves\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"requirement\"]\n        },\n        \"surface\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"browser\", \"cli\", \"api\"]\n        },\n        \"run\": {\n          \"kind\": \"string\"\n        },\n        \"when\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"before_merge\", \"after_merge\", \"default_branch\"],\n          \"default\": \"before_merge\"\n        },\n        \"negative_control\": {\n          \"kind\": \"string\"\n        }\n      }\n    }\n  ]\n}\n"
