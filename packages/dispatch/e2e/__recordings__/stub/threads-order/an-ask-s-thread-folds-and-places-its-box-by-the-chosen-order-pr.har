            "text": "{\"markdown\":\"# Replay window\\n\\nThe mirror replays the ledger on a cold start.\\n\\n:::ask{#replay-window urgency=\\\"med\\\" multiple=\\\"false\\\" state=\\\"answered\\\" answered_by=\\\"alice\\\" answered_at=\\\"2026-11-26T00:37:50.640299Z\\\" selected=\\\"[\\u0026#x22;The last hour\\u0026#x22;]\\\"}\\nWhich window does the mirror replay?\\n\\n- The last hour\\n- The last day\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Replay window\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The mirror replays the ledger on a cold start.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"replay-window\",\"multiple\":false,\"state\":\"open\",\"urgency\":\"med\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which window does the mirror replay?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last hour\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The last day\"}]}]}]}]}]},\"token\":\"sha256:0ddde7a14dfdceef17a342cddf938c51a47d51f338b0de67ee5d21a822d3f765\",\"version\":2}\n"
