      \"attributes\": {\n        \"serves\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"requirement\"]\n        },\n        \"needs\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"plan_task\"],\n          \"scope\": \"document\"\n        }\n      }\n    },\n    {\n      \"name\": \"check\",\n      \"content\": \"paragraph+\",\n      \"render\": \"host\",\n      \"attributes\": {\n        \"serves\": {\n          \"kind\": \"block[]\",\n          \"targets\": [\"requirement\"]\n        },\n        \"surface\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"browser\", \"cli\", \"api\"]\n        },\n        \"run\": {\n          \"kind\": \"string\"\n        },\n        \"when\": {\n          \"kind\": \"enum\",\n          \"choices\": [\"before_merge\", \"after_merge\", \"default_branch\"],\n          \"default\": \"before_merge\"\n        },\n        \"negative_control\": {\n          \"kind\": \"string\"\n        },\n        \"ci_check\": {\n          \"kind\": \"string\"\n        }\n      }\n    }\n  ]\n}\n"
