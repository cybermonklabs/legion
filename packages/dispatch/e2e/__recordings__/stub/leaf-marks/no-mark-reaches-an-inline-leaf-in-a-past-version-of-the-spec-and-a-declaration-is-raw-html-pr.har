            "compression": 1190,
            "text": "{\"markdown\":\"An inline leaf carries no mark, a declaration is raw HTML, and an autolink in a link label leaves the label's own link on the text around it: one block for each.\\n\\n**a**\\u003cb\\u003e**c**\\n\\n[^d]\\n\\n[^d]: note\\n\\n![x](i.png)\\n\\np \\u003c!a\\u003e q\\n\\nhttps://u.test\\n\\n[a ](u)\\u003chttps://u.test\\u003e[ b](u)\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An inline leaf carries no mark, a declaration is raw HTML, and an autolink in a link label leaves the label's own link on the text around it: one block for each.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"a\",\"marks\":[{\"type\":\"strong\",\"attrs\":{\"marker\":\"*\"}}]},{\"type\":\"html\",\"attrs\":{\"value\":\"\\u003cb\\u003e\"}},{\"type\":\"text\",\"text\":\"c\",\"marks\":[{\"type\":\"strong\",\"attrs\":{\"marker\":\"*\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"footnote_reference\",\"attrs\":{\"label\":\"d\"}}]},{\"type\":\"footnote_definition\",\"attrs\":{\"label\":\"d\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"note\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"image\",\"attrs\":{\"alt\":\"x\",\"src\":\"i.png\",\"title\":null}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"p \"},{\"type\":\"html\",\"attrs\":{\"value\":\"\\u003c!a\\u003e\"}},{\"type\":\"text\",\"text\":\" q\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://u.test\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://u.test\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"a \",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"u\"}}]},{\"type\":\"text\",\"text\":\"https://u.test\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://u.test\"}}]},{\"type\":\"text\",\"text\":\" b\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"u\