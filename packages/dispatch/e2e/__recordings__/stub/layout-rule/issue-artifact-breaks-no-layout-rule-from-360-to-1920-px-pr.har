            "size": 818,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"markdown\":\"# What the review layers open\\n\\n:::requirement{#r1}\\nEvery route of the router is reviewed, or excluded with a reason.\\n:::\\n\\n:::requirement{#r2}\\nA page is read once it is drawn, never as a loading skeleton.\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"What the review layers open\"}]},{\"type\":\"requirement\",\"attrs\":{\"blockId\":\"r1\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every route of the router is reviewed, or excluded with a reason.\"}]}]},{\"type\":\"requirement\",\"attrs\":{\"blockId\":\"r2\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A page is read once it is drawn, never as a loading skeleton.\"}]}]}]},\"token\":\"sha256:449fb5bd87662daf7fd4d86bd5f000ddfd6146aa7c1e42cbf0f44b754c330110\",\"version\":1}\n"
