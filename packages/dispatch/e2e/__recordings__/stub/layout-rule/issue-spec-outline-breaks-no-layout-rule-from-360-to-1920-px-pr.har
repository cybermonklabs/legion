            "size": 2843,
            "mimeType": "application/json",
            "compression": 1920,
            "text": "{\"targets\":[{\"ref\":\"dispatch://CORE-1\",\"kind\":\"issue\",\"name\":\"Local testing workflow for Dispatch, with every header property production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements\",\"gone\":false},{\"ref\":\"dispatch://CORE-1/artifact/decisions-md#b-4d5b9447-67cc-47fd-85c8-58e84f7dbae1\",\"kind\":\"block\",\"name\":\"## Seed one corpus for both review layers\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"type\":\"text\",\"text\":\"Seed one corpus for both review layers\"}]}]}},{\"ref\":\"dispatch://CORE-1/artifact/plan-md#b-t0\",\"kind\":\"block\",\"name\":\":::plan_task{#t0 serves=\\\"dispatch://CORE-1/artifact/requirements-md#b-r1\\\"}\\nWrite the route table.\\n:::\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Write the route table.\"}]}]}},{\"ref\":\"dispatch://CORE-1/artifact/plan-md#b-t1\",\"kind\":\"block\",\"name\":\":::plan_task{#t1 serves=\\\"dispatch://CORE-1/artifact/requirements-md#b-r2\\\" needs=\\\"dispatch://CORE-1/artifact/plan-md#b-t0\\\"}\\nDraw each page and read the locator that says it is drawn.\\n:::\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Draw each page and read the locator that says it is drawn.\"}]}]}},{\"ref\":\"dispatch://CORE-1/artifact/verification-md#b-c-ready\",\"kind\":\"block\",\"name\":\":::check{#c-ready serves=\\\"dispatch://CORE-1/artifact/requirements-md#b-r2\\\" surface=\\\"browser\\\" run=\\\"bunx playwright test --config e2e/playwright.config.ts\\\" when=\\\"before_merge\\\" negative_control=\\\"Point a row at a skeleton and the run times out on it.\\\"}\\nEach page is read once it is drawn.\\n:::\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Each page is read once it is drawn.\"}]}]}},{\"ref\":\"dispatch://CORE-1/artifact/verification-md#b-c-routes\",\"kind\":\"block\",\"name\":\":::check{#c-routes serves=\\\"dispatch://CORE-1/artifact/requirements-md#b-r1\\\" surface=\\\"cli\\\" run=\\\"bun test e2e/__tests__/review-routes.test.ts\\\" when=\\\"before_merge\\\" negative_control=\\\"Drop a row and the test names the route it no longer covers.\\\"}\\nEvery route of the router is reviewed or excluded.\\n:::\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every route of the router is reviewed or excluded.\"}]}]}},{\"ref\":\"dispatch://CORE-1/ask/fccfd2b8-a8c1-4c9a-994c-d1e62dd7f0f0\",\"kind\":\"ask\",\"name\":\"Which sign-in path?\",\"gone\":false},{\"ref\":\"dispatch://CORE-1/spec#b-35a3f96a-799d-4457-a01d-cb101c495ae4\",\"kind\":\"block\",\"name\":\"One command, a seeded corpus, a signed-in browser.\",\"gone\":false,\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One command, a seeded corpus, a signed-in browser.\"}]}]}}]}\n"
