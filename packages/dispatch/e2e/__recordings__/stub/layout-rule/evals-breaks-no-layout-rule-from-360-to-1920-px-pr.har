ren does a root have when it finishes?\",\"number_rule\":\"\",\"decision\":\"Whether Legion splits its work too much or too little at design, and how many follow-ups its work leaves behind.\",\"failure_modes\":[{\"mode\":\"A filing's class reads the parent the issue had when it was filed, so a later move does not change its class.\",\"guard\":\"The cuts read the filed issue's tree as it stands now, so a moved issue counts in the tree it is in.\"},{\"mode\":\"A filing into another project has no tree in this project and counts as a root.\",\"guard\":\"Its class still reads the filer's tree, so the filing counts as out of the tree.\"},{\"mode\":\"More filings are neither better nor worse, so a target could reward the wrong thing.\",\"guard\":\"The eval has no direction and no target.\"}],\"unit\":\"issues\",\"direction\":\"\",\"kind\":\"legion\",\"source\":\"computed:legion/metrics.FoldSplitting\",\"doc_block\":\"a36a9893-8d19-46a8-853a-d6aca62b7e90\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:49.776145Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"OPS/legion-splitting\",\"series\":\"filed:by_the_controller\",\"version\":1,\"unit\":\"issues\",\"role\":\"headline\",\"is_primary\":false,\"listed\":true,\"agg\":\"sum\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:49.776145Z\",\"window\":{\"issues\":null},\"compare\":{\"issues\":null},\"change\":{\"issues\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null},{\"eval_id\":\"OPS/legion-splitting\",\"series\":\"filed:by_the_controller:children\",\"version\":1,\"unit\":\"issues\",\"role\":\"headline\",\"is_primary