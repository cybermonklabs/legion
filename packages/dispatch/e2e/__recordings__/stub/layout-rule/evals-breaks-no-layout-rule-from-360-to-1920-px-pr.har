            "text": "{\"items\":[{\"id\":\"ACME/change-fail-rate\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/change-fail-rate\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"change-fail-rate\",\"name\":\"Change failure rate\",\"question\":\"What share of deploys broke production?\",\"number_rule\":\"\",\"decision\":\"Whether changes need more tests or review before they ship, because too many deploys break production.\",\"failure_modes\":[{\"mode\":\"A failure that a signal records counts at once, so a signal that was wrong raises the rate.\",\"guard\":\"A person or the project's controller rejects it with a reason: the rate leaves it out, and the record keeps it with that reason and who rejected it.\"},{\"mode\":\"A failure from a source the project did not turn on is not counted, so a project that turns on few sources reads a low rate.\",\"guard\":\"The project's delivery settings name the failure sources it counts, and a person's flag counts whenever any source is on.\"},{\"mode\":\"A deploy that two failures blame could count twice.\",\"guard\":\"The rate counts each deploy once, whatever number of failures blame it.\"},{\"mode\":\"A window before the project measured failures would read a rate of 0.\",\"guard\":\"The eval reads \\\"no data\\\" before the project's `failures_measured_since` and names that day.\"}],\"unit\":\"ratio\",\"direction\":\"lower_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldChangeFailRate\",\"doc_block\":\"4a9f7329-d448-44ff-9b8f-25ad2231fe38\",\"target\":0.05,\"target_inclusive\":false,\"target_judges\":[\"per_deploy.rate\"],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/change-fail-rate\",\"series\":\"per_deploy\",\"version\":1,\"unit\":\"ratio\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"ratio\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"failed\":null,\"rate\":null,\"total\":null},\"compare\":{\"failed\":null,\"rate\":null,\"total\":null},\"change\":{\"failed\":null,\"rate\":null,\"total\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null}],\"verdict\":{\"target\":0.05,\"direction\":\"lower_better\",\"inclusive\":false,\"met\":null,\"judges\":[{\"judge\":\"per_deploy.rate\",\"value\":null,\"met\":null}]}},{\"id\":\"ACME/deploy-frequency\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/deploy-frequency\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"deploy-frequency\",\"name\":\"Deploy frequency\",\"question\":\"How many deploys reach production each day?\",\"number_rule\":\"\",\"decision\":\"Whether to make changes smaller or the deploy pipeline faster, so that more changes reach production each day.\",\"failure_modes\":[{\"mode\":\"A deploy that ships no change still counts as a deploy.\",\"guard\":\"`with_prs` counts the deploys that shipped a pull request, beside the total.\"},{\"mode\":\"A deploy run that is still running has not reached production, so its day reads one deploy short.\",\"guard\":\"Dispatch builds the day again when the run concludes.\"},{\"mode\":\"A deploy that ships pull requests of two projects counts once in each project, so the projects' counts add up to more than the deployment's count.\",\"guard\":\"The Delivery page counts each deploy once for the whole deployment.\"}],\"unit\":\"deploys/day\",\"direction\":\"higher_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldDeployFrequency\",\"doc_block\":\"c6de51ff-5c0c-4f4b-9301-8d3cae8b71f7\",\"target\":20,\"target_inclusive\":true,\"target_judges\":[\"deploys.per_day\"],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/deploy-frequency\",\"series\":\"deploys\",\"version\":1,\"unit\":\"deploys\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"sum\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"deploys\":null,\"per_day\":null,\"with_prs\":null,\"with_prs_per_day\":null},\"compare\":{\"deploys\":null,\"per_day\":null,\"with_prs\":null,\"with_prs_per_day\":null},\"change\":{\"deploys\":null,\"per_day\":null,\"with_prs\":null,\"with_prs_per_day\":null},\"data_since\":\"2024-06-01\",\"via_repository\":0,\"days\":[{\"day\":\"2024-06-01\",\"statistics\":{\"deploys\":1,\"per_day\":1,\"with_prs\":1,\"with_prs_per_day\":1}}],\"compare_days\":[],\"narrowed\":null}],\"verdict\":{\"target\":20,\"direction\":\"higher_better\",\"inclusive\":true,\"met\":null,\"judges\":[{\"judge\":\"deploys.per_day\",\"value\":null,\"met\":null}]}},{\"id\":\"ACME/deploy-run-success\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/deploy-run-success\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"deploy-run-success\",\"name\":\"Deploy runs reaching production\",\"question\":\"What share of deploy runs reach production?\",\"number_rule\":\"\",\"decision\":\"Whether to fix the flaky or failing steps of the deploy pipeline.\",\"failure_modes\":[{\"mode\":\"A cancelled run is no deploy attempt and is left out, so many cancellations leave the share over few runs.\",\"guard\":\"The count of cancelled runs stands beside the share, and the count of concluded runs says how many runs it covers.\"},{\"mode\":\"A run that is still running counts in neither part of the share.\",\"guard\":\"Dispatch builds the day again when the run concludes.\"}],\"unit\":\"ratio\",\"direction\":\"higher_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldDeployRunSuccess\",\"doc_block\":\"ff63d638-39f9-499d-afb9-6158d803235c\",\"target\":0.9,\"target_inclusive\":true,\"target_judges\":[\"runs.rate\"],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/deploy-run-success\",\"series\":\"runs\",\"version\":1,\"unit\":\"ratio\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"ratio\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"cancelled\":null,\"concluded\":null,\"rate\":null,\"reached_production\":null},\"compare\":{\"cancelled\":null,\"concluded\":null,\"rate\":null,\"reached_production\":null},\"change\":{\"cancelled\":null,\"concluded\":null,\"rate\":null,\"reached_production\":null},\"data_since\":\"2024-06-01\",\"via_repository\":1,\"days\":[{\"day\":\"2024-06-01\",\"statistics\":{\"cancelled\":0,\"concluded\":2,\"rate\":0.5,\"reached_production\":1}}],\"compare_days\":[],\"narrowed\":null}],\"verdict\":{\"target\":0.9,\"direction\":\"higher_better\",\"inclusive\":true,\"met\":null,\"judges\":[{\"judge\":\"runs.rate\",\"value\":null,\"met\":null}]}},{\"id\":\"ACME/deployment-rework-rate\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/deployment-rework-rate\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"deployment-rework-rate\",\"name\":\"Deployment rework rate\",\"question\":\"What share of deploys were made to restore production after a failure?\",\"number_rule\":\"\",\"decision\":\"Whether failures cost too many unplanned deploys, so that changes need more care before they ship.\",\"failure_modes\":[{\"mode\":\"A deploy that restores a failure nobody recorded is not counted as rework.\",\"guard\":\"A person flags the failure on the deploy that caused it, and marks the deploy that restored it.\"},{\"mode\":\"A deploy that restores a failure and ships other changes counts as rework whole.\",\"guard\":\"The rate counts each deploy once, whatever it ships.\"}],\"unit\":\"ratio\",\"direction\":\"lower_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldReworkRate\",\"doc_block\":\"f81fe166-0752-4c56-bbd8-84c55ae05411\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/deployment-rework-rate\",\"series\":\"deploys\",\"version\":1,\"unit\":\"ratio\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"ratio\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"rate\":null,\"restoring\":null,\"total\":null},\"compare\":{\"rate\":null,\"restoring\":null,\"total\":null},\"change\":{\"rate\":null,\"restoring\":null,\"total\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null}],\"verdict\":null},{\"id\":\"ACME/failed-deploy-recovery\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/failed-deploy-recovery\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"failed-deploy-recovery\",\"name\":\"Failed deployment recovery time\",\"question\":\"How long does production stay broken after a deploy breaks it?\",\"number_rule\":\"\",\"decision\":\"Whether rollbacks and fixes must reach production faster.\",\"failure_modes\":[{\"mode\":\"A failure that is not restored yet has no recovery time, so the newest failures are missing from the median.\",\"guard\":\"`not_restored` counts them beside the median, on the day of their deploy.\"},{\"mode\":\"A restore that nobody records leaves its failure open.\",\"guard\":\"A revert's own deploy restores its failure, and a person marks the deploy that restored any other.\"},{\"mode\":\"A median hides one long outage among short ones.\",\"guard\":\"The day rows store every recovery time, not only the median.\"}],\"unit\":\"minutes\",\"direction\":\"lower_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldRecovery\",\"doc_block\":\"03547798-5c6a-4edc-b5a1-8ee596ec09d9\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/failed-deploy-recovery\",\"series\":\"minutes\",\"version\":1,\"unit\":\"minutes\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"quantile\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"median\":null,\"n\":null,\"not_restored\":null},\"compare\":{\"median\":null,\"n\":null,\"not_restored\":null},\"change\":{\"median\":null,\"n\":null,\"not_restored\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null}],\"verdict\":null},{\"id\":\"ACME/first-commit-to-production\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/first-commit-to-production\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"first-commit-to-production\",\"name\":\"First commit to production\",\"question\":\"How long does a change take from its first commit to production?\",\"number_rule\":\"\",\"decision\":\"Whether changes stay too long on their branches before they ship.\",\"failure_modes\":[{\"mode\":\"The first commit's time is its author date, which the author's own git client records, so a wrong clock or an old commit moves it.\",\"guard\":\"One wrong time moves the median little.\"},{\"mode\":\"A pull request whose first commit time Dispatch does not know is left out.\",\"guard\":\"The count `n` says how many pull requests the figures cover.\"},{\"mode\":\"A pull request that has not deployed yet is left out.\",\"guard\":\"Dispatch builds the merge day again when the run that ships the pull request lands.\"}],\"unit\":\"minutes\",\"direction\":\"lower_better\",\"kind\":\"delivery\",\"source\":\"computed:delivery/measures.FoldLeadTime\",\"doc_block\":\"ef407cd9-52c7-4d76-91fe-b5908018280b\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/first-commit-to-production\",\"series\":\"minutes\",\"version\":1,\"unit\":\"minutes\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"quantile\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"max\":null,\"median\":null,\"n\":null,\"p90\":null},\"compare\":{\"max\":null,\"median\":null,\"n\":null,\"p90\":null},\"change\":{\"max\":null,\"median\":null,\"n\":null,\"p90\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null}],\"verdict\":null},{\"id\":\"ACME/legion-idle-time\",\"declared_charts\":0,\"definition\":{\"eval_id\":\"ACME/legion-idle-time\",\"version\":1,\"project_key\":\"ACME\",\"slug\":\"legion-idle-time\",\"name\":\"Idle time by role\",\"question\":\"For each role, how many hours does an issue hold its slot in that role's phase while the role is not in a turn?\",\"number_rule\":\"\",\"decision\":\"Whether a role's sessions leave issues waiting between turns, so that the daemon must start their turns sooner.\",\"failure_modes\":[{\"mode\":\"An hour in which a role waits for CI or for a person between its turns counts as idle.\",\"guard\":\"Phase time's segments show what those hours waited on.\"},{\"mode\":\"A role with no claim observation counts as not working, so before the daemon records claim states every hour would read as idle.\",\"guard\":\"The eval reads \\\"no data\\\" for a window that starts before the project's first claim observation.\"}],\"unit\":\"hours\",\"direction\":\"lower_better\",\"kind\":\"legion\",\"source\":\"computed:legion/metrics.FoldIdleTime\",\"doc_block\":\"e5e2da76-aad4-4deb-a15d-377279185e97\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/legion-idle-time\",\"series\":\"architect\",\"version\":1,\"unit\":\"hours\",\"role\":\"headline\",\"is_primary\":false,\"listed\":true,\"agg\":\"quantile\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T00:23:50.542987Z\",\"window\":{\"hours\":null,\"median\":null,\"n\":null,\"p90\":null},\"compare\":{\"hours\":null,\"median\":null,\"n\":null,\"p90\":null},\"change\":{\"hours\":null,\"median\":null,\"n\":null,\"p90\":null},\"data_since\