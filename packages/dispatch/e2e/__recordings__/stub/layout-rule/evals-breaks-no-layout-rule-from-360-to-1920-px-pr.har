care before review, so that fewer issues come back.\",\"failure_modes\":[{\"mode\":\"Before the daemon's observations of an issue, its rounds and send-backs come from Dispatch's statuses, where `needs_review` is both reviewing and accepting.\",\"guard\":\"From the first observation on, the daemon's own phases replace the statuses.\"},{\"mode\":\"A send-back for a red check counts as rework, although the change itself can be right.\",\"guard\":\"`hours_after_first_review` shows how much work the send-backs cost.\"}],\"unit\":\"rounds\",\"direction\":\"lower_better\",\"kind\":\"legion\",\"source\":\"computed:legion/metrics.FoldRework\",\"doc_block\":\"bcc6012f-c1fb-478c-8ce4-41a5f695d66b\",\"target\":null,\"target_inclusive\":false,\"target_judges\":[],\"owner_role\":\"\",\"person\":\"\",\"issue_key\":\"\",\"state\":\"active\",\"replaced_by\":\"\",\"links\":[],\"written_via\":\"seed\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"},\"created_at\":\"2026-11-28T11:07:14.517367Z\",\"answer\":\"\"},\"owner\":{\"role\":\"\",\"person\":\"\",\"written_by\":{\"kind\":\"system\",\"id\":\"eval-registry\"}},\"series\":[{\"eval_id\":\"ACME/legion-rework\",\"series\":\"review_rounds\",\"version\":1,\"unit\":\"rounds\",\"role\":\"headline\",\"is_primary\":true,\"listed\":true,\"agg\":\"quantile\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T11:07:14.517367Z\",\"window\":{\"median\":null,\"n\":null,\"p90\":null},\"compare\":{\"median\":null,\"n\":null,\"p90\":null},\"change\":{\"median\":null,\"n\":null,\"p90\":null},\"data_since\":null,\"via_repository\":0,\"days\":[],\"compare_days\":[],\"narrowed\":null},{\"eval_id\":\"ACME/legion-rework\",\"series\":\"hours_after_first_review\",\"version\":1,\"unit\":\"hours\",\"role\":\"headline\",\"is_primary\":false,\"listed\":true,\"agg\":\"quantile\",\"links\":[],\"min_n\":null,\"created_at\":\"2026-11-28T11:07:14.517367Z\",\"window\":{\"hours\":null,\"median\":null,\"n\":null,\"p90\":null},\"compare\":{\"hours\":nu