            "mimeType": "application/json",
            "compression": 722,
            "text": "{\"markdown\":\"# Local testing workflow\\n\\nOne command, a seeded corpus, a signed-in browser.\\n\\n:::ask{#a78f708f-de64-486a-8cc1-5cf8aa1f7f9a urgency=\\\"high\\\" multiple=\\\"false\\\" state=\\\"open\\\"}\\nWhich sign-in path?\\n\\n- Cookie: the production identity, issued by the sign-in pool\\n- Header: a test/local harness identity\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Local testing workflow\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One command, a seeded corpus, a signed-in browser.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"a78f708f-de64-486a-8cc1-5cf8aa1f7f9a\",\"multiple\":false,\"state\":\"open\",\"urgency\":\"high\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which sign-in path?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cookie: the production identity, issued by the sign-in pool\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Header: a test/local harness identity\"}]}]}]}]}]},\"token\":\"sha256:9a314e8d09cb8282e1c172d4b94c6a2915bdcb697cf4c433d4f12cbb3ca341bd\",\"version\":1}\n"
