            "text": "{\"sources\":[{\"repo\":\"acme/layout-architecture\",\"branch\":\"main\",\"last_commit\":\"e55d84bfe384c5da044f6bfaf47307097558dda6\",\"last_sync_at\":\"2026-11-27T04:46:37.106588Z\",\"last_error\":null}],\"totals\":{\"issues_done\":1,\"issues_total\":36,\"unassigned\":30,\"not_architectural\":0,\"components_without_work\":2,\"retired_links\":0},\"unassigned\":[{\"key\":\"CORE-4\",\"title\":\"Snooze an Inbox row until tomorrow\",\"status\":\"triage\"},{\"key\":\"CORE-7\",\"title\":\"A retracted ask stays in history\",\"status\":\"triage\"},{\"key\":\"CORE-14\",\"title\":\"The verification record of a change survives a force-push, and says which of its results were read from a commit that is no longer the head of the change\",\"status\":\"triage\"},{\"key\":\"CORE-25\",\"title\":\"Dispatch's surfaces lay out by one rule, at every width a reader sets\",\"status\":\"triage\"},{\"key\":\"CORE-30\",\"title\":\"Which header groups a reader acts on stay on the first line - measured on production at every width from 360 to 1920 pix\",\"status\":\"triage\"},{\"key\":\"CORE-31\",\"title\":\"Inbox stress 1: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-32\",\"title\":\"Inbox stress 2: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-33\",\"title\":\"Inbox stress 3: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-34\",\"title\":\"Inbox stress 4: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-35\",\"title\":\"Inbox stress 5: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-36\",\"title\":\"Inbox stress 6: a question production holds - measured on production at every width from 360 to 1920 pixels, where a row of elements either\",\"status\":\"triage\"},{\"key\":\"CORE-16\",\"title\":\"Show a change's verification record in the margin of its pull request, beside the lines each of its checks read\",\"status\":\"icebox\"},{\"key\":\"CORE-5\",\"title\":\"Agents page freshness folds\",\"status\":\"backlog\"},{\"key\":\"CORE-19\",\"title\":\"Fold the unit suites' and the browser suites' reports into the one record a change keeps, and retire the two pages that drew them\",\"status\":\"backlog\"},{\"key\":\"CORE-13\",\"title\":\"A check that failed on a change that is right can be read past with a reason, and the reason stays beside that check for the next reader of the same change\",\"status\":\"todo\"},{\"key\":\"CORE-20\",\"title\":\"The hundred searches that opened no page last month each open the page that answers them\",\"status\":\"todo\"},{\"key\":\"CORE-23\",\"title\":\"The one command that starts the stack on a new machine loads the sample data and opens the tour\",\"status\":\"todo\"},{\"key\":\"CORE-8\",\"title\":\"The broadcast composer keeps each recipient's place in the send order when the list it was picked from refreshes under the sender\",\"status\":\"in_progress\"},{\"key\":\"CORE-10\",\"title\":\"Each change starts its verification run the moment it is pushed, before any reviewer is asked to read it\",\"status\":\"in_progress\"},{\"key\":\"CORE-11\",\"title\":\"The record a verification run leaves beside a change names the commit it read, the command it ran and the line of the change each failed check points at\",\"status\":\"in_progress\"},{\"key\":\"CORE-18\",\"title\":\"Every check writes its result to the one record a change keeps, with the commit it read\",\"status\":\"in_progress\"},{\"key\":\"CORE-21\",\"title\":\"The suites record which rows failed on which commit, and list a row that failed and then passed on one commit as flaky\",\"status\":\"in_progress\"},{\"key\":\"CORE-12\",\"title\":\"A reviewer opening a change sees whether its checks ran, passed and read its newest commit, without opening a log\",\"status\":\"testing\"},{\"key\":\"CORE-3\",\"title\":\"Broadcast recipients keep their send order\",\"status\":\"needs_review\"},{\"key\":\"CORE-9\",\"title\":\"The Inbox count on the rail settles within a second of a reply being read on another device, and never counts one reply twice while the read that clears it is still in flight on a slow link\",\"status\":\"needs_review\"},{\"key\":\"CORE-17\",\"title\":\"Each change carries a line for the release notes, or says why its readers need none\",\"status\":\"needs_review\"},{\"key\":\"CORE-24\",\"title\":\"What a person types into a session is kept where the next host can read it, as they type it\",\"status\":\"needs_review\"},{\"key\":\"CORE-15\",\"title\":\"The browser suite runs only the rows that read the pages a change touches, and says which rows it left out and why\",\"status\":\"retro\"},{\"key\":\"CORE-22\",\"title\":\"The weekly read of the flaky list fixes the row at its top and writes down what made it flaky\",\"status\":\"retro\"},{\"key\":\"CORE-6\",\"title\":\"Phone layout of the review sheet\",\"status\":\"done\"}],\"not_architectural\":[],\"retired_links\":[],\"components\":[{\"id\":\"agent-live-view\",\"source\":\"acme/layout-architecture\",\"title\":\"The agent live view - measured on production at\",\"parent\":null,\"depends_on\":[],\"paths\":[],\"external\":false,\"prose\":\"One part of the dashboard.\\n\",\"done\":0,\"total\":6,\"own_done\":0,\"own_total\":6,\"issues\":[{\"key\":\"CORE-2\",\"title\":\"Seed the local corpus\",\"status\":\"triage\",\"priority\":null,\"parent\":\"CORE-1\",\"external_links\":[],\"updated_at\":\"2026-11-27T04:46:35.897999Z\",\"attached\":\"inherited\"},{\"key\":\"CORE-26\",\"title\":\