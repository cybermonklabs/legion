            "text": "{\"markdown\":\"# Rollout order\\n\\nThe ledger and the mirror each keep a clock of their own.\\n\\n:::ask{#rollout-order urgency=\\\"med\\\" multiple=\\\"false\\\" state=\\\"open\\\"}\\nWhich service moves first?\\n\\n- Ledger first\\n- Mirror first\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Rollout order\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The ledger and the mirror each keep a clock of their own.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"rollout-order\",\"multiple\":false,\"state\":\"open\",\"urgency\":\"med\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which service moves first?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ledger first\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mirror first\"}]}]}]}]}]},\"token\":\"sha256:e51ef6b3ed073544a6778c92b1a13a601923aa27b46bf74ff9268f2ace20af8b\",\"version\":1}\n"
