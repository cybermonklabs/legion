          "content": {
            "size": 1049,
            "mimeType": "application/json",
            "compression": 572,
            "text": "{\"markdown\":\"# Rollout order\\n\\nThe ledger and the mirror each keep a clock of their own.\\n\\n:::ask{#rollout-order urgency=\\\"med\\\" multiple=\\\"false\\\" state=\\\"open\\\"}\\nWhich service moves first?\\n\\n- Ledger first\\n- Mirror first\\n:::\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Rollout order\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The ledger and the mirror each keep a clock of their own.\"}]},{\"type\":\"ask\",\"attrs\":{\"blockId\":\"rollout-order\",\"multiple\":false,\"state\":\"open\",\"urgency\":\"med\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Which service moves first?\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ledger first\"}]}]},{\"type\":\"list_item\",\"attrs\":{\"spread\":false},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mirror first\"}]}]}]}]}]},\"token\":\"sha256:7f418f7dc5f90c7c3d3ed3c28c2e288d5844d1377a528bb67c25ea89cefadd08\",\"version\":1}\n"
          },
