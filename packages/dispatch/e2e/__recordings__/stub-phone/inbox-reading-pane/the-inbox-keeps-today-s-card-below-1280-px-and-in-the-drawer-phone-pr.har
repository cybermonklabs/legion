          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Accept",
              "value": "*/*"
            },
            {
              "name": "Accept-Encoding",
              "value": "gzip, deflate, br, zstd"
            },
            {
              "name": "Accept-Language",
              "value": "en-US"
            },
            {
              "name": "Connection",
              "value": "keep-alive"
            },
            {
              "name": "Sec-Fetch-Dest",
              "value": "empty"
            },
            {
              "name": "Sec-Fetch-Mode",
              "value": "cors"
            },
            {
              "name": "Sec-Fetch-Site",
              "value": "same-origin"
            }
          ],
          "queryString": []
        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Content-Length",
              "value": "1890"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ],
          "content": {
            "size": 1890,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"markdown\":\"# Ledger rollout\\n\\nScope anchor: the ledger keeps a clock of its own in both versions.\\n\\nWindow anchor: the mirror keeps its retry budget in both versions.\\n\\nStep 1: the mirror reads the clock before the ledger writes it.\\n\\nStep 2: the mirror reads the clock before the ledger writes it.\\n\\nStep 3: the mirror reads the clock before the ledger writes it.\\n\\nStep 4: the mirror reads the clock before the ledger writes it.\\n\\nStep 5: the mirror reads the clock before the ledger writes it.\\n\\nStep 6: the mirror reads the clock before the ledger writes it.\\n\\nStep 7: the mirror reads the clock before the ledger writes it.\\n\\nStep 8: the mirror reads the clock before the ledger writes it.\\n\\nStep 9: the mirror reads the clock before the ledger writes it.\\n\\nStep 10: the mirror reads the clock before the ledger writes it.\\n\\nThe retry budget is seven attempts per lease.\\n\\nStep 12: the mirror reads the clock before the ledger writes it.\\n\\nStep 13: the mirror reads the clock before the ledger writes it.\\n\\nStep 14: the mirror reads the clock before the ledger writes it.\\n\\nStep 15: the mirror reads the clock before the ledger writes it.\\n\\nStep 16: the mirror reads the clock before the ledger writes it.\\n\\nStep 17: the mirror reads the clock before the ledger writes it.\\n\\nStep 18: the mirror reads the clock before the ledger writes it.\\n\\nStep 19: the mirror reads the clock before the ledger writes it.\\n\\nStep 20: the mirror reads the clock before the ledger writes it.\\n\\nStep 21: the mirror reads the clock before the ledger writes it.\\n\\nStep 22: the mirror reads the clock before the ledger writes it.\\n\",\"number\":4,\"named\":true,\"summary\":\"The mirror-first rollout\",\"authors\":[{\"kind\":\"session\",\"id\":\"e2e-reading-pane\"}],\"created_at\":\"2026-11-12T15:54:55.699086Z\",\"size\":1578,\"sha256\":\"3dbc256416759b3f5ba2a0e04529ca636d2936b083d79115d22450bb306c04df\"}\n"
          },
          "redirectURL": "",
          "_transferSize": 2000
        },
        "_resourceType": "fetch"
      },
