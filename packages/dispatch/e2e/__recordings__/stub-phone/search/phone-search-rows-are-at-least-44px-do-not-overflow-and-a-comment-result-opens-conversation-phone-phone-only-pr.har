          "content": {
            "size": 4263,
            "mimeType": "application/json",
            "compression": 3098,
            "text": "{\"results\":[{\"kind\":\"issue\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"id\":\"CORE-1\",\"snippet\":\"Navigation instruments\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Navigation instruments\"}]}]},\"rank\":0.004683840958798518,\"href\":\"/issues/CORE-1\"},{\"kind\":\"document\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"artifact\":{\"slug\":\"spec\",\"name\":\"spec.md\"},\"id\":\"bda585da-9eeb-4e90-b55d-a430d1cd85a3\",\"snippet\":\"# Instruments\\n\\nThe \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e measures altitude. Every \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e is brass.\\n\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Instruments\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" measures altitude. Every \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" is brass.\"}]}]},\"rank\":0.0027322405185855802,\"href\":\"/issues/CORE-1/spec?q=astrolabe\"},{\"kind\":\"ask\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"id\":\"e8b44d0a-03df-4b0f-904a-9f97d6ba3927\",\"snippet\":\"Where does the \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e live between voyages? On the chart table In the captain\\u0026#39;s cabin Keep the \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e on the chart table during\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Where does the \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" live between voyages? On the chart table In the captain's cabin Keep the \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" on the chart table during\"}]}]},\"rank\":0.0027322405185855802,\"href\":\"/issues/CORE-1/asks/e8b44d0a-03df-4b0f-904a-9f97d6ba3927\",\"ask\":{\"state\":\"answered\",\"answer\":{\"user\":\"alice\",\"selected\":[\"On the chart table\"],\"text\":\"Keep the astrolabe on the chart table during every crossing, and recalibrate its rete against the meridian at local noon whenever the sky is clear enough to take a clean sighting. Log each reading beside the dead-reckoning position in the ship's book, note the observer and the instrument's serial number, and send any drift larger than half a degree to the instrument maker before the next voyage leaves port.\",\"at\":\"2026-11-26T00:38:05.457646Z\",\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Keep the astrolabe on the chart table during every crossing, and recalibrate its rete against the meridian at local noon whenever the sky is clear enough to take a clean sighting. Log each reading beside the dead-reckoning position in the ship's book, note the observer and the instrument's serial number, and send any drift larger than half a degree to the instrument maker before the next voyage leaves port.\"}]}]},\"selected_trees\":[{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"On the chart table\"}]}]}]}},\"author\":{\"kind\":\"session\",\"id\":\"e2e-search\"}},{\"kind\":\"comment\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-2\",\"title\":\"Other work\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-2\",\"title\":\"Other work\",\"status\":\"triage\"},\"id\":\"671baa1b-ad18-442d-b4e4-ca51e5ce4d63\",\"snippet\":\"Move the \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e diagram.\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Move the \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" diagram.\"}]}]},\"rank\":0.0014903130101375892,\"href\":\"/issues/CORE-2/comments/671baa1b-ad18-442d-b4e4-ca51e5ce4d63\",\"author\":{\"kind\":\"user\",\"id\":\"alice\",\"proven\":true}}],\"total\":4,\"reachable\":4,\"limit\":20,\"offset\":0,\"took_ms\":26,\"query\":{\"operators\":[],\"broadened\":false},\"filters\":{}}\n"
