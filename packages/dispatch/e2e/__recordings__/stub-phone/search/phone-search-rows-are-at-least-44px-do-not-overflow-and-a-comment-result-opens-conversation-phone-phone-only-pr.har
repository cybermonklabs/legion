            "text": "{\"results\":[{\"kind\":\"issue\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"id\":\"CORE-1\",\"snippet\":\"Navigation instruments\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Navigation instruments\"}]}]},\"rank\":0.004683840958798518,\"href\":\"/issues/CORE-1\"},{\"kind\":\"ask\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"id\":\"2947b2fc-0f4a-4f55-8691-c8465b2faedd\",\"snippet\":\"Where does the \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e live between voyages? On the chart table In the captain\\u0026#39;s cabin Keep the \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e on the chart table during\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Where does the \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" live between voyages? On the chart table In the captain's cabin Keep the \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" on the chart table during\"}]}]},\"rank\":0.0027322405185855802,\"href\":\"/issues/CORE-1/asks/2947b2fc-0f4a-4f55-8691-c8465b2faedd\",\"ask\":{\"state\":\"answered\",\"answer\":{\"user\":\"alice\",\"selected\":[\"On the chart table\"],\"text\":\"Keep the astrolabe on the chart table during every crossing, and recalibrate its rete against the meridian at local noon whenever the sky is clear enough to take a clean sighting. Log each reading beside the dead-reckoning position in the ship's book, note the observer and the instrument's serial number, and send any drift larger than half a degree to the instrument maker before the next voyage leaves port.\",\"at\":\"2026-11-24T12:03:53.190409Z\",\"text_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Keep the astrolabe on the chart table during every crossing, and recalibrate its rete against the meridian at local noon whenever the sky is clear enough to take a clean sighting. Log each reading beside the dead-reckoning position in the ship's book, note the observer and the instrument's serial number, and send any drift larger than half a degree to the instrument maker before the next voyage leaves port.\"}]}]}}}},{\"kind\":\"document\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-1\",\"title\":\"Navigation instruments\",\"status\":\"triage\"},\"artifact\":{\"slug\":\"spec\",\"name\":\"spec.md\"},\"id\":\"939ed44f-3dfd-49ed-9872-2e638bf7469c\",\"snippet\":\"Instruments\\n\\nThe \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e measures altitude. Every \\u003cmark\\u003eastrolabe\\u003c/mark\\u003e is brass\",\"snippet_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instruments\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" measures altitude. Every \"},{\"type\":\"text\",\"text\":\"astrolabe\",\"marks\":[{\"type\":\"searchHighlight\"}]},{\"type\":\"text\",\"text\":\" is brass\"}]}]},\"rank\":0.0027322405185855802,\"href\":\"/issues/CORE-1/spec?q=astrolabe\"},{\"kind\":\"comment\",\"owner\":{\"kind\":\"issue\",\"key\":\"CORE-2\",\"title\":\"Other work\",\"status\":\"triage\"},\"issue\":{\"key\":\"CORE-2\",\"title\":\"Other work\",\"status\":\"triage\"},\"id\":\"0637fdcb-5cf9-4adf-8d0a-b8706f8ccfef\",\"snippet\":\