{
  "name": "claude-envoy",
  "version": "1.0.0",
  "description": "Put Envoy and Dispatch messages into the Codex session's own conversation, show it on Dispatch's Agents page, and expose the Envoy and dispatch tools.",
  "license": "Apache-2.0",
  "repository": "https://github.com/cybermonklabs/legion",
  "skills": "./skills/",
  "hooks": "./codex/hooks.json",
  "mcpServers": {
    "envoy": {
      "command": "bun",
      "args": [
        "./dist/envoy-channel.js",
        "--host",
        "codex"
      ],
      "cwd": "./",
      "env_vars": [
        "CODEX_HOME",
        "DISPATCH_STATE_DIR",
        "DISPATCH_TOKEN",
        "DISPATCH_URL",
        "ENVOY_CONFIG_FILE",
        "ENVOY_HEARTBEAT_MS",
        "ENVOY_NATS_URL",
        "ENVOY_SESSION_TITLE",
        "ENVOY_TOKEN",
        "ENVOY_TOKEN_FILE",
        "ENVOY_URL",
        "TMUX",
        "TMUX_PANE",
        "XDG_CONFIG_HOME",
        "XDG_RUNTIME_DIR",
        "XDG_STATE_HOME"
      ],
      "tools": {
        "dispatch": {
          "approval_mode": "approve"
        }
      }
    }
  },
  "interface": {
    "displayName": "Envoy",
    "shortDescription": "This session on Dispatch's Agents page, with its messages",
    "developerName": "Legion",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ]
  }
}
