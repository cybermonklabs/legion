# proxy-raw-path-decoded: the decision is handed the decoded path as the raw one, in which an
# encoded "/" is already a "/", so a path holding %2F is carried.
# must fail: TestAPathTwoReadersResolveApartIsRefused
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/bound.go
+++ b/packages/envoy/internal/cipher/proxy/bound.go
@@ -287,7 +287,9 @@
 		Path:       r.URL.Path,
 		// The path as the command sent it, percent-encoding kept, which is the one form that
 		// tells an encoded "/" the decision refuses from a "/".
-		RawPath: r.URL.EscapedPath(),
+		// MUTANT: the decision reads the decoded path as the raw one, in which an encoded "/" is
+		// already a "/".
+		RawPath: r.URL.Path,
 		Headers: headersOf(r.Header),
 		Query:   r.URL.RawQuery,
 		// The decision never reads the body. The airlock swaps headers alone, so nothing it
