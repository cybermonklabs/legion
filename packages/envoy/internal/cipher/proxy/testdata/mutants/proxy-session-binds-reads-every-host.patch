# proxy-session-binds-reads-every-host: a CONNECT to a host no binding of the rules binds reads the
# enrollment's other grants all the same, so a read of them that does not happen refuses a tunnel to
# a public host they had no part in.
# must fail: TestAFailedReadOfTheEnrollmentsGrantsDecidesOnlyWhatItCouldChange
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/enrollment.go
+++ b/packages/envoy/internal/cipher/proxy/enrollment.go
@@ -141,7 +141,8 @@ func (s *Server) otherGrantsBinding(ctx context.Context, rules proxyrules.Rules,
 		return nil, nil
 	}
 	names := boundEntries(rules, host, port)
-	if len(names) == 0 {
+	// MUTANT: the enrollment's grants are read for every host, one no binding binds included.
+	if len(names) == 0 && false {
 		return nil, nil
 	}
 	return s.grants.ProxyGrantsOfEnrollment(ctx, own.EnrollmentID, own.GrantID, names)
