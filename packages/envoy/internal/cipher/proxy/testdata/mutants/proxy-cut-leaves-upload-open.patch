# proxy-cut-leaves-upload-open: a grant's end sets no read deadline on the command's side, so the
# transport's close of an HTTP/1.1 request body the command is still sending reads on from the
# command, the reset that ends the call at the service waits for that close, and the service goes
# on reading the upload.
# must fail: TestACallStillUploadingIsCutWhenItsGrantEnds
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/bound.go
+++ b/packages/envoy/internal/cipher/proxy/bound.go
@@ -577,7 +577,7 @@
 		return
 	}
 	controller := http.NewResponseController(c.w)
-	_ = controller.SetReadDeadline(pastDeadline)
+	// MUTANT: no read deadline, so the command's upload is not ended at the command.
 	if c.started {
 		_ = controller.SetWriteDeadline(pastDeadline)
 	}
