# proxy-handled-for-reads-without-placeholder: a request the connection's own grant binds the host
# for, and whose headers hold no placeholder, reads the enrollment's other grants all the same, so a
# read of them that does not happen refuses a request they could not have taken.
# must fail: TestAFailedReadOfTheEnrollmentsGrantsDecidesOnlyWhatItCouldChange
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/enrollment.go
+++ b/packages/envoy/internal/cipher/proxy/enrollment.go
@@ -70,4 +70,5 @@ func (s *Server) handledFor(ctx context.Context, rules proxyrules.Rules, own req
-	if found && (fallback.holdsPlaceholder || !headersHoldPlaceholder(prefixes, request.Headers)) {
+	// MUTANT: a request holding no placeholder reads the enrollment's grants too.
+	if found && (fallback.holdsPlaceholder || !headersHoldPlaceholder(prefixes, request.Headers) && false) {
 		return fallback, true, nil
 	}
 	others, err := s.otherGrantsBinding(ctx, rules, own, host, port)
