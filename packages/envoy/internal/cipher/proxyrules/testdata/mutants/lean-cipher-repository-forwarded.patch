-    some { r with headers := (r.headers.filter keepHeader).map (swapHeader (allowedHeaders bk.2) g.placeholder value) }
+    -- MUTANT: Cipher-Repository is forwarded with every other header.
+    some { r with headers := r.headers.map (swapHeader (allowedHeaders bk.2) g.placeholder value) }
