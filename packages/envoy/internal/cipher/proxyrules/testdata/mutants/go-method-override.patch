# list, so an allow of {GET, /prefix} carries the value on a request whose
# X-HTTP-Method-Override names DELETE and the service acts on that. Caught by the comparison
# fuzz test: the model still answers "request carries a method override header". Applied with
# patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -580,8 +580,8 @@
 		return nil, "not allowed by rule"
 	case !allowOK(b.Allow, r):
 		return nil, "not allowed by the profile's rule"
-	case (k.Allow != nil || b.Allow != nil) && hasMethodOverride(r):
-		return nil, "request carries a method override header"
+	// MUTANT: an allow of {GET, /prefix} alone now carries the value on a request whose
+	// X-HTTP-Method-Override says DELETE, which the service acts on.
 	}
