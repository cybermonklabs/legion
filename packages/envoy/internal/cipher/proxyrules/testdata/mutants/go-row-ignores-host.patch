# go-row-ignores-host: an allow row's host is not read, so a profile row for one host of its
# kind allows the request at every host of the kind. Caught by the comparison fuzz test: the
# model still answers "not allowed by the profile's rule" for a request to another host.
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -400,7 +400,9 @@
 		return true
 	}
 	for _, a := range allow {
-		if a.Method == r.Method && (a.Host == "" || fold.ASCII(a.Host) == r.ConnectHost) && prefixOK(a.PathPrefix, r.Path) {
+		// MUTANT: a row's host is not read, so a profile row for api.github.com allows the
+		// request at every host of its kind.
+		if a.Method == r.Method && prefixOK(a.PathPrefix, r.Path) {
 			return true
 		}
 	}
