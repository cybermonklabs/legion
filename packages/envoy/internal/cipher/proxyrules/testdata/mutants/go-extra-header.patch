# header as it came in. Applied with patch -p1 from a copy of the repository.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -757,7 +757,8 @@
