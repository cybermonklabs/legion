# authorization. Caught by the comparison fuzz test: the model's rewrite leaves that
# header as it came in. Applied with patch -p1 from a copy of the repository.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -609,7 +609,8 @@
 	if k == nil {
 		return nil
 	}
-	names := k.HeaderNames()
+	// MUTANT: authorization is swapped too, even when the kind does not name it.
+	names := append([]string{"authorization"}, k.HeaderNames()...)
 	out := *r
 	out.Headers = make([][2]string, 0, len(r.Headers))
 	for _, h := range r.Headers {
