# go-encoded-slash: check drops the refusal of a path the command sent with "%2F" or "%2f" under
# an allow list, so an allow prefix bounds the decoded path while a service may read the escape
# as a byte of one segment. Caught by the comparison fuzz test: the model still answers "path
# has an encoded slash". Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -695,8 +695,8 @@
 		return nil, "path has a dot segment"
 	case listed && hasEmptySegment(r.Path):
 		return nil, "path has an empty segment"
-	case listed && hasEncodedSlash(r.RawPath):
-		return nil, "path has an encoded slash"
+	// MUTANT: a path sent with an encoded "/" is no longer refused under an allow list, so a
+	// service that reads "%2F" as a byte of one segment reads another path than the prefix held.
 	case listed && hasBackslash(r.RawPath):
 		return nil, "path has a backslash"
 	case listed && hasDotSegmentParameter(r.Path):
