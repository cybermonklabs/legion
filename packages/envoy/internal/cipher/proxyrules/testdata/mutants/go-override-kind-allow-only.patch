# go-override-kind-allow-only: check's refusal of a method override header reads the kind's
# allow alone, so a profile's allow under a kind with none carries the value on a request
# whose X-HTTP-Method-Override names another method. Caught by the comparison fuzz test: the
# model still answers "request carries a method override header" when only the profile has an
# allow. Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -660,7 +660,10 @@
 		return nil, "not allowed by rule"
 	case !allowOK(b.Allow, r):
 		return nil, "not allowed by the profile's rule"
-	case listed && hasMethodOverride(r):
+	// MUTANT: the override refusal reads the kind's allow alone, so a profile's allow under a
+	// kind with none carries the value on a request whose X-HTTP-Method-Override names
+	// another method.
+	case k.Allow != nil && hasMethodOverride(r):
 		return nil, "request carries a method override header"
 	case listed && hasMethodOverrideParameter(r.Query):
 		return nil, "request carries a method override parameter"
