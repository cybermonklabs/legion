# go-empty-segment: check drops the refusal of a path with an empty segment ("//") under an
# allow list, so an allow prefix bounds the path as it is written rather than the path a reader
# that merges slashes reads. Caught by the comparison fuzz test: the model still answers "path
# has an empty segment". Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -646,8 +646,8 @@
 		return nil, "host header mismatch"
 	case hasDotSegment(r.Path):
 		return nil, "path has a dot segment"
-	case listed && hasEmptySegment(r.Path):
-		return nil, "path has an empty segment"
+	// MUTANT: a path with an empty segment is no longer refused under an allow list, so
+	// "/v1//admin" passes a "/v1/" prefix and a reader that merges slashes reads /v1/admin.
 	case listed && hasEncodedSlash(r.RawPath):
 		return nil, "path has an encoded slash"
 	case listed && hasBackslash(r.RawPath):
