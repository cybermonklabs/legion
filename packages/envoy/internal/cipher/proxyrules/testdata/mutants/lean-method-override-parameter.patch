# lean-method-override-parameter: the model's check drops the refusal of a "_method" query
# parameter under an allow list. Caught by lake build: check_ok, and T2 through it, state that a
# request carried under an allow list holds no such parameter, and that proof no longer holds.
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/lean/Airlock/Model.lean
+++ b/packages/envoy/internal/cipher/proxyrules/lean/Airlock/Model.lean
@@ -482,8 +482,7 @@
       else if !allowOK b.allow r then .error "not allowed by the profile's rule"
       else if listed k b && hasMethodOverride r then
         .error "request carries a method override header"
-      else if listed k b && hasMethodOverrideParameter r.query then
-        .error "request carries a method override parameter"
+      -- MUTANT: a `_method` query parameter is no longer refused under an allow list.
       else if r.headers.any (fun h => carries value h.2) then
         .error "request already carries the value"
       else .ok (b, k)
