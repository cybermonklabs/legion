# go-prefix-starts-with: an allow row's prefix is a plain starts-with, so a row of
# "/storage-limit" allows "/storage-limitX", another route. Caught by the comparison fuzz
# test: the model still refuses a path beside a prefix's "/" boundary. Applied with patch -p1
# from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -411,10 +411,8 @@
 // So "/storage-limit" holds "/storage-limit" and "/storage-limit/7" and not "/storage-limitX",
 // which a plain starts-with would let through to another route.
 func prefixOK(prefix, path string) bool {
-	if !strings.HasPrefix(path, prefix) {
-		return false
-	}
-	return len(path) == len(prefix) || strings.HasSuffix(prefix, "/") || path[len(prefix)] == '/'
+	// MUTANT: a plain starts-with, so "/storage-limitX" passes a row of "/storage-limit".
+	return strings.HasPrefix(path, prefix)
 }
 
 // Covers reports whether old covers row by the conservative cover rule, which may refuse a row
