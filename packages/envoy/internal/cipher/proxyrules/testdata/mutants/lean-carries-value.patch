# lean-carries-value: the model's check drops the refusal of a request that already
# carries the real value. Caught by lake build: check_ok states that no header of the incoming
# request carries it, and T1 is read through it. Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/lean/Airlock/Model.lean
+++ b/packages/envoy/internal/cipher/proxyrules/lean/Airlock/Model.lean
@@ -488,8 +488,7 @@
         .error "request carries a method override header"
       else if listed k b && hasMethodOverrideParameter r.query then
         .error "request carries a method override parameter"
-      else if r.headers.any (fun h => carries value h.2) then
-        .error "request already carries the value"
+      -- MUTANT: a request that already carries the real value is forwarded all the same.
       else .ok (b, k)
 
 def decideReq (rules : Rules) (g : Grant) (value : String) (r : Request) : Decision :=
