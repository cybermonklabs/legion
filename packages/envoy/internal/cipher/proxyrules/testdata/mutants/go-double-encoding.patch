# go-double-encoding: check drops the refusal of a decoded path that still holds an escaped "/",
# ".", "\" or "%" under an allow list, so a server that decodes twice reads another path than the
# allow prefix held. Caught by the comparison fuzz test: the model still answers "path has a
# double-encoded character". Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -701,8 +701,8 @@
 		return nil, "path has a backslash"
 	case listed && hasDotSegmentParameter(r.Path):
 		return nil, "path has a parameter on a dot segment"
-	case listed && hasDoubleEncoding(r.Path):
-		return nil, "path has a double-encoded character"
+	// MUTANT: an escaped "/", ".", "\" or "%" left in the decoded path is no longer refused
+	// under an allow list, so a server that decodes twice reads another path than the prefix held.
 	case !allowOK(k.Allow, r):
 		return nil, "not allowed by rule"
 	case !allowOK(b.Allow, r):
