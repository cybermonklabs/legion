+++ b/packages/envoy/internal/cipher/policy/load.go
@@ -594,7 +594,7 @@
 	}
 	raw, tagged := tags[TagProxy]
 	if !tagged {
-		s.ProfileDigest = scopesDigest(s.Scopes)
+		// MUTANT: a secret by its own name behind no proxy is fingerprinted without its scopes.
 		return "", ""
 	}
 	kind := file.fileRules.Kind(raw)
@@ -609,7 +609,7 @@
 		return ReasonProxyMaxGrant, why
 	}
 	s.Proxy, s.Way = kind.Name, way
