# proxy-alpn-http11-only: the decrypted connection offers http/1.1 alone again, so a client whose
# handshake offers h2 and nothing else - every gRPC client - fails it with "tls: no application
# protocol".
# must fail: TestAClientOfferingOnlyH2IsAnsweredInHTTP2
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/broker/airlockproxy/proxy.go
+++ b/packages/envoy/internal/broker/airlockproxy/proxy.go
@@ -664,7 +664,8 @@
 		// Host against the CONNECT target, and what it forwards goes to that target whatever
 		// the stream named. So the Host check covers every stream, as it covers every
 		// request of an HTTP/1.1 connection.
-		NextProtos: []string{"http/1.1", "h2"},
+		// MUTANT: http/1.1 alone again, so a client offering h2 alone fails its handshake.
+		NextProtos: []string{"http/1.1"},
 		// HTTP/2 over TLS needs 1.2 at least (RFC 9113, section 9.2). It is crypto/tls's own
 		// default for a server, written here so the HTTP/2 this connection speaks never rests
 		// on a default.
