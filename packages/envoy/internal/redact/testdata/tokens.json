{
  "about": "Texts another party wrote and the credentials a request carried, each with what Tokens answers (redact.Tokens in Go, tokens in packages/contracts/src/remote-text.ts). A credential of TokenPiece (8) characters or more is redacted by every run of 8 of its characters wherever it stands; a shorter one only whole, where no letter, digit or '_' stands right before or after it. A negative limit reads the text whole. Every credential here is made up.",
  "rows": [
    {
      "id": "piece",
      "text": "echo=abcdefghij end",
      "limit": -1,
      "tokens": ["abcdefghij"],
      "want": "echo=[redacted] end"
    },
    {
      "id": "piece-cut-short",
      "text": "echo=abcdefgh end",
      "limit": -1,
      "tokens": ["abcdefghij"],
      "want": "echo=[redacted] end"
    },
    {
      "id": "copies-overlapping",
      "text": "abcdefghijabcdefghij",
      "limit": -1,
      "tokens": ["abcdefghij"],
      "want": "[redacted]"
    },
    {
      "id": "short-whole",
      "text": "the user u is not allowed",
      "limit": -1,
      "tokens": ["u"],
      "want": "the user [redacted] is not allowed"
    },
    {
      "id": "short-inside-word",
      "text": "invalid_request",
      "limit": -1,
      "tokens": ["u"],
      "want": "invalid_request"
    },
    {
      "id": "short-after-equals",
      "text": "password=pw91&scope=openid",
      "limit": -1,
      "tokens": ["pw91"],
      "want": "password=[redacted]&scope=openid"
    },
    {
      "id": "short-before-underscore",
      "text": "pw91_x",
      "limit": -1,
      "tokens": ["pw91"],
      "want": "pw91_x"
    },
    {
      "id": "short-between-letters",
      "text": "é u é and éué",
      "limit": -1,
      "tokens": ["u"],
      "want": "é [redacted] é and éué"
    },
    {
      "id": "limit",
      "text": "0123456789",
      "limit": 4,
      "tokens": [],
      "want": "0123"
    },
    {
      "id": "trimmed",
      "text": "echo=abcdefghij",
      "limit": -1,
      "tokens": [" abcdefghij\n"],
      "want": "echo=[redacted]"
    },
    {
      "id": "credential-holds-a-word",
      "text": "no entry lists the Google account box@fleet.iam.gserviceaccount.com",
      "limit": -1,
      "tokens": ["projected.service.account.token"],
      "want": "no entry lists the Google account box@fleet.iam.gservice[redacted]com"
    }
  ]
}
