    {
      "name": "GITHUB_ENTERPRISE_ADMIN",
      "proxy": {
        "hosts": ["api.github.com"],
        "headers": ["Authorization"],
        "allow": [
          {
            "method": "GET",
            "pathPrefix": "/enterprises/example-enterprise/actions/cache/storage-limit"
          },
          {
            "method": "PUT",
            "pathPrefix": "/enterprises/example-enterprise/actions/cache/storage-limit"
          },
          { "method": "GET", "pathPrefix": "/enterprises/example-enterprise/audit-log/stream-key" },
          { "method": "GET", "pathPrefix": "/enterprises/example-enterprise/audit-log/streams" },
          { "method": "POST", "pathPrefix": "/enterprises/example-enterprise/audit-log/streams" }
        ]
      }
    },
