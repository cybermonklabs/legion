{
  "source": "example-org/deployment envoy-cluster/hub.go hubMeasurePublish, hubMeasureSubscribe, once the measurement job's inbox moved under the reply root",
  "publish": [
    "$JS.API.INFO",
    "$JS.API.STREAM.NAMES",
    "$JS.API.STREAM.LIST",
    "$JS.API.STREAM.INFO.*",
    "$JS.API.CONSUMER.NAMES.*",
    "$JS.API.CONSUMER.LIST.*",
    "$JS.API.CONSUMER.INFO.*.*",
    "$JS.API.DIRECT.GET.KV_envoy_listener.$KV.envoy_listener.lease.>",
    "$JS.API.STREAM.CREATE.ENVOY_MEASURE",
    "$JS.API.STREAM.UPDATE.ENVOY_MEASURE",
    "$JS.API.STREAM.DELETE.ENVOY_MEASURE",
    "envoy-measure.>"
  ],
  "subscribe": ["_INBOX_envoy._measure.>"]
}
