{
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "listener",
      "app.kubernetes.io/instance": "envoy-nats",
      "app.kubernetes.io/name": "nats-listener"
    }
  },
  "spec": {
    "containers": [
      {
        "env": [
          {
            "name": "PORT",
            "value": "9020"
          },
          {
            "name": "ENVOY_LISTEN_HOST",
            "value": "0.0.0.0"
          },
          {
            "name": "ENVOY_ALLOWED_HOSTS",
            "value": "envoy-hub.example-tailnet.ts.net"
          },
          {
            "name": "ENVOY_MACHINE_ID",
            "value": "envoy-hub"
          },
          {
            "name": "NATS_URLS",
            "value": "nats://envoy-nats.envoy.svc.cluster.local:4222"
          },
          {
            "name": "ENVOY_ALLOW_REMOTE_NATS",
            "value": "1"
          },
          {
            "name": "NATS_NKEY_SEED_FILE",
            "value": "/var/run/secrets/envoy/nats-seed"
          },
          {
            "name": "ENVOY_API_ALLOW_UNAUTHENTICATED",
            "value": "1"
          }
        ],
        "image": "example.invalid/envoy@sha256:00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
        "lifecycle": {
          "preStop": {
            "exec": {
              "command": [
                "sleep",
                "5"
              ]
            }
          }
        },
        "livenessProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "6",
              "http://127.0.0.1:9020/healthz"
            ]
          },
          "failureThreshold": 6,
          "periodSeconds": 10,
          "timeoutSeconds": 7
        },
        "name": "listener",
        "readinessProbe": {
          "exec": {
            "command": [
              "curl",
              "-fsS",
              "http://127.0.0.1:9020/healthz"
            ]
          },
          "failureThreshold": 2,
          "periodSeconds": 5,
          "timeoutSeconds": 6
        },
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "1Gi"
          },
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "startupProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "6",
              "http://127.0.0.1:9020/healthz"
            ]
          },
          "failureThreshold": 24,
          "periodSeconds": 5,
          "timeoutSeconds": 7
        },
        "volumeMounts": [
          {
            "mountPath": "/var/run/secrets/envoy",
            "name": "nats-seed",
            "readOnly": true
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "securityContext": {
      "runAsGroup": 999,
      "runAsNonRoot": true,
      "runAsUser": 999,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccountName": "envoy-nats-listener",
    "terminationGracePeriodSeconds": 35,
    "volumes": [
      {
        "name": "nats-seed",
        "secret": {
          "items": [
            {
              "key": "seed",
              "path": "nats-seed"
            }
          ],
          "secretName": "envoy-hub-listener-seed"
        }
      }
    ]
  }
}
