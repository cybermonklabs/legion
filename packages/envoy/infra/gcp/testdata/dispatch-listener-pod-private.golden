{
  "metadata": {
    "annotations": {
      "checksum/example-dispatch-listener": "example-dispatch-listener-resource-version",
      "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
    },
    "labels": {
      "app": "example-dispatch-listener"
    }
  },
  "spec": {
    "affinity": {
      "podAntiAffinity": {
        "requiredDuringSchedulingIgnoredDuringExecution": [
          {
            "labelSelector": {
              "matchLabels": {
                "app": "example-dispatch-listener"
              }
            },
            "topologyKey": "kubernetes.io/hostname"
          }
        ]
      }
    },
    "containers": [
      {
        "env": [
          {
            "name": "PORT",
            "value": "9020"
          },
          {
            "name": "ENVOY_LISTEN_HOST",
            "value": "0.0.0.0"
          },
          {
            "name": "ENVOY_MACHINE_ID",
            "value": "example-dispatch"
          },
          {
            "name": "NATS_URLS",
            "value": "nats://example-hub.example-tailnet.ts.net:4222"
          },
          {
            "name": "ENVOY_ALLOW_REMOTE_NATS",
            "value": "1"
          },
          {
            "name": "ENVOY_NATS_SOCKS5_PROXY",
            "value": "example-dispatch-tailnet.dispatch.svc.cluster.local:1055"
          },
          {
            "name": "ENVOY_AGENT_SECRETS_URL",
            "value": "https://example-broker.internal.example"
          },
          {
            "name": "ENVOY_AGENT_SECRETS_ACCOUNT_TOKEN_FILE",
            "value": "/var/run/secrets/envoy-broker/token"
          },
          {
            "name": "ENVOY_PUBLIC_URL",
            "value": "http://example-dispatch-listener.dispatch.svc.cluster.local:9020"
          },
          {
            "name": "NATS_SERVICE_TOKEN_FILE",
            "value": "/var/run/secrets/envoy/nats-token"
          },
          {
            "name": "ENVOY_PROJECT_PRIVACY_URL",
            "value": "https://example-broker.internal.example"
          },
          {
            "name": "ENVOY_PROJECT_PRIVACY_REQUIRED",
            "value": "true"
          },
          {
            "name": "ENVOY_ALL_PROJECTS_ACCOUNTS",
            "value": "system:serviceaccount:dispatch:example-dispatch"
          },
          {
            "name": "ENVOY_API_TOKEN",
            "valueFrom": {
              "secretKeyRef": {
                "key": "ENVOY_API_TOKEN",
                "name": "example-dispatch-listener"
              }
            }
          },
          {
            "name": "ENVOY_OIDC_ISSUER",
            "value": "https://container.googleapis.com/v1/projects/example-project/locations/us-central1/clusters/example-dispatch"
          },
          {
            "name": "ENVOY_OIDC_AUDIENCE",
            "value": "http://example-dispatch-listener.dispatch.svc.cluster.local:9020"
          },
          {
            "name": "ENVOY_OIDC_ACCOUNTS",
            "value": "system:serviceaccount:dispatch:example-dispatch"
          },
          {
            "name": "ENVOY_DISPATCH_PRINCIPAL",
            "value": "system:serviceaccount:dispatch:example-dispatch"
          }
        ],
        "image": "example.invalid/envoy@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "lifecycle": {
          "preStop": {
            "exec": {
              "command": [
                "sleep",
                "5"
              ]
            }
          }
        },
        "livenessProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "8",
              "http://127.0.0.1:9020/livez"
            ]
          },
          "failureThreshold": 3,
          "periodSeconds": 10,
          "timeoutSeconds": 9
        },
        "name": "envoy-listener",
        "readinessProbe": {
          "exec": {
            "command": [
              "curl",
              "-fsS",
              "http://127.0.0.1:9020/healthz"
            ]
          },
          "failureThreshold": 2,
          "periodSeconds": 5,
          "timeoutSeconds": 6
        },
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          },
          "requests": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "startupProbe": {
          "exec": {
            "command": [
              "curl",
              "-sS",
              "-o",
              "/dev/null",
              "--max-time",
              "8",
              "http://127.0.0.1:9020/livez"
            ]
          },
          "failureThreshold": 60,
          "periodSeconds": 5,
          "timeoutSeconds": 9
        },
        "volumeMounts": [
          {
            "mountPath": "/var/run/secrets/envoy",
            "name": "nats-token",
            "readOnly": true
          },
          {
            "mountPath": "/var/run/secrets/envoy-broker",
            "name": "envoy-broker-token",
            "readOnly": true
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "serviceAccountName": "example-dispatch-listener",
    "terminationGracePeriodSeconds": 40,
    "topologySpreadConstraints": [
      {
        "labelSelector": {
          "matchLabels": {
            "app": "example-dispatch-listener"
          }
        },
        "maxSkew": 1,
        "minDomains": 2,
        "topologyKey": "topology.kubernetes.io/zone",
        "whenUnsatisfiable": "DoNotSchedule"
      }
    ],
    "volumes": [
      {
        "name": "nats-token",
        "projected": {
          "sources": [
            {
              "serviceAccountToken": {
                "audience": "example-nats-audience",
                "expirationSeconds": 3600,
                "path": "nats-token"
              }
            }
          ]
        }
      },
      {
        "name": "envoy-broker-token",
        "projected": {
          "sources": [
            {
              "serviceAccountToken": {
                "audience": "example-broker-audience",
                "expirationSeconds": 3600,
                "path": "token"
              }
            }
          ]
        }
      }
    ]
  }
}
