{
  "example-dispatch": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "example-dispatch",
      "namespace": "dispatch"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "example-dispatch"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      }
    }
  },
  "example-dispatch-listener": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "example-dispatch-listener",
      "namespace": "dispatch"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "example-dispatch-listener"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      }
    }
  }
}
