            "provider": "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$pulumi:providers:kubernetes::example-dispatch-kubernetes::example-dispatch-kubernetes-id",
            "supportsResultReporting": true,
            "type": "kubernetes:apps/v1:Deployment",
            "version": "4.34.2"
          },
          "urn": "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$kubernetes:apps/v1:Deployment::example-dispatch-listener"
        },
        {
          "register": {
            "acceptResources": true,
            "acceptSecrets": true,
            "acceptsByteString": true,
            "aliases": [
              {
                "spec": {
                  "noParent": false,
                  "type": "kubernetes:apps/v1beta1:Deployment"
