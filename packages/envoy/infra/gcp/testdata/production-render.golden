_envoy_known_sessions.>\", \"$JS.API.CONSUMER.DELETE.KV_envoy_known_sessions.>\", \"$JS.FC.KV_envoy_known_sessions.>\", \"$JS.API.STREAM.INFO.KV_legion_agents\", \"$JS.API.STREAM.CREATE.KV_legion_agents\", \"$JS.API.STREAM.UPDATE.KV_legion_agents\", \"$JS.API.DIRECT.GET.KV_legion_agents.>\", \"$JS.API.STREAM.MSG.GET.KV_legion_agents\", \"$KV.legion_agents.>\", \"$JS.API.CONSUMER.CREATE.KV_legion_agents.>\", \"$JS.API.CONSUMER.DELETE.KV_legion_agents.>\", \"$JS.FC.KV_legion_agents.>\", \"$JS.API.STREAM.INFO.KV_envoy_ci_state\", \"$JS.API.STREAM.CREATE.KV_envoy_ci_state\", \"$JS.API.STREAM.UPDATE.KV_envoy_ci_state\", \"$JS.API.DIRECT.GET.KV_envoy_ci_state.>\", \"$JS.API.STREAM.MSG.GET.KV_envoy_ci_state\", \"$KV.envoy_ci_state.>\", \"$JS.API.CONSUMER.CREATE.KV_envoy_ci_state.>\", \"$JS.API.CONSUMER.DELETE.KV_envoy_ci_state.>\", \"$JS.FC.KV_envoy_ci_state.>\", \"$JS.API.STREAM.INFO.KV_envoy_dpop_proofs\", \"$JS.API.STREAM.CREATE.KV_envoy_dpop_proofs\", \"$JS.API.STREAM.UPDATE.KV_envoy_dpop_proofs\", \"$JS.API.DIRECT.GET.KV_envoy_dpop_proofs.>\", \"$JS.API.STREAM.MSG.GET.KV_envoy_dpop_proofs\", \"$KV.envoy_dpop_proofs.>\", \"$JS.API.CONSUMER.CREATE.KV_envoy_dpop_proofs.>\", \"$JS.API.CONSUMER.DELETE.KV_envoy_dpop_proofs.>\", \"$JS.FC.KV_envoy_dpop_proofs.>\", \"$JS.API.STREAM.PURGE.KV_envoy_interests\", \"$JS.API.STREAM.PURGE.KV_envoy_known_sessions\", \"$JS.API.CONSUMER.CREATE.ENVOY_NOTIFICATIONS.*\", \"$JS.API.CONSUMER.CREATE.ENVOY_NOTIFICATIONS.*.>\", \"$JS.API.CONSUMER.INFO.ENVOY_NOTIFICATIONS.*\", \"$JS.API.CONSUMER.DELETE.ENVOY_NOTIFICATIONS.*\", \"$JS.API.CONSUMER.MSG.NEXT.ENVOY_NOTIFICATIONS.*\", \"$JS.API.CONSUMER.LIST.ENVOY_NOTIFICATIONS\", \"$JS.ACK.ENVOY_NOTIFICATIONS.*.>\", \"$JS.API.STREAM.INFO.KV_legion_tasks\", \"$JS.API.DIRECT.GET.KV_legion_tasks.>\", \"$JS.API.STREAM.MSG.GET.KV_legion_tasks\", \"$JS.API.CONSUMER.CREATE.KV_legion_tasks.>\", \"$JS.API.CONSUMER.DELETE.KV_legion_tasks.>\", \"$JS.FC.KV_legion_tasks.>\"]}, \"subscribe\": {\"allow\": [\"_INBOX.>\", \"notifications.role.> envoy-listener-example-hub\", \"notifications.role.> envoy-roles\"]}}}",
                    "          # example-members",
                    "          {\"nkey\": \"UCNPQVMRWOOJWCD7XDVLH6MEOVFBMTV4LAQSKZYROSETYJVFAWDMNKVA\", \"permissions\": {\"publish\": {\"allow\": [\"_INBOX.>\", \"agentstream.*.frames\"]}, \"subscribe\": {\"allow\": [\"notifications.envoy.deliver.*\", \"agentstream.*.control\"]}}}",
                    "        ]",
                    "      }",
                    "      # example-members: a client presenting no credential becomes this user",
                    "      no_auth_user: \"UCNPQVMRWOOJWCD7XDVLH6MEOVFBMTV4LAQSKZYROSETYJVFAWDMNKVA\"",
                    "  - path: /etc/envoy/fetch-secret",
                    "    permissions: \"0755\"",
                    "    content: |",
                    "      #!/bin/sh",
                    "      # fetch-secret OUT SECRET writes the latest version of the Secret Manager secret SECRET, in this",
                    "      # VM's project, to the file OUT, readable by root alone. It authenticates as the VM's service",
                    "      # account, with a token from the metadata server, and tries six times, ten seconds apart: a new",
                    "      # grant on the secret can take a while to reach Secret Manager.",
                    "      # GCE_METADATA_HOST and SECRET_MANAGER_ENDPOINT replace the metadata server's host and Secret",
                    "      # Manager's base URL. Nothing of the value or the token is printed or passed in a command's",
                    "      # arguments.",
                    "      set -u",
                    "      out=$1",
                    "      secret=$2",
                    "      metadata=http://${GCE_METADATA_HOST:-metadata.google.internal}/computeMetadata/v1",
                    "      endpoint=${SECRET_MANAGER_ENDPOINT:-https://secretmanager.googleapis.com}",
                    "",
                    "      fetch() {",
                    "        project=$(curl -fsS --max-time 30 -H 'Metadata-Flavor: Google' \"$metadata/project/project-id\") || return 1",
                    "        token=$(curl -fsS --max-time 30 -H 'Metadata-Flavor: Google' \"$metadata/instance/service-accounts/default/token\") || return 1",
                    "        token=$(printf '%s' \"$token\" | jq -er .access_token) || return 1",
                    "        response=$(printf 'header = \"Authorization: Bearer %s\"\\n' \"$token\" |",
                    "          curl -fsS --max-time 30 --config - \"$endpoint/v1/projects/$project/secrets/$secret/versions/latest:access\") || return 1",
                    "        data=$(printf '%s' \"$response\" | jq -er .payload.data) || return 1",
                    "        tmp=$(mktemp \"$out.XXXXXX\") || return 1",
                    "        if printf '%s' \"$data\" | base64 -d >\"$tmp\" && [ -s \"$tmp\" ] && mv -f \"$tmp\" \"$out\"; then",
                    "          return 0",
                    "        fi",
                    "        rm -f \"$tmp\"",
                    "        echo \"fetch-secret: the latest version of $secret is empty\" >&2",
                    "        return 1",
                    "      }",
                    "",
                    "      attempt=1",
                    "      until fetch; do",
                    "        if [ \"$attempt\" -ge 6 ]; then",
                    "          echo \"fetch-secret: nothing fetched from $secret after $attempt attempts\" >&2",
                    "          exit 1",
                    "        fi",
                    "        attempt=$((attempt + 1))",
                    "        sleep 10",
                    "      done",
                    "  - path: /etc/envoy/tailnet-joined",
                    "    permissions: \"0755\"",
                    "    content: |",
                    "      #!/bin/sh",
                    "      # tailnet-joined MARKER KEY_FILE",
                    "      set -u",
                    "      marker=$1",
                    "      key=$2",
                    "      command -v jq >/dev/null 2>&1 ||",
                    "        { echo 'tailnet-joined: no jq on this machine, so the node status cannot be read' >&2; exit 1; }",
                    "      until docker exec tailscaled tailscale --socket=/tmp/tailscaled.sock status --json 2>/dev/null |",
                    "        jq -es 'length == 1 and .[0].BackendState == \"Running\"' >/dev/null 2>&1; do",
                    "        sleep 5",
                    "      done",
                    "      : >\"$key\" && touch \"$marker\"",
                    "  - path: /etc/envoy/listener-seed-env",
                    "    permissions: \"0755\"",
                    "    content: |",
                    "      #!/bin/sh",
                    "      # listener-seed-env ENV_FILE SECRET writes the latest version of the Secret Manager secret SECRET,",
                    "      # an nkey seed, to ENV_FILE as the one line NATS_NKEY_SEED=<seed>, readable by root alone. It",
                    "      # fetches with the fetch-secret beside it, and so retries as that does. Nothing of the seed is",
                    "      # printed or passed in a command's arguments.",
                    "      set -u",
                    "      env_file=$1",
                    "      secret=$2",
                    "      raw=$(mktemp \"$env_file.raw.XXXXXX\") || exit 1",
                    "      trap 'rm -f \"$raw\"' EXIT",
                    "      trap 'rm -f \"$raw\"; exit 1' INT TERM",
                    "      \"$(dirname \"$0\")/fetch-secret\" \"$raw\" \"$secret\" || exit 1",
                    "      seed=$(cat \"$raw\") || exit 1",
                    "      case $seed in",
                    "      *'",
                    "      '*)",
                    "        echo \"listener-seed-env: the latest version of $secret holds more than one line\" >&2",
                    "        exit 1",
                    "        ;;",
                    "      esac",
                    "      tmp=$(mktemp \"$env_file.XXXXXX\") || exit 1",
                    "      if printf 'NATS_NKEY_SEED=%s\\n' \"$seed\" >\"$tmp\" && mv -f \"$tmp\" \"$env_file\"; then",
                    "        exit 0",
                    "      fi",
                    "      rm -f \"$tmp\"",
                    "      exit 1",
                    "  - path: /etc/tailscale-serve/serve.json",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      {\"TCP\":{\"9020\":{\"TCPForward\":\"127.0.0.1:9020\"}}}",
                    "  - path: /etc/systemd/system/fetch-tailnet-key.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=Fetch the tailnet auth key from Secret Manager",
                    "      Wants=network-online.target",
                    "      After=network-online.target",
                    "      ConditionPathExists=!/mnt/disks/data/tailnet-joined",
                    "      RequiresMountsFor=/mnt/disks/data",
                    "      AssertPathIsMountPoint=/mnt/disks/data",
                    "",
                    "      [Service]",
                    "      Type=oneshot",
                    "      RemainAfterExit=yes",
                    "      ExecStart=/etc/envoy/fetch-secret /run/envoy/tailnet-auth-key example-hub-tailnet-auth-key",
                    "  - path: /etc/systemd/system/tailscaled.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=Tailscale, which joins this hub to the tailnet",
                    "      Requires=docker.service",
                    "      Wants=network-online.target fetch-tailnet-key.service",
                    "      After=docker.service network-online.target fetch-tailnet-key.service",
                    "      RequiresMountsFor=/mnt/disks/data",
                    "      AssertPathIsMountPoint=/mnt/disks/data",
                    "",
                    "      [Service]",
                    "      ExecStart=/usr/bin/docker run --rm --name tailscaled --network host --cap-add NET_ADMIN --device /dev/net/tun -v /mnt/disks/data/tailscale:/var/lib/tailscale -v /run/envoy/tailnet-auth-key:/run/envoy/tailnet-auth-key:ro -v /etc/tailscale-serve:/etc/tailscale-serve:ro -e TS_SERVE_CONFIG=/etc/tailscale-serve/serve.json -e TS_AUTHKEY=file:/run/envoy/tailnet-auth-key -e TS_AUTH_ONCE=true -e TS_STATE_DIR=/var/lib/tailscale -e TS_USERSPACE=false -e TS_HOSTNAME=example-hub -e TS_EXTRA_ARGS=--advertise-tags=tag:example-hub example.invalid/tailscale:v1.0.0@sha256:2222222222222222222222222222222222222222222222222222222222222222",
                    "      Restart=always",
                    "      RestartSec=10",
                    "  - path: /etc/systemd/system/tailnet-joined.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=Mark this hub joined to the tailnet once Tailscale runs, and drop the tailnet auth key",
                    "      After=tailscaled.service",
                    "      ConditionPathExists=!/mnt/disks/data/tailnet-joined",
                    "      RequiresMountsFor=/mnt/disks/data",
                    "      AssertPathIsMountPoint=/mnt/disks/data",
                    "",
                    "      [Service]",
                    "      Type=simple",
                    "      RemainAfterExit=yes",
                    "      ExecStart=/etc/envoy/tailnet-joined /mnt/disks/data/tailnet-joined /run/envoy/tailnet-auth-key",
                    "      Restart=on-failure",
                    "      RestartSec=10",
                    "  - path: /etc/systemd/system/nats-firewall.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=Open the host firewall to Google's health checks on NATS's monitoring port, and to the tailnet on its client port",
                    "",
                    "      [Service]",
                    "      Type=oneshot",
                    "      RemainAfterExit=yes",
                    "      ExecStart=/bin/sh -c '/sbin/iptables -w -C INPUT -p tcp -s 130.211.0.0/22,35.191.0.0/16 --dport 8222 -j ACCEPT || /sbin/iptables -w -A INPUT -p tcp -s 130.211.0.0/22,35.191.0.0/16 --dport 8222 -j ACCEPT'",
                    "      ExecStart=/bin/sh -c '/sbin/iptables -w -C INPUT -i tailscale0 -p tcp --dport 4222 -j ACCEPT || /sbin/iptables -w -A INPUT -i tailscale0 -p tcp --dport 4222 -j ACCEPT'",
                    "  - path: /etc/systemd/system/nats.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=NATS with JetStream",
                    "      Requires=docker.service",
                    "      Wants=network-online.target nats-firewall.service",
                    "      After=docker.service network-online.target nats-firewall.service",
                    "      RequiresMountsFor=/mnt/disks/data",
                    "      AssertPathIsMountPoint=/mnt/disks/data",
                    "",
                    "      [Service]",
                    "      ExecStart=/usr/bin/docker run --rm --name nats --network host -v /mnt/disks/data/nats:/data -v /etc/nats/nats-server.conf:/etc/nats/nats-server.conf:ro example.invalid/nats:2.0.0-alpine@sha256:5555555555555555555555555555555555555555555555555555555555555555 -c /etc/nats/nats-server.conf -js --store_dir /data -m 8222 --server_name example-hub",
                    "      ExecStop=/usr/bin/docker stop -t 30 nats",
                    "      Restart=always",
                    "      RestartSec=10",
                    "  - path: /etc/systemd/system/envoy-listener.service",
                    "    permissions: \"0644\"",
                    "    content: |",
                    "      [Unit]",
                    "      Description=Envoy's listener, which the tailnet reaches through Tailscale Serve",
                    "      Requires=docker.service",
                    "      Wants=network-online.target nats.service",
                    "      After=docker.service network-online.target nats.service",
                    "      RequiresMountsFor=/mnt/disks/data",
                    "      AssertPathIsMountPoint=/mnt/disks/data",
                    "",
                    "      [Service]",
                    "      ExecStart=/usr/bin/docker run --rm --name envoy-listener --network host --env-file /run/envoy/listener.env -e PORT=9020 -e ENVOY_LISTEN_HOST=127.0.0.1 -e ENVOY_ALLOWED_HOSTS=example-hub.example-tailnet.ts.net -e ENVOY_MACHINE_ID=example-hub -e NATS_URLS=nats://127.0.0.1:4222 example.invalid/envoy@sha256:8888888888888888888888888888888888888888888888888888888888888888",
                    "      ExecStartPre=/etc/envoy/listener-seed-env /run/envoy/listener.env example-nats-seed-example-hub",
                    "      TimeoutStartSec=600",
                    "      ExecStop=/usr/bin/docker stop -t 30 envoy-listener",
                    "      Restart=always",
                    "      RestartSec=10",
                    "runcmd:",
                    "  - systemctl daemon-reload",
                    "  - systemctl start fetch-tailnet-key.service",
                    "  - systemctl start tailscaled.service",
                    "  - systemctl start tailnet-joined.service",
                    "  - systemctl start nats-firewall.service",
                    "  - systemctl start nats.service",
                    "  - systemctl start envoy-listener.service",
                    ""
                  ]
                }
              },
              "namePrefix": "example-hub-",
              "networkInterfaces": [
                {
                  "accessConfigs": [
                    {}
