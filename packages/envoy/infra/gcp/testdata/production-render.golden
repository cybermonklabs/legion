            "parent": "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch::example-dispatch",
            "propertyDependencies": {
              "apiVersion": {},
              "kind": {},
              "metadata": {},
              "spec": {
                "urns": [
                  "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$gcp:container/cluster:Cluster::example-dispatch",
