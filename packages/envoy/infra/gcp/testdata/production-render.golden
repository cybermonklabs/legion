                            "value": "http://example-dispatch-listener.example-dispatch.svc.cluster.local:9020"
                          },
                          {
                            "name": "ENVOY_OIDC_ACCOUNTS",
                            "value": "system:serviceaccount:example-dispatch:example-dispatch"
                          },
                          {
                            "name": "ENVOY_DISPATCH_PRINCIPAL",
                            "value": "system:serviceaccount:example-dispatch:example-dispatch"
                          }
                        ],
                        "image": "example.invalid/envoy@sha256:1111111111111111111111111111111111111111111111111111111111111111",
                        "lifecycle": {
                          "preStop": {
                            "exec": {
                              "command": [
                                "sleep",
                                "5"
                              ]
                            }
                          }
                        },
                        "livenessProbe": {
                          "exec": {
                            "command": [
                              "curl",
                              "-sS",
                              "-o",
                              "/dev/null",
                              "--max-time",
                              "8",
                              "http://127.0.0.1:9020/livez"
                            ]
                          },
                          "failureThreshold": 3,
                          "periodSeconds": 10,
                          "timeoutSeconds": 9
                        },
                        "name": "envoy-listener",
                        "readinessProbe": {
                          "exec": {
                            "command": [
                              "curl",
                              "-fsS",
                              "http://127.0.0.1:9020/healthz"
                            ]
                          },
                          "failureThreshold": 2,
                          "periodSeconds": 5,
                          "timeoutSeconds": 6
                        },
                        "resources": {
                          "limits": {
                            "cpu": "500m",
                            "memory": "512Mi"
                          },
                          "requests": {
                            "cpu": "500m",
                            "memory": "512Mi"
                          }
                        },
                        "startupProbe": {
                          "exec": {
                            "command": [
                              "curl",
                              "-sS",
                              "-o",
                              "/dev/null",
                              "--max-time",
                              "8",
                              "http://127.0.0.1:9020/livez"
                            ]
                          },
                          "failureThreshold": 60,
                          "periodSeconds": 5,
                          "timeoutSeconds": 9
                        },
                        "volumeMounts": [
                          {
                            "mountPath": "/var/run/secrets/envoy",
                            "name": "nats-seed",
                            "readOnly": true
                          }
                        ]
                      }
                    ],
                    "enableServiceLinks": false,
                    "priorityClassName": "example-shared-infra",
                    "serviceAccountName": "example-dispatch-listener",
                    "terminationGracePeriodSeconds": 40,
                    "topologySpreadConstraints": [
                      {
                        "labelSelector": {
                          "matchLabels": {
                            "app": "example-dispatch-listener"
                          }
                        },
                        "maxSkew": 1,
                        "minDomains": 2,
                        "topologyKey": "topology.kubernetes.io/zone",
                        "whenUnsatisfiable": "DoNotSchedule"
                      }
