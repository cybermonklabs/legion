              },
              {
                "spec": {
                  "noParent": false,
                  "type": "kubernetes:apps/v1beta2:Deployment"
                }
              },
              {
                "spec": {
                  "noParent": false,
                  "type": "kubernetes:extensions/v1beta1:Deployment"
                }
              }
            ],
            "custom": true,
            "customTimeouts": {},
            "dependencies": [
              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$gcp:container/cluster:Cluster::example-dispatch",
              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$gcp:sql/databaseInstance:DatabaseInstance::example-dispatch",
              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$kubernetes:core/v1:ConfigMap::example-dispatch-serve",
