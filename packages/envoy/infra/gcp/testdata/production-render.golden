                            "value": "3"
                          },
                          {
                            "name": "ENVOY_STREAM_MAX_BYTES",
                            "value": "42949672960"
                          },
                          {
                            "name": "NATS_NKEY_SEED_FILE",
                            "value": "/var/run/secrets/envoy/nats-seed"
                          },
                          {
                            "name": "ENVOY_API_ALLOW_UNAUTHENTICATED",
                            "value": "1"
                          }
                        ],
                        "image": "example.invalid/envoy@sha256:8888888888888888888888888888888888888888888888888888888888888888",
                        "lifecycle": {
