              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$kubernetes:core/v1:Secret::example-dispatch-tailnet-tls",
              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$kubernetes:scheduling.k8s.io/v1:PriorityClass::example-dispatch-priority-class",
              "urn:pulumi:stack::project::envoy-infra:gcp:Dispatch$tailscale:index/service:Service::example-dispatch"
            ],
            "name": "example-dispatch-tailnet",
            "object": {
              "apiVersion": "apps/v1",
              "kind": "Deployment",
              "metadata": {
                "name": "example-dispatch-tailnet",
                "namespace": "example-dispatch"
              },
              "spec": {
                "replicas": 2,
                "selector": {
                  "matchLabels": {
                    "app": "example-dispatch-tailnet"
                  }
                },
                "strategy": {
                  "rollingUpdate": {
                    "maxSurge": 1,
                    "maxUnavailable": 0
                  },
                  "type": "RollingUpdate"
                },
                "template": {
                  "metadata": {
                    "annotations": {
                      "checksum/example-dispatch-tailnet-auth-key": "example-dispatch-tailnet-auth-key-resource-version"
                    },
                    "labels": {
                      "app": "example-dispatch-tailnet"
                    }
                  },
                  "spec": {
                    "affinity": {
                      "podAntiAffinity": {
                        "requiredDuringSchedulingIgnoredDuringExecution": [
                          {
                            "labelSelector": {
                              "matchLabels": {
                                "app": "example-dispatch-tailnet"
                              }
                            },
                            "topologyKey": "kubernetes.io/hostname"
                          }
                        ]
                      }
                    },
                    "automountServiceAccountToken": false,
                    "containers": [
                      {
                        "env": [
                          {
                            "name": "TS_AUTHKEY",
                            "valueFrom": {
                              "secretKeyRef": {
                                "key": "TS_AUTHKEY",
                                "name": "example-dispatch-tailnet-auth-key"
                              }
                            }
                          },
                          {
                            "name": "TS_AUTH_ONCE",
                            "value": "true"
                          },
                          {
                            "name": "TS_USERSPACE",
                            "value": "true"
                          },
                          {
                            "name": "TS_STATE_DIR",
                            "value": "/var/lib/frontdoor/tailscale"
                          },
                          {
                            "name": "TS_LOGS_DIR",
                            "value": "/var/lib/frontdoor/tailscale"
                          },
                          {
                            "name": "TS_KUBE_SECRET",
                            "value": ""
                          },
                          {
                            "name": "TS_ACCEPT_DNS",
                            "value": "false"
                          },
                          {
                            "name": "TS_HOSTNAME",
                            "valueFrom": {
                              "fieldRef": {
                                "fieldPath": "metadata.name"
                              }
                            }
                          },
                          {
                            "name": "TS_EXTRA_ARGS",
                            "value": "--advertise-tags=tag:example-dispatch,tag:example-dispatch-front-door"
                          },
                          {
                            "name": "TS_SERVE_CONFIG",
                            "value": "/etc/tailscale/serve.json"
                          },
                          {
                            "name": "TS_EXPERIMENTAL_SERVICE_AUTO_ADVERTISEMENT",
                            "value": "false"
                          },
                          {
                            "name": "TS_ENABLE_HEALTH_CHECK",
                            "value": "true"
                          },
                          {
                            "name": "TS_LOCAL_ADDR_PORT",
                            "value": "127.0.0.1:9002"
                          },
                          {
                            "name": "TS_SOCKET",
                            "value": "/var/lib/frontdoor/tailscaled.sock"
                          }
                        ],
                        "image": "example.invalid/tailscale:v1.0.0@sha256:2222222222222222222222222222222222222222222222222222222222222222",
                        "lifecycle": {
                          "preStop": {
                            "exec": {
                              "command": [
                                "/bin/sh",
                                "-c",
                                {
                                  "$lines": [
                                    "read -r id _ 2>/dev/null </var/lib/frontdoor/node-id && printf '%s %s\\n' \"$id\" \"$(date -u +%s)\" >/var/lib/frontdoor/draining.tmp && mv /var/lib/frontdoor/draining.tmp /var/lib/frontdoor/draining; rm -f /var/lib/frontdoor/service-ready",
                                    "timeout 5 tailscale --socket=/var/lib/frontdoor/tailscaled.sock serve drain svc:example-dispatch",
                                    "sleep 20",
                                    "timeout 5 tailscale --socket=/var/lib/frontdoor/tailscaled.sock logout",
                                    ""
                                  ]
                                }
                              ]
                            }
                          }
                        },
                        "livenessProbe": {
                          "exec": {
                            "command": [
                              "tailscale",
                              "--socket=/var/lib/frontdoor/tailscaled.sock",
                              "version",
                              "--daemon"
                            ]
                          },
                          "failureThreshold": 6,
                          "periodSeconds": 10,
                          "timeoutSeconds": 5
                        },
                        "name": "tailscale",
                        "readinessProbe": {
                          "exec": {
                            "command": [
                              "/bin/sh",
                              "-c",
                              "test -e /var/lib/frontdoor/service-ready"
                            ]
                          },
                          "failureThreshold": 1,
                          "periodSeconds": 5
                        },
                        "resources": {
                          "limits": {
                            "cpu": "500m",
                            "memory": "512Mi"
                          },
                          "requests": {
                            "cpu": "500m",
                            "memory": "512Mi"
                          }
                        },
                        "securityContext": {
                          "allowPrivilegeEscalation": false,
                          "capabilities": {
                            "drop": [
                              "ALL"
                            ]
                          }
                        },
                        "startupProbe": {
                          "exec": {
                            "command": [
                              "wget",
                              "-qO-",
                              "http://127.0.0.1:9002/healthz"
                            ]
                          },
                          "failureThreshold": 36,
                          "periodSeconds": 5
                        },
                        "volumeMounts": [
                          {
                            "mountPath": "/etc/tailscale",
                            "name": "serve"
                          },
                          {
                            "mountPath": "/var/lib/frontdoor",
                            "name": "state"
                          }
                        ]
                      },
                      {
                        "args": [
                          {
                            "$lines": [
                              "state=/var/lib/frontdoor/tailscale",
                              "cache=/var/lib/frontdoor/tailscale/certs",
                              "secret=/etc/frontdoor-tls",
                              "fqdn=example-dispatch.example-tailnet.ts.net",
                              "tokens=/var/run/secrets/kubernetes.io/serviceaccount",
                              "url=https://kubernetes.default.svc/api/v1/namespaces/example-dispatch/secrets/example-dispatch-tailnet-tls",
                              "flag_file=/var/lib/frontdoor/advertise-service",
                              "node_file=/var/lib/frontdoor/node-id",
                              "claims_max=3",
                              "window=604800",
                              "not_due=2678400",
                              "keep=2592000",
                              "claims_key=legion.dev/certificate-claims",
                              "nodes_key=legion.dev/front-door-nodes",
                              "set -u",
                              "copycert() {",
                              "  cp \"$secret/tls.crt\" \"$cache/$fqdn.crt.tmp\" && cp \"$secret/tls.key\" \"$cache/$fqdn.key.tmp\" &&",
                              "    chmod 0644 \"$cache/$fqdn.crt.tmp\" && chmod 0600 \"$cache/$fqdn.key.tmp\" &&",
                              "    mv \"$cache/$fqdn.key.tmp\" \"$cache/$fqdn.key\" && mv \"$cache/$fqdn.crt.tmp\" \"$cache/$fqdn.crt\"",
                              "}",
                              "kube() {",
                              "  curl -sS -f --cacert \"$tokens/ca.crt\" -H @/dev/fd/3 \"$@\" 3<<EOF",
                              "Authorization: Bearer $(cat \"$tokens/token\")",
                              "EOF",
                              "}",
                              "# notafter prints a PEM certificate's notAfter as seconds since the epoch, and fails, printing",
                              "# nothing, unless its subjectAltName names $fqdn exactly.",
                              "notafter() {",
                              "  openssl x509 -noout -ext subjectAltName -in \"$1\" 2>/dev/null |",
                              "    tr ',' '\\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -Fqx \"DNS:$fqdn\" || return 1",
                              "  enddate=$(openssl x509 -noout -enddate -in \"$1\" 2>/dev/null) || return 1",
                              "  date -u -d \"${enddate#notAfter=}\" +%s 2>/dev/null",
                              "}",
                              "at() { date -u +%Y-%m-%dT%H:%M:%SZ; }",
                              "log() { echo \"$(at) $1 $2 | $3 | $4\"; }",
                              "# left prints the seconds until a PEM certificate's notAfter, and fails unless its",
                              "# subjectAltName names $fqdn exactly.",
                              "left() {",
                              "  end=$(notafter \"$1\") || return 1",
                              "  echo $((end - $(date -u +%s)))",
                              "}",
                              "# annotation prints the value of the Secret's annotation $1 as the pass read it, or nothing. The",
                              "# key's dots are escaped, so only the key itself, quoted, matches.",
                              "annotation() {",
                              "  k=$(printf '%s' \"$1\" | sed 's/\\./\\\\./g')",
                              "  printf '%s' \"$body\" | sed -n \"s|.*\\\"$k\\\": *\\\"\\([^\\\"]*\\)\\\".*|\\1|p\"",
                              "}",
                              "# entry succeeds when $1 is a ledger entry this gate writes: an epoch of 1 to 12 digits with no",
                              "# leading zero (the shell reads a leading zero as octal and fails on 8 or 9, and a longer number",
                              "# overflows its arithmetic, either of which would end this loop), then \"/\" and characters a pod",
                              "# name or node id holds. Anything else, a hand edit or a value an escaped quote cut short, is",
                              "# skipped and so dropped at the next write, rather than carried into the merge patch's JSON.",
                              "entry() {",
                              "  t=${1%%/*}",
                              "  case \"$t\" in ''|0*|*[!0-9]*|?????????????*) return 1 ;; esac",
                              "  case \"${1#*/}\" in ''|*[!A-Za-z0-9./-]*) return 1 ;; esac",
                              "  case \"$1\" in */*) return 0 ;; esac",
                              "  return 1",
                              "}",
                              "# patch writes the annotations $1 (JSON members) on the Secret, with the resourceVersion the pass",
                              "# read as the precondition, so a write after another pod's fails with 409 and writes nothing.",
                              "patch() {",
                              "  kube -X PATCH \"$url\" -H 'Content-Type: application/merge-patch+json' \\",
                              "    --data-binary \"{\\\"metadata\\\":{\\\"resourceVersion\\\":\\\"$rv\\\",\\\"annotations\\\":{$1}}}\" >/dev/null 2>&1",
                              "}",
                              "gate() {",
                              "  me=${HOSTNAME:-$(hostname)}",
                              "  if [ ! -s \"$node_file\" ]; then",
                              "    log happened \"certificate budget\" \"cat $node_file\" \"this pod's node id is not read yet: not advertising; again in 30s\"",
                              "    return 1",
                              "  fi",
                              "  id=$(cat \"$node_file\")",
                              "  # A StableNodeID is alphanumeric; anything else would be written into the merge patch below",
                              "  # unescaped, so it is not recorded at all.",
                              "  case \"$id\" in ''|*[!A-Za-z0-9]*)",
                              "    log happened \"certificate budget\" \"cat $node_file\" \"the node id is not alphanumeric: not recording it, not advertising; again in 30s\"",
                              "    return 1 ;;",
                              "  esac",
                              "  cached=$cache/$fqdn.crt",
                              "  why=",
                              "  # A flag holds the node id it was set for, then why. A pod advertising already takes no claim",
                              "  # and copies nothing: the registry is read, and this pod's entry under its current node id",
                              "  # written again when it is missing.",
                              "  flagged=",
                              "  if [ -e \"$flag_file\" ]; then",
                              "    read -r flagged prev <\"$flag_file\" || :",
                              "    why=${prev:-flag set}",
                              "  elif l=$(left \"$cached\") && [ \"$l\" -gt \"$not_due\" ]; then",
                              "    why=\"cached certificate, ${l}s left\"",
                              "    log happened \"certificate budget\" \"openssl x509 -enddate -in $cached\" \"the cache holds the certificate with ${l}s left: advertise, no claim\"",
                              "  elif l=$(left \"$secret/tls.crt\") && [ \"$l\" -gt \"$not_due\" ] && [ -s \"$secret/tls.key\" ]; then",
                              "    copycert || return 1",
                              "    if [ ! -s \"$cache/acme-account.key.pem\" ] && [ -s \"$secret/acme-account.key.pem\" ]; then",
                              "      cp \"$secret/acme-account.key.pem\" \"$cache/acme-account.key.pem\" && chmod 0600 \"$cache/acme-account.key.pem\"",
                              "    fi",
                              "    why=\"published certificate, ${l}s left\"",
                              "    log happened \"certificate budget\" \"openssl x509 -enddate -in $secret/tls.crt\" \"the Secret holds the certificate with ${l}s left: copied into the cache, advertise, no claim\"",
                              "  fi",
                              "  if ! body=$(kube -H 'Accept: application/json;as=PartialObjectMetadata;g=meta.k8s.io;v=v1' \"$url\" 2>/dev/null); then",
                              "    log happened \"certificate budget\" \"GET $url\" \"the claim ledger could not be read: not advertising; again in 30s\"",
                              "    return 1",
                              "  fi",
                              "  body=$(printf '%s' \"$body\" | tr -d '\\n')",
                              "  rv=$(printf '%s' \"$body\" | sed -n 's/.*\"resourceVersion\": *\"\\([0-9]*\\)\".*/\\1/p')",
                              "  claims=$(annotation \"$claims_key\")",
                              "  nodes=$(annotation \"$nodes_key\")",
                              "  now=$(date -u +%s)",
                              "  if [ -z \"$rv\" ]; then",
                              "    log happened \"certificate budget\" \"GET $url\" \"no resourceVersion read: not advertising; again in 30s\"",
                              "    return 1",
                              "  fi",
                              "  # The registry carried forward: every entry younger than the keep window but this pod's entry",
                              "  # for its current node id, then that one, fresh. This pod's entries for older node ids stay, so",
                              "  # a node it was before a re-registration is still named as the front door's.",
                              "  reg=",
                              "  for e in $nodes; do",
                              "    entry \"$e\" || continue",
                              "    t=${e%%/*}",
                              "    rest=${e#*/}",
                              "    [ $((now - t)) -lt \"$keep\" ] || continue",
                              "    [ \"$rest\" = \"$me/$id\" ] && continue",
                              "    reg=\"$reg $e\"",
                              "  done",
                              "  reg=\"${reg# } $now/$me/$id\"",
                              "  reg=${reg# }",
                              "  live=",
                              "  count=0",
                              "  mine=",
                              "  for c in $claims; do",
                              "    entry \"$c\" || continue",
                              "    t=${c%%/*}",
                              "    [ $((now - t)) -lt \"$window\" ] || continue",
                              "    live=\"$live $c\"",
                              "    count=$((count + 1))",
                              "    [ \"${c#*/}\" = \"$me\" ] && mine=$c",
                              "  done",
                              "  live=${live# }",
                              "  newclaims=$live",
                              "  if [ -e \"$flag_file\" ]; then",
                              "    case \" $nodes \" in *\"/$me/$id \"*) return 0 ;; esac",
                              "    log happened \"certificate budget\" \"GET $url\" \"this pod advertises (its flag names node ${flagged:-none}), and the registry lacks $me/$id: recording it again\"",
                              "  fi",
                              "  if [ -z \"$why\" ]; then",
                              "    log happened \"certificate budget\" \"GET $url\" \"claims in the last ${window}s: $count of $claims_max:${live:- none}\"",
                              "    if [ -n \"$mine\" ]; then",
                              "      why=\"claim $mine\"",
                              "      log happened \"certificate budget\" \"GET $url\" \"this pod holds claim $mine: advertise\"",
                              "    elif [ \"$count\" -ge \"$claims_max\" ]; then",
                              "      log happened \"certificate budget\" \"GET $url\" \"no claim left: not advertising, so this pod orders no certificate for $fqdn; again in 30s\"",
                              "      return 1",
                              "    else",
                              "      newclaims=\"${live:+$live }$now/$me\"",
                              "      why=\"claim $now/$me\"",
                              "    fi",
                              "  fi",
                              "  log asked \"certificate budget\" \"PATCH $url (resourceVersion $rv)\" \"$why; node $me=$id\"",
                              "  if patch \"\\\"$claims_key\\\":\\\"$newclaims\\\",\\\"$nodes_key\\\":\\\"$reg\\\"\"; then",
                              "    echo \"$id $why\" >\"$flag_file\"",
                              "    case \"$why\" in",
                              "      \"claim $now/$me\") log happened \"certificate budget\" \"PATCH $url\" \"claim $now/$me taken, node $id recorded: advertise\" ;;",
                              "      *) log happened \"certificate budget\" \"PATCH $url\" \"node $id recorded: advertise ($why)\" ;;",
                              "    esac",
                              "    return 0",
                              "  fi",
                              "  log happened \"certificate budget\" \"PATCH $url\" \"the write was refused (another pod's write, or the API): again in 30s\"",
                              "  return 1",
                              "}",
                              "crt=$cache/$fqdn.crt",
                              "key=$cache/$fqdn.key",
                              "account=$cache/acme-account.key.pem",
                              "waiting=",
                              "# unreadable ends the container, naming what it cannot read.",
                              "unreadable() {",
                              "  echo \"$1 is not readable by uid $(id -u): this container's identity cannot read tailscaled's certificate cache, so the Secret will never be written\" >&2",
                              "  exit 1",
                              "}",
                              "publish() {",
                              "  for dir in \"$state\" \"$cache\"; do",
                              "    if [ -e \"$dir\" ] && ! { [ -r \"$dir\" ] && [ -x \"$dir\" ]; }; then unreadable \"$dir\"; fi",
                              "  done",
                              "  for file in \"$crt\" \"$key\" \"$account\"; do",
                              "    if [ -e \"$file\" ] && [ ! -r \"$file\" ]; then unreadable \"$file\"; fi",
                              "  done",
                              "  if ! { [ -s \"$crt\" ] && [ -s \"$key\" ] && [ -s \"$account\" ]; }; then",
                              "    if [ -z \"$waiting\" ]; then",
                              "      echo \"waiting for tailscaled to cache a certificate under $cache\"",
                              "      waiting=1",
                              "    fi",
                              "    return 0",
                              "  fi",
                              "  mine=$(notafter \"$crt\")",
                              "  [ -n \"$mine\" ] || return 0",
                              "  theirs=",
                              "  if [ -s \"$secret/tls.crt\" ]; then theirs=$(notafter \"$secret/tls.crt\"); fi",
                              "  if [ -n \"$theirs\" ] && [ \"$mine\" -le \"$theirs\" ]; then return 0; fi",
                              "  body=$(printf '{\"data\":{\"tls.crt\":\"%s\",\"tls.key\":\"%s\",\"acme-account.key.pem\":\"%s\"}}' \\",
                              "    \"$(base64 <\"$crt\" | tr -d '\\n')\" \"$(base64 <\"$key\" | tr -d '\\n')\" \"$(base64 <\"$account\" | tr -d '\\n')\")",
                              "  # The body holds the private keys, so it reaches curl on standard input from printf, a shell",
                              "  # builtin, and is in no command line.",
                              "  if printf '%s' \"$body\" | kube -X PATCH \"$url\" -H 'Content-Type: application/merge-patch+json' --data-binary @- >/dev/null; then",
                              "    echo \"published a later certificate for $fqdn\"",
                              "  else",
                              "    echo \"publishing the certificate for $fqdn failed; retrying in 60s\" >&2",
                              "  fi",
                              "}",
                              "trap 'exit 0' TERM",
                              "( while :; do gate; sleep 30 & wait \"$!\"; done ) &",
                              "gate_pid=$!",
                              "while true; do",
                              "  if ! kill -0 \"$gate_pid\" 2>/dev/null; then",
                              "    echo \"the claim gate (pid $gate_pid) has exited, and only it lets this pod advertise the Service: exiting so the container restarts it\" >&2",
                              "    exit 1",
                              "  fi",
                              "  publish",
                              "  sleep 60 & wait \"$!\"",
                              "done",
                              ""
                            ]
                          }
                        ],
                        "command": [
                          "/bin/sh",
                          "-c"
                        ],
                        "env": [
                          {
                            "name": "HOSTNAME",
                            "valueFrom": {
                              "fieldRef": {
                                "fieldPath": "metadata.name"
                              }
                            }
                          }
                        ],
                        "image": "example.invalid/envoy@sha256:4444444444444444444444444444444444444444444444444444444444444444",
                        "name": "cert-publish",
                        "resources": {
                          "limits": {
                            "cpu": "100m",
                            "memory": "128Mi"
                          },
                          "requests": {
                            "cpu": "100m",
                            "memory": "128Mi"
                          }
                        },
                        "securityContext": {
                          "allowPrivilegeEscalation": false,
                          "capabilities": {
                            "drop": [
                              "ALL"
                            ]
                          }
                        },
                        "volumeMounts": [
                          {
                            "mountPath": "/var/lib/frontdoor",
                            "name": "state"
                          },
                          {
                            "mountPath": "/etc/frontdoor-tls",
                            "name": "tls",
                            "readOnly": true
                          },
                          {
                            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                            "name": "token",
                            "readOnly": true
                          }
                        ]
                      },
                      {
                        "args": [
                          {
                            "$lines": [
                              "socket=/var/lib/frontdoor/tailscaled.sock",
                              "ready_file=/var/lib/frontdoor/service-ready",
                              "draining_file=/var/lib/frontdoor/draining",
                              "node_file=/var/lib/frontdoor/node-id",
                              "flag_file=/var/lib/frontdoor/advertise-service",
                              "service=svc:example-dispatch",
                              "certificate=example-dispatch.example-tailnet.ts.net",
                              "grace=60",
                              "stuck_first=120",
                              "stuck_max=960",
                              "pause=15",
                              "attempts=6",
                              "period=5",
                              "set -u",
                              "trap 'exit 0' TERM",
                              "nap() { sleep \"$1\" & wait \"$!\"; }",
                              "at() { date -u +%Y-%m-%dT%H:%M:%SZ; }",
                              "now() { date -u +%s; }",
                              "log() { echo \"$(at) $1 | $2 | $3\"; }",
                              "ts() { tailscale --socket=\"$socket\" \"$@\"; }",
                              "err=${TMPDIR:-/tmp}/tailnet-advertiser.err",
                              "# follow sets id to Self.ID and st to the status it read, and keeps the node id file on id. It",
                              "# fails, and writes nothing, while tailscaled does not answer as a logged-in node, or names an id",
                              "# that is not alphanumeric, as no StableNodeID is.",
                              "follow() {",
                              "  id=",
                              "  st=$(ts status --json --peers=false 2>/dev/null) || return 1",
                              "  printf '%s\\n' \"$st\" | grep -q '^[[:space:]]*\"BackendState\": \"Running\",*$' || return 1",
                              "  id=$(printf '%s\\n' \"$st\" | sed -n 's/^[[:space:]]*\"ID\": \"\\([^\"]*\\)\",*$/\\1/p' | head -n 1)",
                              "  case \"$id\" in",
                              "    '') return 1 ;;",
                              "    *[!A-Za-z0-9]*) log \"node id\" \"tailscale status --json --peers=false\" \"$id is not alphanumeric: not written\"; id=; return 1 ;;",
                              "  esac",
                              "  was=$(cat \"$node_file\" 2>/dev/null)",
                              "  if [ \"$id\" != \"$was\" ]; then",
                              "    printf '%s\\n' \"$id\" >\"$node_file.tmp\" && mv \"$node_file.tmp\" \"$node_file\"",
                              "    log \"node id\" \"tailscale status --json --peers=false\" \"$id, was ${was:-none}: written to $node_file\"",
                              "  fi",
                              "}",
                              "# draining: the draining file names this cycle's node and is younger than the grace period. One",
                              "# older than that is from a termination that is over (the kubelet has killed the container whose",
                              "# preStop hook wrote it), and is removed: else a tailscale container that came back as the same",
                              "# node, after a logout that failed, would never be advertised again. A time that is not a number",
                              "# counts as over.",
                              "draining() {",
                              "  [ -e \"$draining_file\" ] && read -r drained began _ <\"$draining_file\" || return 1",
                              "  case \"$began\" in ''|*[!0-9]*) began=0 ;; esac",
                              "  if [ $(($(now) - began)) -gt \"$grace\" ]; then",
                              "    rm -f \"$draining_file\"",
                              "    log \"service advertisement\" \"rm -f $draining_file\" \"the preStop hook's drain of node ${drained:-none}, begun at $began, is more than ${grace}s old: over\"",
                              "    return 1",
                              "  fi",
                              "  [ \"$drained\" = \"$node\" ]",
                              "}",
                              "# may: no preStop hook drains this cycle's node and, with an advertise gate, its flag names it.",
                              "may() {",
                              "  if [ -n \"$flag_file\" ]; then",
                              "    [ -e \"$flag_file\" ] && read -r flagged _ <\"$flag_file\" && [ \"$flagged\" = \"$node\" ] || return 1",
                              "  fi",
                              "  ! draining",
                              "}",
                              "# still: tailscaled still runs as this cycle's node, and it may advertise.",
                              "still() { follow && [ \"$id\" = \"$node\" ] && may; }",
                              "advertising() { ts debug prefs 2>/dev/null | grep -q \"\\\"$service\\\"\"; }",
                              "# approved: the status follow last read lists the Service in the self node's service-host",
                              "# capability.",
                              "approved() {",
                              "  printf '%s\\n' \"$st\" | awk -v want=\"\\\"$service\\\": [\" '",
                              "    !inside && /^ *\"service-host\": \\[$/ { inside = 1; match($0, /^ */); indent = RLENGTH; next }",
                              "    inside {",
                              "      match($0, /^ */)",
                              "      if (RLENGTH <= indent) { inside = 0; next }",
                              "      if (index(substr($0, RLENGTH + 1), want) == 1) found = 1",
                              "    }",
                              "    END { exit !found }'",
                              "}",
                              "# unstick drains the Service and advertises it again once the node has been advertised and",
                              "# unapproved for more than stuck seconds, doubling stuck up to stuck_max. It returns 1 when the",
                              "# cycle must start again: the node changed or may no longer advertise during the pause, or the new",
                              "# advertisement failed.",
                              "unstick() {",
                              "  waited=$(($(now) - since))",
                              "  [ \"$waited\" -gt \"$stuck\" ] || return 0",
                              "  recoveries=$((recoveries + 1))",
                              "  stuck=$((stuck * 2))",
                              "  [ \"$stuck\" -le \"$stuck_max\" ] || stuck=$stuck_max",
                              "  recovery=\"recovery $recoveries: not approved ${waited}s after advertising\"",
                              "  if ! ts serve drain \"$service\" >/dev/null 2>\"$err\"; then",
                              "    log \"service advertisement\" \"tailscale serve drain $service\" \"$recovery: the drain failed: $(tr '\\n' ' ' <\"$err\"); next recovery after ${stuck}s\"",
                              "    return 0",
                              "  fi",
                              "  nap \"$pause\"",
                              "  still || return 1",
                              "  if ! ts serve advertise \"$service\" >/dev/null 2>\"$err\"; then",
                              "    log \"service advertisement\" \"tailscale serve drain $service; sleep $pause; tailscale serve advertise $service\" \"$recovery: drained, and the advertisement failed: $(tr '\\n' ' ' <\"$err\"); advertising again\"",
                              "    return 1",
                              "  fi",
                              "  since=$(now)",
                              "  log \"service advertisement\" \"tailscale serve drain $service; sleep $pause; tailscale serve advertise $service\" \"$recovery: drained and advertised again; next recovery after ${stuck}s\"",
                              "}",
                              "orders=0",
                              "while :; do",
                              "  rm -f \"$ready_file\"",
                              "  until follow; do nap \"$period\"; done",
                              "  node=$id",
                              "  until may; do",
                              "    nap \"$period\"",
                              "    follow && [ \"$id\" = \"$node\" ] || continue 2",
                              "  done",
                              "  [ -z \"$flag_file\" ] || log \"service advertisement\" \"cat $flag_file\" \"$(cat \"$flag_file\")\"",
                              "  until ts serve advertise \"$service\" >/dev/null 2>\"$err\"; do",
                              "    log \"service advertisement\" \"tailscale serve advertise $service\" \"failed: $(tr '\\n' ' ' <\"$err\"); again in 10s\"",
                              "    nap 10",
                              "    still || continue 2",
                              "  done",
                              "  log \"service advertisement\" \"tailscale serve advertise $service\" \"advertised as node $node\"",
                              "  since=$(now)",
                              "  stuck=$stuck_first",
                              "  recoveries=0",
                              "  held=",
                              "  while :; do",
                              "    if ! follow; then gone=\"tailscaled answers as no logged-in node\"; break",
                              "    elif [ \"$id\" != \"$node\" ]; then gone=\"tailscaled is node $id now, not $node\"; break",
                              "    elif ! may; then gone=\"node $node may not advertise: a preStop hook drains it${flag_file:+, or the advertise flag does not name it}\"; break",
                              "    fi",
                              "    if ! advertising; then gone=\"node $node no longer advertises $service\"; break; fi",
                              "    if ! approved; then",
                              "      if [ -e \"$ready_file\" ]; then",
                              "        rm -f \"$ready_file\"",
                              "        log \"readiness\" \"rm -f $ready_file\" \"node $node is no longer approved to host $service: not ready\"",
                              "      fi",
                              "      if ! unstick; then gone=\"node $node changed, may no longer advertise, or was not advertised again during a recovery\"; break; fi",
                              "      nap \"$period\"",
                              "      continue",
                              "    fi",
                              "    if [ -n \"$certificate\" ] && [ \"$held\" != \"$node\" ]; then",
                              "      if ts cert --cert-file=- --key-file=- \"$certificate\" >/dev/null 2>\"$err\"; then",
                              "        held=$node",
                              "        log \"service certificate\" \"tailscale cert $certificate\" \"in tailscaled's cache\"",
                              "      else",
                              "        why=$(tr '\\n' ' ' <\"$err\")",
                              "        if grep -q 'invalid domain' \"$err\"; then",
                              "          backoff=30",
                              "        else",
                              "          orders=$((orders + 1))",
                              "          if [ \"$orders\" -ge \"$attempts\" ]; then",
                              "            ts serve drain \"$service\" >/dev/null 2>&1",
                              "            log \"service certificate\" \"tailscale cert $certificate\" \"$orders orders failed, the last: $why; no more from this pod: $service drained, not ready\"",
                              "            while nap 30; do follow; done",
                              "          fi",
                              "          backoff=$((60 * orders + ${RANDOM:-0} % 30))",
                              "        fi",
                              "        log \"service certificate\" \"tailscale cert $certificate\" \"not yet: $why; again in ${backoff}s\"",
                              "        nap \"$backoff\"",
                              "        continue",
                              "      fi",
                              "    fi",
                              "    if [ ! -e \"$ready_file\" ]; then",
                              "      printf '%s\\n' \"$node\" >\"$ready_file.tmp\" && mv \"$ready_file.tmp\" \"$ready_file\"",
                              "      log \"readiness\" \"write $ready_file\" \"node $node is approved to host $service${certificate:+ and tailscaled holds its certificate}: ready\"",
                              "    fi",
                              "    nap \"$period\"",
                              "  done",
                              "  rm -f \"$ready_file\"",
                              "  log \"readiness\" \"rm -f $ready_file\" \"$gone: not ready; advertising again once the node may\"",
                              "done",
                              ""
                            ]
                          }
                        ],
                        "command": [
                          "/bin/sh",
                          "-c"
                        ],
