    {
      "match": "^gh api graphql .*isInMergeQueue",
      "stdout": {
        "data": {
          "repository": {
            "pullRequest": {
              "state": "OPEN",
              "mergedAt": null,
              "isInMergeQueue": false,
              "mergeStateStatus": "CLEAN",
