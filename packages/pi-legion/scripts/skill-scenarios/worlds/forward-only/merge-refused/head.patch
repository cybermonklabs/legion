@@ -0,0 +1,7 @@
+/** The most rows one page holds. */
+export const MAX_PAGE = 10;
+
+/** The page size a caller asked for, cut to MAX_PAGE. */
+export function clampLimit(limit: number): number {
+  return Math.min(limit, MAX_PAGE - 1);
+}
