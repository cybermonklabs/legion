+import { expect, test } from "bun:test";
+import { listRows } from "./list";
+
+test("returns at most the limit, in order", () => {
+  expect(listRows([1, 2, 3], 2)).toEqual([1, 2]);
+});
+
+test("refuses a limit below 1", () => {
+  expect(() => listRows([1], 0)).toThrow(RangeError);
+});
