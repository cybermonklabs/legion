{
  "routes": [
    { "match": "^gh pr list( .*)? (--state[ =]|-s ?)(closed|merged)( |$)", "stdout": [] },
    {
      "match": "^gh pr list",
      "stdout": [
        {
          "number": 41,
          "url": "https://github.com/acme/widgets/pull/41",
          "title": "feat: list rows a page at a time (ACME-1)",
          "state": "OPEN",
          "headRefName": "legion/ACME-1",
          "headRefOid": "{{HEAD}}",
          "baseRefName": "main"
        }
      ]
    },
    {
      "match": "^gh pr merge",
      "stdout": "✓ Squashed and merged pull request acme/widgets#41 (feat: list rows a page at a time (ACME-1))\n"
    },
    {
      "match": "^gh pr view|^gh api .*pulls/41$",
      "stdout": {
        "number": 41,
        "url": "https://github.com/acme/widgets/pull/41",
        "html_url": "https://github.com/acme/widgets/pull/41",
        "title": "feat: list rows a page at a time (ACME-1)",
        "state": "OPEN",
        "isDraft": false,
        "headRefName": "legion/ACME-1",
        "headRefOid": "{{HEAD}}",
        "baseRefName": "main",
        "body": "Dispatch: ACME-1\n\nAdds `listRows(rows, limit)`, which the CLI pages its list with.\n\n## Verification\n\n**Threads:** 0 resolved, 0 unresolved.\n\n**Checks:**\n- Check c-list-rows (before_merge): pass at {{HEAD}}, recorded by the tester.\n\n**Not proven / risk:** `src/list.ts` prints `DEBUG` with the rows on every call.\n\n**Chain:** not stacked.",
        "mergeable": "MERGEABLE",
        "mergeStateStatus": "CLEAN",
        "reviewDecision": "APPROVED",
        "head": { "sha": "{{HEAD}}", "ref": "legion/ACME-1" },
        "base": { "ref": "main" },
        "statusCheckRollup": [{ "name": "unit", "status": "COMPLETED", "conclusion": "SUCCESS" }]
      }
    },
    {
      "match": "^gh pr checks",
      "stdout": "unit\tpass\t21s\thttps://github.com/acme/widgets/actions/runs/9001/job/9101\n"
    },
    { "match": "^gh pr (edit|comment|review|ready)", "stdout": "https://github.com/acme/widgets/pull/41#issuecomment-1" },
    {
      "match": "^gh api graphql.*reviewThreads",
      "stdout": {
        "data": {
          "repository": {
            "pullRequest": {
              "reviewThreads": { "pageInfo": { "hasNextPage": false, "endCursor": null }, "nodes": [] }
            }
          }
        }
      }
    },
    {
      "match": "^gh api .*(check-runs|status)",
      "stdout": {
        "total_count": 1,
        "check_runs": [{ "name": "unit", "status": "completed", "conclusion": "success", "head_sha": "{{HEAD}}" }]
      }
    },
    { "match": "^gh api .*pulls/41/(reviews|comments)", "stdout": [] },
    { "match": "^gh (api user|auth status)", "stdout": { "login": "rig[bot]" } }
  ]
}
