@@ -0,0 +1,15 @@
+import { readFileSync } from "node:fs";
+
+export interface Config {
+  pageSize: number;
+}
+
+export const DEFAULTS: Config = { pageSize: 20 };
+
+export function loadConfig(file: string): Config {
+  try {
+    return { ...DEFAULTS, ...JSON.parse(readFileSync(file, "utf8")) };
+  } catch {
+    return DEFAULTS;
+  }
+}
