// The build scripts, the generators and the media scripts, which Bun and Playwright run without
// typechecking. `bun run typecheck` checks them, and src/content.config.ts under
// tsconfig.content.json: tsconfig.json also reaches the plugins' TypeScript sources through
// astro.config.mjs, and those sources do not typecheck under this project's settings; `astro
// build` validates astro.config.mjs itself.
{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["scripts", "generators", "media"]
}
