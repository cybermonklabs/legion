# --- The thirteen requirement blocks of spec.md v7

d:s-req-verify-the-answer a mas:State ;
    mas:id "spec#b-r-verify-the-answer" ;
    mas:name "R1" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R1. The answer already on this issue is checked by a second reader, claim by claim." ;
    mas:inputTo d:t-architect-1 .

d:s-req-reconcile a mas:State ;
    mas:id "spec#b-r-reconcile" ;
    mas:name "R2" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R2. The authors' own account is held against their code." ;
    mas:inputTo d:t-architect-1 .

d:s-req-mas-lab a mas:State ;
    mas:id "spec#b-r-mas-lab" ;
    mas:name "R3" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R3. mas-lab is read, and it is read against our own questions." ;
    mas:inputTo d:t-architect-1 .

d:s-req-our-own-failures a mas:State ;
    mas:id "spec#b-r-our-own-failures" ;
    mas:name "R4" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R4. Our own three alignment problems are measured in our own record before any verdict rests on them." ;
    mas:inputTo d:t-architect-1 .

d:s-req-evidence a mas:State ;
    mas:id "spec#b-r-evidence" ;
    mas:name "R5" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R5. No claim rests on a project's description of itself, and every claim carries the form of evidence it was made on." ;
    mas:inputTo d:t-architect-1 .

d:s-req-verdicts a mas:State ;
    mas:id "spec#b-r-verdicts" ;
    mas:name "R6" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R6. Every candidate carries exactly one verdict of four, and each verdict names what it commits us to." ;
    mas:inputTo d:t-architect-1 .

d:s-req-our-data a mas:State ;
    mas:id "spec#b-r-our-data" ;
    mas:name "R7" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R7. Each candidate on the ranked list carries one test against our own records, never against the project's own fixtures." ;
    mas:inputTo d:t-architect-1 .

d:s-req-node-model a mas:State ;
    mas:id "spec#b-r-node-model" ;
    mas:name "R8" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R8. The work is read against the node model, and the model is read back." ;
    mas:inputTo d:t-architect-1 .

d:s-req-shape a mas:State ;
    mas:id "spec#b-r-shape" ;
    mas:name "R9" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R9. The deliverable has one shape: judgement.md, a front page and three to seven candidate pages." ;
    mas:inputTo d:t-architect-1 .

d:s-req-named-designs a mas:State ;
    mas:id "spec#b-r-named-designs" ;
    mas:name "R10" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R10. The three fixed pages answer the designs already written for them, by name." ;
    mas:inputTo d:t-architect-1 .

d:s-req-gate a mas:State ;
    mas:id "spec#b-r-gate" ;
    mas:name "R11" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R11. One committed script, docs/research/internet-of-cognition/check.sh, is the gate, in seven modes." ;
    mas:inputTo d:t-architect-1 .

d:s-req-lands a mas:State ;
    mas:id "spec#b-r-lands" ;
    mas:name "R12" ;
    mas:sessionId "INFRA-3134" ;
    mas:content "R12. Nothing is deferred and nothing waits on a person who has not answered." ;
    mas:inputTo d:t-architect-1 .

d:s-req-delivered a mas:State ;
    mas:id "spec#b-r-delivered" ;
    mas:name "R13" ;
    mas:sessionId "INFRA-3134" ;
