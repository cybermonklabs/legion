+import {splice} from 'micromark-util-chunked';
+
+/**
+ * The work the patched parts of `micromark` and `micromark-core-commonmark` do, by counter, over
+ * every document parsed since this module loaded: one registry, which micromark's patched modules
+ * count into too, through this package's entry. A test reads it before and after a parse to hold
+ * each part to the length of the document.
+ *
+ * - `tokenizer`: micromark's `lib/create-tokenizer.js`: each code `main` hands `go`, so a code a construct read and gave back counts again each time it is read again.
+ * - `resolvedEvents`: micromark's `lib/create-tokenizer.js`: the events each tokenizer's `resolveAll` constructs left it with.
+ * - `postprocessedEvents`: micromark's `lib/postprocess.js`: the events `postprocess` hands on once `micromark-util-subtokenize` is done.
+ * - `lazyLine`: micromark's `lib/initialize/document.js`: each event the lazy-line test of `writeToChild` reads.
+ * - `textResolve`: micromark's `lib/initialize/text.js`: each event `resolveAllText` and `resolveAllLineSuffixes` visit, each chunk and space the line suffix's look back reads, and each event they copy into a result or write back.
+ * - `labelEndScan`: `lib/label-end.js`'s tokenizer: each event the scan for an opening `[` reads, and each character of a label the definition lookup counts or serializes.
+ * - `attention`: `lib/attention.js`'s resolver.
+ * - `labelEnd`: `lib/label-end.js`'s two resolvers.
+ * - `headingAtx`: `lib/heading-atx.js`'s resolver.
+ * - `setextUnderline`: `lib/setext-underline.js`'s resolver.
+ * - `codeText`: `lib/code-text.js`'s resolver.
+ * - `content`: `lib/content.js`'s resolver: the events `micromark-util-subtokenize`, which this patch does not reach, hands back.
+ *
+ * A resolver counts one step for each event its walk visits and for each event a `slice` copies;
+ * each `splice` is counted by `spliceCounted` from the splice's own arguments.
+ */
+const counts = {
+  tokenizer: 0,
+  resolvedEvents: 0,
+  postprocessedEvents: 0,
+  lazyLine: 0,
+  textResolve: 0,
+  labelEndScan: 0,
+  attention: 0,
+  labelEnd: 0,
+  headingAtx: 0,
+  setextUnderline: 0,
+  codeText: 0,
+  content: 0
+};
+
+/**
+ * @typedef {keyof typeof counts} WorkCounter
+ *   One counter of the registry.
+ */
+
+/**
+ * The steps `counter` has counted so far.
+ *
+ * @param {WorkCounter} counter
+ *   The counter.
+ * @returns {number}
+ *   Its steps.
+ */
+export function workCount(counter) {
+  return counts[counter];
+}
+
+/**
+ * Every counter's steps so far.
+ *
+ * @returns {Readonly<Record<WorkCounter, number>>}
+ *   Steps, by counter.
+ */
+export function workCounts() {
+  return {...counts};
+}
+
+/**
+ * Adds `steps` to `counter`.
+ *
+ * @param {WorkCounter} counter
+ *   The counter.
+ * @param {number} steps
+ *   Steps taken.
+ * @returns {undefined}
+ *   Nothing.
+ */
+export function countWork(counter, steps) {
+  counts[counter] += steps;
+}
+
+/**
+ * Adds to `counter` what splicing `list` from `start`, removing `remove` and putting in `inserted`
+ * items, costs: one for each item it removes or puts in, and one for each item after them it
+ * shifts. `start` and `remove` are clamped as `Array.prototype.splice` clamps them.
+ *
+ * @param {WorkCounter} counter
+ *   The counter.
+ * @param {ReadonlyArray<unknown>} list
+ *   The list as it is before the splice.
+ * @param {number} start
+ *   Where the splice starts.
+ * @param {number} remove
+ *   How many items it removes.
+ * @param {number} inserted
+ *   How many items it puts in.
+ * @returns {undefined}
+ *   Nothing.
+ */
+export function countSplice(counter, list, start, remove, inserted) {
+  const length = list.length;
+  const from = start < 0 ? Math.max(length + start, 0) : Math.min(start, length);
+  const removed = Math.min(Math.max(remove, 0), length - from);
+  counts[counter] += removed + inserted + (length - from - removed);
+}
+
+/**
+ * `splice` of `micromark-util-chunked`, counted to `counter` from its own arguments
+ * (`countSplice`).
+ *
+ * @template {unknown} T
+ *   Item type.
+ * @param {WorkCounter} counter
+ *   The counter.
+ * @param {Array<T>} list
+ *   The list to change.
+ * @param {number} start
+ *   Where to start.
+ * @param {number} remove
+ *   How many items to remove.
+ * @param {Array<T>} items
+ *   The items to put in.
+ * @returns {undefined}
+ *   Nothing.
+ */
+export function spliceCounted(counter, list, start, remove, items) {
+  countSplice(counter, list, start, remove, items.length);
+  splice(list, start, remove, items);
+}
