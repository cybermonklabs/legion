@@ -0,0 +1,26 @@
+/**
+ * One counter of the registry of the work the patched parts of `micromark` and
+ * `micromark-core-commonmark` do.
+ */
+export type WorkCounter = "tokenizer" | "resolvedEvents" | "postprocessedEvents" | "lazyLine" | "textResolve" | "labelEndScan" | "attention" | "labelEnd" | "headingAtx" | "setextUnderline" | "codeText" | "content";
+/**
+ * The steps `counter` has counted so far.
+ */
+export function workCount(counter: WorkCounter): number;
+/**
+ * Every counter's steps so far.
+ */
+export function workCounts(): Readonly<Record<WorkCounter, number>>;
+/**
+ * Adds `steps` to `counter`.
+ */
+export function countWork(counter: WorkCounter, steps: number): undefined;
+/**
+ * Adds to `counter` what splicing `list` from `start`, removing `remove` and putting in `inserted`
+ * items, costs.
+ */
+export function countSplice(counter: WorkCounter, list: ReadonlyArray<unknown>, start: number, remove: number, inserted: number): undefined;
+/**
+ * `splice` of `micromark-util-chunked`, counted to `counter` from its own arguments.
+ */
+export function spliceCounted<T>(counter: WorkCounter, list: Array<T>, start: number, remove: number, items: Array<T>): undefined;
