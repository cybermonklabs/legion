+  tokenizer: 0,
+  resolvedEvents: 0,
+  postprocessedEvents: 0,
+  lazyLine: 0,
+  textResolve: 0,
+  labelEndScan: 0,
+  attention: 0,
+  labelEnd: 0,
+  headingAtx: 0,
+  setextUnderline: 0,
+  codeText: 0,
