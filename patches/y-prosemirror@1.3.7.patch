+/**
+ * An inline-content element can itself be the bound root. Convert its Y.XmlText
+ * children to inline ProseMirror nodes without inserting a wrapper.
+ *
+ * @param {Array<PModel.Node>} content
+ * @param {Y.XmlElement|Y.XmlText|Y.XmlHook} child
+ * @param {import('prosemirror-model').Schema} schema
+ * @param {BindingMetadata} meta
+ * @param {typeof createNodeFromYElement|typeof createNodeIfNotExists} createElement
+ * @param {Y.Snapshot} [snapshot]
+ * @param {Y.Snapshot} [prevSnapshot]
+ * @param {function('removed'|'added', Y.ID):any} [computeYChange]
+ */
+const appendRootChild = (content, child, schema, meta, createElement, snapshot, prevSnapshot, computeYChange) => {
+  if (child instanceof Y__namespace.XmlText) {
+    const nodes = createTextNodesFromYText(child, schema, meta, snapshot, prevSnapshot, computeYChange);
+    if (nodes !== null) {
+      meta.mapping.set(child, nodes);
+      for (const node of nodes) content.push(node);
+    }
+  } else {
+    const node = createElement(/** @type {Y.XmlElement} */ (child), schema, meta, snapshot, prevSnapshot, computeYChange);
+    if (node !== null) content.push(node);
+  }
+};
